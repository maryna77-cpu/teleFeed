      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87ABF09F87B7.png\u0026#39;)\"\u003e\u003cb\u003e🇫🇷\u003c/b\u003e\u003c/i\u003e \u003cb\u003eفرانسه نخستین آزمایش شلیک راکت بالستیک FLP-T با برد ۱۵۰ کیلومتر را با موفقیت انجام داد.\u003c/b\u003e\u003cbr/\u003eاین راکت هدایت‌شونده که توسط شرکت «آریان‌گروپ» توسعه یافته، از پرتابگر متحرک \u003cb\u003eX-Fire\u003c/b\u003e ساخت تالس شلیک شد و بخشی از برنامه فرانسه برای احیای توان حملات دوربرد زمینی است.\u003cbr/\u003eبر اساس اعلام آریان‌گروپ، راکت FLP-T می‌تواند اهداف را در برد \u003cb\u003e۱۵۰ کیلومتری\u003c/b\u003e با دقت بالا هدف قرار دهد و پایه فناوری خانواده جدید موشک‌های بالستیک متعارف \u003cb\u003eB-Strike\u003c/b\u003e خواهد بود که در آینده برد آن‌ها از \u003cb\u003e۱۵۰ تا ۲۵۰۰ کیلومتر\u003c/b\u003e خواهد رسید.\u003cbr/\u003eاین سامانه در کمتر از \u003cb\u003e۱۸ ماه\u003c/b\u003e از مرحله طراحی تا آزمایش عملیاتی توسعه یافته و از فناوری‌های به‌کاررفته در موشک بالستیک \u003cb\u003eM51\u003c/b\u003e و پرتابگرهای فضایی \u003cb\u003eآریان\u003c/b\u003e بهره می‌برد.\u003cbr/\u003eپرتابگر چرخدار \u003cb\u003eX-Fire\u003c/b\u003e نیز با قابلیت «شلیک و جابه‌جایی سریع» برای افزایش بقا در میدان نبرد طراحی شده و قابلیت اتصال به شبکه‌های فرماندهی و کنترل ناتو را دارد.\u003cbr/\u003eاین پروژه بخشی از تلاش فرانسه برای کاهش وابستگی به سامانه‌های خارجی و تقویت توان حملات دقیق دوربرد در جنگ‌های آینده محسوب می‌شود.\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D8%A7%D9%86%D8%B3%D9%87\"\u003e#فرانسه\u003c/a\u003e \u003ca href=\"?q=%23FLPT\"\u003e#FLPT\u003c/a\u003e \u003ca href=\"?q=%23BStrike\"\u003e#BStrike\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%DA%A9_%D8%A8%D8%A7%D9%84%D8%B3%D8%AA%DB%8C%DA%A9\"\u003e#موشک_بالستیک\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%B1%DB%8C%D8%A7%D9%86_%DA%AF%D8%B1%D9%88%D9%BE\"\u003e#آریان_گروپ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D8%A7%D9%88%D8%B1%D8%A7%D9%86\"\u003e#جنگاوران\u003c/a\u003e \u003ca href=\"http