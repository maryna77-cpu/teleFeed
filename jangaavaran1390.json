    },
    {
      "id": 140471,
      "message": "درگیری در سراوان از ساعاتی پیش بین نیرو های امنیتی و گروهای مسلح تروریستی در جریان است",
      "date": "2026-09-12T03:22:08Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 8060,
      "forwards": 0,
