    },
    {
      "id": 141996,
      "message": "تصویری متفاوت از یک ناو هواپیمابر اسکورت آمریکا در سال ۱۹۴۴\u003cbr/\u003e\u003cbr/\u003eدر این تصویر عرشه ناو اسکورت USS Thetis Bay در جریان جنگ جهانی دوم دیده می‌شود؛ اما نکته جالب، ترکیب غیرمعمول هواپیماهای مستقر روی عرشه است.\u003cbr/\u003e\u003cbr/\u003eدر کنار جنگنده‌های F6F Hellcat، یک هواپیمای آب‌نشین PBY Catalina و حتی هواپیمای دوپره J2F Duck نیز روی عرشه دیده می‌شوند.\u003cbr/\u003e\u003cbr/\u003eناوهای هواپیمابر اسکورت در آن دوران، به‌دلیل مأموریت‌های متنوع از جمله حفاظت از کاروان‌ها، گشت دریایی، شناسایی و پشتیبانی، گاهی مجموعه‌ای بسیار متنوع از هواپیماها را حمل می‌کردند؛ تصویری که تفاوت مأموریت و سازمان‌دهی ناوهای آن دوران را به‌خوبی نشان می‌دهد.\u003cbr/\u003eمعمولا این روش حمل برای انتقال هواپیماها بین پایگاه‌ها در اقیانوس‌ آرام مرسوم بود\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF_%D8%AC%D9%87%D8%A7%D9%86%DB%8C_%D8%AF%D9%88%D9%85\"\u003e#جنگ_جهانی_دوم\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D8%A7%D9%88_%D9%87%D9%88%D8%A7%D9%BE%DB%8C%D9%85%D8%A7%D8%A8%D8%B1\"\u003e#ناو_هواپیمابر\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D8%A7%D9%88_%D8%A7%D8%B3%DA%A9%D9%88%D8%B1%D8%AA\"\u003e#ناو_اسکورت\u003c/a\u003e \u003ca href=\"?q=%23Hellcat\"\u003e#Hellcat\u003c/a\u003e \u003ca href=\"?q=%23Catalina\"\u003e#Catalina\u003c/a\u003e \u003ca href=\"?q=%23%D9%87%D9%88%D8%A7%D9%86%D9%88%D8%B1%D8%AF%DB%8C\"\u003e#هوانوردی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D8%A7%D9%88%D8%B1%D8%A7%D9%86\"\u003e#جنگاوران\u003c/a\u003e",
