    {
      "id": 134404,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e بر اساس برآوردهای منتشرشده، روسیه تنها در ماه مه ۲۰۲۶ حدود ۵۴۵ هزار لیتر بنزین برای پرتاب پهپادهای انتحاری «شاهد/گران-۲» و پهپادهای فریب‌دهنده «گربرا» مصرف کرده است.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، از مجموع حدود ۸۱۵۰ پهپاد دوربرد شلیک‌شده در ماه مه، نزدیک به ۴۹۰۰ فروند از نوع «گران-۲» بوده‌اند. با در نظر گرفتن میانگین مصرف ۱۰۵ لیتر سوخت برای هر پهپاد، حدود ۵۱۳ هزار لیتر بنزین تنها صرف سوخت‌گیری این پهپادها شده است.\u003cbr/\u003e\u003cbr/\u003eهمچنین برای پهپادهای فریب‌دهنده «گربرا» نیز حدود ۳۲ هزار لیتر بنزین مصرف شده و مجموع مصرف سوخت این دو نوع پهپاد در ماه مه به حدود ۵۴۵ هزار لیتر رسیده است.\u003cbr/\u003e\u003cbr/\u003eدر ۲۶ روز نخست ژوئن نیز روسیه بیش از ۵۲۰۰ پهپاد دوربرد به سمت اوکراین شلیک کرده که برآورد می‌شود حدود ۳۵۰ هزار لیتر بنزین برای سوخت‌گیری پهپادهای «گران-۲» و «گربرا» مصرف شده باشد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B1%D9%88%D8%B3%DB%8C%D9%87\"\u003e#روسیه\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%88%DA%A9%D8%B1%D8%A7%DB%8C%D9%86\"\u003e#اوکراین\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%AF%DB%B1%DB%B3%DB%B6\"\u003e#شاهد۱۳۶\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D9%87%D9%BE%D8%A7%D8%AF\"\u003e#پهپاد\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D8%A7%D9%88%D8%B1%D8%A7%D9%86\"\u003e#جنگاوران\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/jangaavaran1390\" target=\"_blank\" rel=\"noopener\"\u003ehttps://t.me/jangaavaran1390\u003c/a\u003e",
