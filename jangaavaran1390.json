    {
      "id": 134402,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e وزارت آموزش روسیه از اول سپتامبر ۲۰۲۶ سهم آموزش‌های نظامی در درس «مبانی امنیت و دفاع از میهن» را از ۲۰ درصد به ۵۰ درصد زمان آموزشی افزایش می‌دهد.\u003cbr/\u003e\u003cbr/\u003eاین درس برای دانش‌آموزان پایه‌های ششم تا یازدهم ارائه می‌شود و شامل آموزش‌های نظامی پایه، کار با پهپادها و تمرین‌های میدانی است.\u003cbr/\u003e\u003cbr/\u003eهمچنین مقامات روسیه اعلام کرده‌اند که از سال ۲۰۲۰ برنامه‌ای یکپارچه برای تقویت آموزش‌های میهن‌پرستانه در مدارس اجرا شده که شامل مراسم برافراشتن پرچم، اجرای سرود ملی، جلسات آموزشی، برنامه‌های هدایت شغلی و فعالیت‌های فرهنگی است.\u003cbr/\u003e\u003cbr/\u003eروسیه پیش‌تر نیز از برنامه‌ای برای آموزش یک میلیون اپراتور پهپاد خبر داده و اعلام کرده بود دانش‌آموزان نیز در این طرح مشارکت خواهند داشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B1%D9%88%D8%B3%DB%8C%D9%87\"\u003e#روسیه\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D9%87%D9%BE%D8%A7%D8%AF\"\u003e#پهپاد\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D9%85%D9%88%D8%B2%D8%B4_%D9%86%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#آموزش_نظامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D8%A7%D9%88%D8%B1%D8%A7%D9%86\"\u003e#جنگاوران\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/jangaavaran1390\" target=\"_blank\" rel=\"noopener\"\u003ehttps://t.me/jangaavaran1390\u003c/a\u003e",
