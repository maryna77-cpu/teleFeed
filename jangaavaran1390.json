    {
      "id": 132206,
      "message": "با طولانی شدن جنگ اوکراین ، حمایت مردمی در اروپای شرقی از اوکراین در حال کاهش است",
      "date": "2026-05-30T19:35:53Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
