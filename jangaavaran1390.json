    {
      "id": 134164,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e فرماندهی مرکزی آمریکا (سنتکام) اعلام کرد ناو هواپیمابر «یواس‌اس جرج اچ. دبلیو. بوش» (CVN-77) همچنان در دریای عرب در حال عملیات است. \u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e با حضور این ناو، هم‌اکنون دو ناو هواپیمابر آمریکایی به‌طور همزمان در خاورمیانه مستقر هستند؛ اقدامی که به گفته سنتکام با هدف حفظ آمادگی و حضور مستمر نیروهای آمریکا در منطقه انجام می‌شود. \u003ca href=\"?q=%23%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#نیروی_دریایی_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D8%A7%D9%88_%D9%87%D9%88%D8%A7%D9%BE%DB%8C%D9%85%D8%A7%D8%A8%D8%B1\"\u003e#ناو_هواپیمابر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C_%D8%B9%D8%B1%D8%A8\"\u003e#دریای_عرب\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D8%A7%D9%88%D8%B1%D8%A7%D9%86\"\u003e#جنگاوران\u003c/a\u003e \u003ca href=\"https://t.me/jangaavaran1390\" target=\"_blank\" rel=\"noopener\"\u003ehttps://t.me/jangaavaran1390\u003c/a\u003e",
