    {
      "id": 138164,
      "message": "حاجی از قدیم میگن گدا به گدا رحمت به خدا",
      "date": "2026-08-10T16:55:31Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 3720,
      "forwards": 0,
