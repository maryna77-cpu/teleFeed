    {
      "id": 131782,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eپس از شش سال انتظار، نخستین جنگنده‌های Lockheed Martin F-35A Lightning II وارد لهستان شدند.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eلهستان که در ژانویه ۲۰۲۰ قرارداد خرید ۳۲ فروند اف-۳۵ را امضا کرده بود، اکنون سه فروند نخست را در پایگاه هوایی «لاسک» تحویل گرفته است. این جنگنده‌ها در نیروی هوایی لهستان با نام «هوسارز» شناخته می‌شوند.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eنخستین اف-۳۵ لهستان در سال ۲۰۲۴ تکمیل شده بود اما برای آموزش خدمه در آمریکا باقی ماند و اکنون انتقال رسمی آن‌ها به لهستان آغاز شده است.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eمقام‌های لهستانی تاکید ویژه‌ای بر توان پنهانکاری و سامانه‌های پیشرفته راداری و اویونیکی این جنگنده داشته‌اند.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eتحویل کامل سفارش ۳۲ فروندی لهستان تا سال ۲۰۲۹ ادامه خواهد داشت.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eاف-۳۵های لهستان به طیف گسترده‌ای از تسلیحات هدایت‌شونده از جمله موشک کروز JSM با برد حدود ۵۵۵ کیلومتر و بمب‌های هدایت‌شونده JDAM و GBU-39 SDB مجهز خواهند شد.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eلهستان همچنین در حال بررسی پیوستن به پروژه جنگنده نسل ششم GCAP است تا توان هوایی خود را بیش از پیش تقویت کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%84%D9%87%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#لهستان\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%81%DB%B3%DB%B5\"\u003e#اف۳۵\u003c/a\u003e \u003ca href=\"?q=%23F35\"\u003e#F35\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D8%A7%D8%AA%D9%88\"\u003e#ناتو\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D9%87%D9%88%D8%A7%DB%8C%DB%8C\"\u003e#نیروی_هوایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D9%86%D8%AF%D9%87\"\u003e#جنگنده\u003c/a\u003e \u003ca href=\"?q=%23GCAP\"\u003e#GCAP\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D8%A7%D9%88%D8%B1%D8%A7%D9%86\"\u003e#جنگاوران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/jangaavaran1390\" target=\"_blank\" rel=\"noopener\"\u003ehttps://t.me/jangaavaran1390\u003c/a\u003e",
