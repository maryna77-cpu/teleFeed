      "message": "\u003ca class=\"tgme_widget_message_author_name\" href=\"https://t.me/jangaavaran1390\"\u003e\u003cspan dir=\"auto\"\u003eجنگاوران\u003c/span\u003e\u003c/a\u003e pinned a photo",
