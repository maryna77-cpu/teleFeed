    {
      "id": 131307,
      "message": "سنتکام\u003cbr/\u003eتا امروز، ۷۸ کشتی تجاری تغییر مسیر داده‌اند و ۴ کشتی غیرفعال شده‌اند",
      "date": "2026-05-16T13:40:58Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 6860,
      "forwards": 0,
