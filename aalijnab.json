    {
      "id": 545094,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eفوری:\u003cbr/\u003e\u003cbr/\u003eمجلس نمایندگان آمریکا، بودجه‌ی 95 میلیارد دلاری برای تامین هزینه‌های جنگ آمریکا با ایران رو تصویب کردن.\u003cbr/\u003e\u003cbr/\u003e216 موافق\u003cbr/\u003e214 مخالف\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
