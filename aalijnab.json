    {
      "id": 539971,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003eامروز 21 June، روز جهانی سلفیه\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B8.png\u0026#39;)\"\u003e\u003cb\u003e📸\u003c/b\u003e\u003c/i\u003e\u003cbr/\u003e\u003cbr/\u003e+مردم دنیا تو این روز عکس‌های سلفی خودشون رو تو شبکه‌های اجتماعی منتشر می‌ کنن \u003cbr/\u003eبعضی خوشگلا هم برای اونایی که دوستشون دارن، سلفی می‌فرستن:)\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
