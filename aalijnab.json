    {
      "id": 534422,
      "message": "شعار امشب : مرگ بر \u0026#34;امارات\u0026#34; \u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-05-18T21:14:49Z",
