    },
    {
      "id": 543886,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e\u003cb\u003eسخنگوی کمیسیون آموزش مجلس : \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبه وزیر آموزش و پرورش ۲۴ ساعت مهلت میدم تا آزمون های نهایی رو برای همه استان‌ها به تعویق بندازه.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
