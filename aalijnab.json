    },
    {
      "id": 547410,
      "message": "وای اینو الان دیدم\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9882.png\u0026#39;)\"\u003e\u003cb\u003e😂\u003c/b\u003e\u003c/i\u003e \u003cbr/\u003eرو موشک‌ هایی که به عرب‌های زدن نوشتن:\u003cbr/\u003eحبیبی آمریکا که میره ، ما میمونیم و شما\u003cbr/\u003e\u003cbr/\u003eقشنگ حس این بچه‌ها که میگفتن اخر زنگ وایسا\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
