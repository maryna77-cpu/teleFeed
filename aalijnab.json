    {
      "id": 540953,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eبسته شدن کامل تمامی ورودی‌های تهران از روز جمعه\u003cbr/\u003e\u003cbr/\u003eرئیس‌پلیس راهور منطقه ۱۲ تهران:\u003cbr/\u003e\u003cbr/\u003eبا اعلام آماده‌باش صددرصدی از بامداد جمعه تا صبح سه‌شنبه، از بسته شدن کامل تمامی ورودی‌های تهران از روز جمعه خبر داد و گفت: با پیش‌بینی حضور ۱۵ تا ۲۰ میلیون نفری، هیچ خودرویی از شهرستان‌ها اجازه ورود به پایتخت را نخواهد داشت و زائران فقط با مترو وارد شهر میشوند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-27T11:50:55Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 30900,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "عآلیجناب"
    },
    {
      "id": 540954,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eخدمات کارت بانکی ملی و صادرات دوباره مختل شد\u003cbr/\u003e\u003cbr/\u003e شرکت خدمات انفورماتیک \u003cbr/\u003e\u003cbr/\u003e«بررسی‌های فنی نشان می‌دهد اختلال جدید در امتداد آثار حمله سایبری اخیر به زیرساخت‌های بانکی ایجاد شده و تیم‌های فنی و امنیتی در حال شناسایی منشأ اختلال، ایمن‌سازی سامانه‌ها و بازگردانی پایدار خدمات هستند.»\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-27T11:52:55Z",
