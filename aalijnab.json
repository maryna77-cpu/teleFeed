    },
    {
      "id": 538300,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eترامپ: پل‌ها هدف بعدی حملات ما هستند! اما من نمی‌خواهم این کار را انجام دهم زیرا وقتی این کار را می‌کنم، مردم رنج می‌برند.\u003cbr/\u003e\u003cbr/\u003eما برای معترضان ایرانی سلاح فرستادیم، اما از کردها بسیار ناامید شدیم زیرا آنها سلاحها را به معترضان تحویل ندادند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-11T13:09:12Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 20000,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "عآلیجناب"
    },
    {
      "id": 538301,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eترامپ: ایرانی‌ها را نابود خواهیم کرد\u003cbr/\u003e\u003cbr/\u003eما ایرانی‌ها را نابود خواهیم کرد؛ آنها نه نیروی دریایی دارند، نه نیروی هوایی و نه پدافند هوایی.\u003cbr/\u003e\u003cbr/\u003eایران در تبلیغات خوب است اما در جنگیدن خوب نیست.\u003cbr/\u003e\u003cbr/\u003eهواپیماهای ما بر فراز قلب تهران پرواز می‌کنند.\u003cbr/\u003e\u003cbr/\u003e اگر ایران توافق را امضا نکند، آن را به شدت بمباران خواهم کرد.\u003cbr/\u003e\u003cbr/\u003eایرانی‌ها بسیار مغرور هستند و ۴۷ سال است که در خاورمیانه قلدری می‌کنند.\u003cbr/\u003e\u003cbr/\u003eما تمام رادارها، سامانه‌های پدافند هوایی و بیشتر موشک‌های ایران را نابود کردیم و معتقدیم که بیش از حدود ۲۰درصد از توان موشکی آنها باقی نمانده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-11T13:09:35Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 19900,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "عآلیجناب"
    },
    {
      "id": 538302,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eادعای وزیر خزانه داری آمریکا:\u003cbr/\u003e\u003cbr/\u003eایران در بازی با حاصل جمع صفر که در حال انجام آن است شکست خواهد خورد.\u003cbr/\u003e\u003cbr/\u003eهر آسیبی که ایران به متحدان ما در خلیج فارس وارد کند، با منابع مالی برداشت‌شده از حساب‌های تهران جبران خواهد شد.\u003cbr/\u003e\u003cbr/\u003eهر هزینه‌ای که به «سازمان تنگه خلیج فارس» پرداخت شود، از محل منابع مالی برداشت‌شده از حساب‌های آن‌ها جبران خواهد شد.\u003cbr/\u003e\u003cbr/\u003eهر حمله‌ای که ایران انجام دهد، تنها پیامدهای اقتصادی و مالی آن را برای خود عمیق‌تر خواهدکرد. \u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-11T13:10:19Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 21500,
      "forwards": 0,
