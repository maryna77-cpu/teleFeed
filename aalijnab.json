    },
    {
      "id": 545099,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8E99.png\u0026#39;)\"\u003e\u003cb\u003e🎙\u003c/b\u003e\u003c/i\u003eامیرحسین ثابتی: نباید تنگه رو از دست بدیم، نباید تنگه رو بدیم بره. شما می‌ گید تنگه رو باز کنیم، مفت بدیم بره.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5399997355455961843\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87AEF09F87B7.png\u0026#39;)\"\u003e\u003cb\u003e🇮🇷\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003eشهریاری، عضو کمیسیون امنیت ملی مجلس وسط پخش زنده : \u003cbr/\u003e\u003cb\u003eبدید برررره، تنگه مال ننت بوده که بدید بره؟\u003c/b\u003e\u003cbr/\u003e مال عمه‌تونه؟ مال کیه؟ ارث باباته؟\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8E99.png\u0026#39;)\"\u003e\u003cb\u003e🎙\u003c/b\u003e\u003c/i\u003eامیرحسین ثابتی : \u003cbr/\u003eآقای شهریاری ادب داشته باش چرا وارد بحث ناموسی میشی تو پخش زنده...\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
