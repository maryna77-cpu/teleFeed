    {
      "id": 546792,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eصدای انفجار در قشم تایید شد\u003cbr/\u003e\u003cbr/\u003eتسنیم: منشأ صدای انفجار در قشم، هدف قرار دادن اهداف متخاصم بود\u003cbr/\u003e\u003cbr/\u003eمنابع آگاه علت شنیده شدن صدای ۲ انفجار در قشم حوالی ساعت ۲۱ و ۴۰ دقیقه پانزدهم مرداد ۱۴۰۵ را مقابله با اهداف دشمن متخاصم در ورودی تنگه هرمز عنوان کردند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
