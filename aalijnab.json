    {
      "id": 538519,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e فوری: نخست‌وزیر پاکستان شریف درباره توافق ایران و آمریکا:\u003cbr/\u003e\u003cbr/\u003eمتن نهایی و مورد توافق توافقنامه صلح به دست آمده است.\u003cbr/\u003e\u003cbr/\u003eپاکستان اکنون به طور نزدیک با هر دو طرف برای نهایی کردن مراحل بعدی همکاری می‌کند.\u003cbr/\u003e\u003cbr/\u003eصلح هرگز به این نزدیکی نبوده است که اکنون هست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
