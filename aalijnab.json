    {
      "id": 549796,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eبعداز بریتانیا، حالا قراره کره‌جنوبی هم با هدف کمک به آزادی کشتیرانی تو تنگه هرمز وارد این منطقه بشه؛\u003cbr/\u003e\u003cbr/\u003eکره‌جنوبی اعلام کرده اگه دولت تصمیم نهایی رو بگیره، قراره تجهیزات نظامی مثل هواپیمای گشت دریایی، کشتی پشتیبانی لجستیکی یا واحد شناسایی و پاک‌سازی مینِ خودش رو به تنگه هرمز بفرسته.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-09-04T18:44:33Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 26000,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "عآلیجناب"
    },
    {
      "id": 549797,
      "message": "آشفتگی های ذهنی یک مهندس کامپیوتر گاهی کامپیوتر، گاهی فلسفه گاهی خودِ زندگی.....\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/a_dust_seeking_the_sun\" target=\"_blank\" rel=\"noopener\"\u003ehttps://t.me/a_dust_seeking_the_sun\u003c/a\u003e",
