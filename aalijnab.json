    },
    {
      "id": 541516,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e\u003cb\u003eشروع یه بتلفیلد تمام عیار (جنگ‌زمینی) در خاورمیانه؟\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبه گزارش واشنگتن‌پست: پنتاگون در حال آماده شدن برای اعزام نیروهای زمینی آمریکا به لبنانه؛ \u003cbr/\u003e\u003cblockquote\u003eاقدامی که هدفش اجرای توافق خلع سلاح حزب‌الله و کمک به مقابله با این گروهه.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003e\u003cbr/\u003e+به گفته تحلیلگرای جنگی؛ اگه توافق ایران  آمریکا خراب بشه، احتمال داره به‌زودی یه جنگ خیلی بزرگ‌تر و شدیدتر از قبل، کل خاورمیانه رو درگیر کنه.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
