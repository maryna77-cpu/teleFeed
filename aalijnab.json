    {
      "id": 544203,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eطبق تصاویر ماهواره‌ای بیش‌از 20 فروند هواپیمای سوخت رسان آمریکایی حاضر در قطر این کشور را ترک کردند.\u003cbr/\u003e\u003cbr/\u003eچنین اقدام مشابهی در روز های پیش از جنگ نیز مشاهده شده بود.\u003cbr/\u003e\u003cbr/\u003e \u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
