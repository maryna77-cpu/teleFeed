    },
    {
      "id": 535192,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eالعربیه به نقل از مسئول اسرائیلی:\u003cbr/\u003e\u003cbr/\u003eترامپ به نتانیاهو اطلاع داد که توافقی را امضا نخواهد کرد که شامل انتقال اورانیوم از ایران نباشد\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-05-24T13:57:07Z",
