    {
      "id": 537637,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eاورژانس ایران: ۱۵ نفر بر اثر حملات اخیر اسرائیل مجروح شدند\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e \u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
