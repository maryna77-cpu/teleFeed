    {
      "id": 551150,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eبه دلیل وتوی روسیه چین دوباره پیش نویس تحریم‌ها درباره ایران تصویب نشد\u003cbr/\u003e\u003cbr/\u003eقطعنامه پیشنهادی آمریکا که به دنبال تمدید فعالیت گروه موسوم به کارشناسان کمیته تحریم‌های ایران بود،با وتوی رسمی مسکو و پکن از دستور کار خارج شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
