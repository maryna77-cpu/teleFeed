    {
      "id": 539263,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eنشریه لکیپ فرانسه: دونالد ترامپ دستور مستقیم ابطال ویزای برخی از اعضای ایران از جمله مهدی ترابی و مهدی طارمی را صادر کرده‌است.\u003cbr/\u003e\u003cbr/\u003eباید دید در دیدار بعدی تیم ملی ایران در برابر بلژیک برای این دو بازیکن مشکل خاصی پیش می‌آید یا خیر.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
