    {
      "id": 535103,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e خبر امضای هرگونه توافق که هم‌اکنون در برخی از کانال های خبری به نقل از اکسیوس در حال انتشار است، جعلی و کذب است.\u003cbr/\u003e\u003cbr/\u003eنه اکسیوس و نه خبرنگارانش همچین خبری روی خروجی های خود ندارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
