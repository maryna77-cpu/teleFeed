    {
      "id": 543018,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29CA8.png\u0026#39;)\"\u003e\u003cb\u003e✨\u003c/b\u003e\u003c/i\u003e همپا و هم دست شماییم!\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29CA8.png\u0026#39;)\"\u003e\u003cb\u003e✨\u003c/b\u003e\u003c/i\u003e\u003cbr/\u003eبا همپا آزمون، خیالت از بابت آزمون‌ها و مصاحبه ها راحت باشه!\u003cbr/\u003e\u003cbr/\u003eپوشش آزمون‌ها:\u003cbr/\u003eتافل، آیلتس، دولینگو GRE، CENT، GCSE، UAS، ELLT، CSCA و مصاحبه‌های سفارت و دانشگاه\u003cbr/\u003e\u003cbr/\u003eمشاوره رایگان + پشتیبانی اختصاصی\u003cbr/\u003e\u003ca href=\"https://t.me/hampaazmoon_crm\" target=\"_blank\"\u003e@hampaazmoon_crm\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/hampaazmoon_crm\" target=\"_blank\"\u003e@hampaazmoon_crm\u003c/a\u003e",
