      "message": "\u003ctg-emoji emoji-id=\"5411225014148014586\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eجزئیات ‌بمباران کمپ بوهرینگ آمریکا توسط جنگنده‌های ارتش ایران\u003c/b\u003e در ابتدای جنگ\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003eعملیات توسط جنگنده‌های \u003cb\u003eاف-۵ نیروی هوایی ارتش\u003c/b\u003e انجام شد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eپرواز در ارتفاع بسیار پایین (کمتر از ۵۰ پا) برای فرار از رادارها صورت گرفت.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eخلبانان در سکوت کامل رادیویی مأموریت را اجرا کردند.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمسیر پرواز از روی آب و نزدیک کشورهای همسایه عبور کرد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eبا وجود پدافند چندلایه آمریکا و کویت، جنگنده‌ها به هدف رسیدند.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eبمباران با \u003cb\u003eبمب‌های سقوط آزاد\u003c/b\u003e انجام شد.\u003cbr/\u003eخلبانان مدعی انهدام بالگردها و تجهیزات آمریکایی در پایگاه شدند.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eبه گفته فرمانده عملیات، دشمن از رسیدن جنگنده‌های ایرانی غافلگیر شد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eادعا شده پدافند کویت در جریان درگیری به اشتباه \u003cb\u003eسه فروند اف-۱۵ آمریکایی\u003c/b\u003e را هدف قرار داد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eعملیات فریب باعث شد نیروهای دشمن نتوانند جنگنده‌های ایرانی را تعقیب کنند.\u003cbr/\u003eتمامی هواپیماها با موفقیت به پایگاه تعیین‌شده بازگشتند.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eمدت کل عملیات حدود \u003cb\u003e۵۰ دقیقه\u003c/b\u003e اعلام شد.\u003cbr/\u003eخلبانان انگیزه خود را انتقام حمله به \u003cb\u003eمدرسه میناب\u003c/b\u003e و دفاع از ایران عنوان کردند.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eفرمانده عملیات تأ