    },
    {
      "id": 104613,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D9%88%D8%A7%DA%A9%D9%86%D8%B4-%D8%A8%D8%A7%D8%B2%D8%A7%D8%B1-%D8%A8%D9%87-%D8%B3%D8%AE%D9%86%D8%B1%D8%A7%D9%86%DB%8C-%D9%BE%D8%B2%D8%B4%DA%A9%DB%8C%D8%A7%D9%86-%D8%AF%D9%84%D8%A7%D8%B1-%DB%B2%DB%B3%DB%B6-%D9%87%D8%B2%D8%A7%D8%B1-%D9%88-%DB%B5%DB%B0%DB%B0-%D8%AA%D9%88%D9%85%D8%A7%D9%86-%D8%B4%D8%AF-09-24\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eواکنش بازار به سخنرانی پزشکیان؛ دلار ۲۳۶ هزار و ۵۰۰ تومان شد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eیک روز پس از سخنرانی مسعود پزشکیان در مجمع عمومی سازمان ملل، قیمت دلار در بازار آزاد ایران بار دیگر افزایش یافت و به ۲۳۶ هزار و ۵۰۰ تومان رسید. به این ترتیب دلار که در نخستین روز معاملاتی سال ۱۴۰۵ حدود ۱۵۲ هزار تومان بود، در سایه سیاست‌های جنگ‌طلبانه جمهوری اسلامی ایران، طی شش ماه ۸۴ هزار و ۵۰۰ تومان، معادل ۵۵.۶ درصد گران شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
