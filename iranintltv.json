    {
      "id": 345956,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eارلینگ هالند مهاجم تیم ملی نروژ با بریس در بازی با برزیل تعداد گل‌های خود در جام جهانی ۲۰۲۶ را به عدد ۷ رساند و با کیلیان امباپه و لیونل مسی در صدر جدول گلزنان این جام قرار گرفت.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eارلینگ هالند با درخشش خود، نروژ را به یکی از بزرگ‌ترین شگفتی‌های جام جهانی ۲۰۲۶ رساند و پنج‌قهرمان جهان را از رقابت‌ها حذف کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eهالند در دقیقه ۷۹ با ضربه سر نروژ را پیش انداخت و سپس در دقیقه ۹۰ با شوتی محکم و زمینی از پشت محوطه جریمه، دروازه آلیسون را باز کرد تا پیروزی تیمش را قطعی کند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eاین دو گل باعث شد هالند با لیونل مسی و کیلیان امباپه، با هفت گل، در صدر جدول گلزنان جام جهانی برابر شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/iranintltvsport\" target=\"_blank\"\u003e@iranintltvsport\u003c/a\u003e",
