    {
      "id": 6973,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e \u0026#34;بعد از جنگ وضعیت راننده‌های تریلی خیلی بدتر شد. بار نیست، بندرها خالی شده، جاده‌ها چند ماهه زیر بمبارانه، سپاه با کانتینر پوششی مهمات جابجا می‌کنه برای ما هم خطرناکه…\u003cbr/\u003e\u003cbr/\u003eپیام دریافتی\u003cbr/\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"?q=%23%D8%B1%D8%A7%D9%86%D9%86%D8%AF%DA%AF%D8%A7%D9%86_%D8%AA%D8%B1%DB%8C%D9%84%DB%8C\"\u003e\u003cb\u003e#رانندگان_تریلی\u003c/b\u003e\u003c/a\u003e\u003cb\u003e \u003c/b\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e\u003cb\u003e#جنگ\u003c/b\u003e\u003c/a\u003e\u003cb\u003e \u003cbr/\u003e\u003c/b\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e\u003cb\u003e@DEJradio\u003c/b\u003e\u003c/a\u003e",
