    {
      "id": 6479,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eیک‌صد و هشتاد نمایندۀ مجلس خواستار اعلام موضع سران قوا دربارۀ پایان تفاهم با آمریکا شدند \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e۱۸۰ نمایندۀ مجلس شورای اسلامی با انتشار بیانیه‌ای خواستار اعلام موضع رسمی سران قوای حکومت جمهوری اسلامی دربارۀ پایان تفاهم‌نامه با آمریکا شدند.\u003cbr/\u003eامضاکنندگان این بیانیه همچنین بر پیگیری «انتقام‌گیری» از کشته شدن علی خامنه‌ای تأکید کردند.\u003cbr/\u003eاین نمایندگان از سویی خواستار تشکیل فوری یک کمیسیون ویژه، برای بررسی مذاکرات با آمریکا و تصویب قانون مدیریت تنگۀ هرمز شده‌اند.\u003cbr/\u003eاین درخواست پس از آن مطرح شده که دونالد ترامپ از پایان تفاهم‌ میان واشینگتن و تهران خبر داد.\u003cbr/\u003eنشست نمایندگان مجلس شورای اسلامی به‌صورت شبانه و بدون حضور محمدباقر قالیباف، رئیس این نهاد و سرپرست مذاکره‌کنندگان رژیم برگزار شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AC%D9%84%D8%B3_%D8%B4%D9%88%D8%B1%D8%A7%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#مجلس_شورای_اسلامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
