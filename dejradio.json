    {
      "id": 6316,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e خط آهن آق‌قلا مسیر راهبردی جمهوری اسلامی برای دور زدن تحریم‌ها از مسیر روسیه است. این مسیر به عنوان کریدور شرقی شمال-جنوب، از ایران به ترکمنستان و قزاقستان رفته و در نهایت به شبکه ریلی روسیه می‌پیوندد. \u003cbr/\u003e\u003cbr/\u003eکارشناسان می‌گویند آمریکا با هدفگیری این خط در واقع اعلام کرد نخواهیم گذاشت از طرق دیگر محاصره دریایی را دور بزنید.\u003cbr/\u003e\u003cbr/\u003eبعد از بمباران این پل یکی از مسیرهای ریلی تهران به مشهد متوقف شد، آن‌هم در شرایطی که قرار است روز پنجشنبه ۱۸ تیرماه جسد خامنه‌ای برای مرحله آخر تشییع از نجف به مشهد منتقل شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B1%D9%88%D8%B3%DB%8C%D9%87\"\u003e#روسیه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
