    {
      "id": 4579,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A1.png\u0026#39;)\"\u003e\u003cb\u003e🤡\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e حکومت برای رونق‌بخشیدن به تجمعات شبانه، شیعیان را از کشورهای همسایه تا دورترین نقاط آفریقا به خیابان‌ها سرازیر کرده است!\u003cbr/\u003e\u003cbr/\u003eدر یکی از آخرین نمونه‌ها طلاب اوگاندایی و خانواده‌های آنها که در حوزه‌های علمیه بساط پهن کرده‌اند به عنوان سیاهی‌لشکر به تجمعات آمده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%AC%D9%85%D8%B9%D8%A7%D8%AA_%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#تجمعات_حکومتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%88%DA%AF%D8%A7%D9%86%D8%AF%D8%A7\"\u003e#اوگاندا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
