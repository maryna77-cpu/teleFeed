    {
      "id": 5770,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://x.com/PahlaviComms/status/2067292455058473271?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eشاهزاده رضا پهلوی در دومین روز سفر خود به بریتانیا با اندرو میچل، نماینده پارلمان و معاون پیشین وزیر امور خارجه بریتانیا، که سال‌ها از حامیان و دوستان ملت ایران بوده است، دیدار و گفت‌وگو کرد\u003c/a\u003e.\u003cbr/\u003e\u003cbr/\u003eدر این دیدار، آخرین تحولات ایران و ضرورت حمایت از مبارزه ملت ایران برای دستیابی به دموکراسی، آزادی و آینده‌ای فراتر از جمهوری اسلامی مورد بحث و تبادل نظر قرار گرفت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A8%D8%B1%DB%8C%D8%AA%D8%A7%D9%86%DB%8C%D8%A7\"\u003e#بریتانیا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
