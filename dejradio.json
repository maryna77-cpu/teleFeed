    {
      "id": 7984,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e پروفسور افشین الیان، عضو کمیته تدوین مقررات عدالت انتقالی ایران، در گفت‌وگو با دژ درباره همدستی با نیروهای امنیتی و سپاهی‌ها در جنایت علیه مردم ایران می‌گوید، با فروپاشی رژیم، نه فقط مهره‌های امنیتی و پاسداران، بلکه درست مانند همکاری با سازمان‌های مافیایی جنایتکار، از همسران آنها، اعضای دفترشان تا آشپز گرفته محاکمه خواهند شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%DA%A9%D9%85%D9%87\"\u003e#محاکمه\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%87_%D9%85%DB%8C%D8%A8%D8%AE%D8%B4%DB%8C%D9%85_%D9%86%D9%87_%D9%81%D8%B1%D8%A7%D9%85%D9%88%D8%B4_%D9%85%DB%8C%DA%A9%D9%86%DB%8C%D9%85\"\u003e#نه_میبخشیم_نه_فراموش_میکنیم\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D8%AF%D8%A7%D9%84%D8%AA_%D8%A7%D9%86%D8%AA%D9%82%D8%A7%D9%84%DB%8C\"\u003e#عدالت_انتقالی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
