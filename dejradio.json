    {
      "id": 6119,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e مهدی رستم‌پور:\u003cbr/\u003eدردانه فعال سیاسی چپ برای مردم گل‌واژه می‌گوید\u003cbr/\u003e\u003cbr/\u003eمهدی رستم‌پور روزنامه‌نگار ورزشی با انتقاد از سیاست‌های تلویزیون صدای آمریکا، از اظهارات سرکوهی انتقاد کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D8%AC_%D8%B3%D8%B1%DA%A9%D9%88%D9%87%DB%8C\"\u003e#فرج_سرکوهی\u003c/a\u003e \u003ca href=\"?q=%23%DA%86%D9%BE\"\u003e#چپ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84%DB%8C\"\u003e#دژفوتبالی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
