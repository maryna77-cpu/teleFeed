    {
      "id": 7864,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eکشف پرتابگرهای پهپادی در مرز عراق و ایران پس از حمله به خط لولۀ نفت عربستان\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدو مقام امنیتی عراق به خبرگزاری فرانسه گفتند ارتش این کشور چند پرتابگر پهپاد را در نزدیکی مرز ایران کشف کرده است.\u003cbr/\u003eبه گفتۀ این منابع، پرتابگرها در منطقۀ دورافتادۀ «الطیب» در استان میسان، نزدیک مرز عراق و ایران، پیدا شده‌اند.\u003cbr/\u003eاین کشف پس از حمله پهپادی به خط لولۀ نفت عربستان صورت گرفته است؛ حمله‌ای که مقام‌های بغداد و ریاض اعلام کردند از خاک عراق انجام شده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%BE%D9%87%D9%BE%D8%A7%D8%AF\"\u003e#پهپاد\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
