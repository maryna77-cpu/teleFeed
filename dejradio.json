    {
      "id": 7075,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e نیروهای مسلح جمهوری اسلامی برای جابه‌جایی ادوات نظامی از سپر انسانی استفاده می‌کنند. در یکی از این موارد، شماری جیپ مجهز به توپ و چند دستگاه تویوتا که احتمالا متعلق به سپاه پاسداران است، با یک تریلی خودروبر از مناطق مرکزی ایران به سمت جنوب کشور منتقل شده‌اند.\u003cbr/\u003e\u003cbr/\u003eاین تریلی‌ها معمولا برای حمل خودروهای صفر، خودروهای کارکرده وارداتی یا محصولات خودروسازان داخلی استفاده می‌شوند. در همین تریلی نیز یک دستگاه پژو ۴۰۵ بارگیری شده است.\u003cbr/\u003e\u003cbr/\u003eدر شرایط جنگی که تجهیزات و مراکز نظامی ممکن است هدف حملات آمریکا یا اسرائیل قرار گیرند، استفاده از خودروهای غیرنظامی و قرار دادن تجهیزات نظامی در میان اموال و وسایل عمومی، اقدامی غیرمسئولانه است که می‌تواند جان و مال شهروندان را در معرض خطر قرار دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%B1_%D8%A7%D9%86%D8%B3%D8%A7%D9%86%DB%8C\"\u003e#سپر_انسانی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
