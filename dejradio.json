    {
      "id": 5719,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e نیمه شب دوشنبه ۲۵ خرداد ۱۴۰۵ تاسیسات نظامی‌نشین «شهرک امید» به دلایل نامعلوم دچار آتش‌سوزی شد. \u003cbr/\u003e\u003cbr/\u003eبسیاری از ساکنان شهرک پرسنل ارتش هستند. علت آتش‌سوزی مشخص نیست. منابع داخلی به دژ گفته‌اند احتمال خرابکاری توسط تیم‌های امنیتی بررسی می‌شود. ساکنان این شهرک با وجود فضای امنیتی در جریان انقلاب شیرخورشید علیه نظام شعار دادند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A3%D8%AA%D8%B4%D8%B3%D9%88%D8%B2%DB%8C\"\u003e#أتشسوزی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D9%87%D8%B1%DA%A9_%D8%A7%D9%85%DB%8C%D8%AF\"\u003e#شهرک_امید\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%86%D9%82%D9%84%D8%A7%D8%A8_%D8%B4%DB%8C%D8%B1%D9%88%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF\"\u003e#انقلاب_شیروخورشید\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
