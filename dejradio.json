    {
      "id": 6882,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e حملات سنگین پهپادی اوکراین به زیرساخت‌های روسیه\u003cbr/\u003e\u003cbr/\u003eساعاتی پیش از دیدار زلنسکی و ترامپ، ارتش اوکراین با بیش از ۳۲۰ فروند پهپاد زیرساخت‌های کلیدی روسیه را هدف قرار داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D9%88%DA%A9%D8%B1%D8%A7%DB%8C%D9%86\"\u003e#اوکراین\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D9%88%D8%B3%DB%8C%D9%87\"\u003e#روسیه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
