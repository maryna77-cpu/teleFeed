    {
      "id": 5937,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A1.png\u0026#39;)\"\u003e\u003cb\u003e🤡\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e مراسم عزاداری «تاسوعا» سه‌شنبه شب دوم تیرماه ۱۴۰۵ دوم تیرماه ۱۴۰۵ در کنار بیت علی خامنه‌ای که در جنگ ۴۰ روزه بمباران شد، برگزار گردید. \u003cbr/\u003eبه‌جای علی خامنه‌ای یک قاب عکس روی صندلی قرار گرفته بود و کنارش مخبر [معاون رئیسی] محمدرضا عارف معاون پزشکیان و محسن رضایی ماتم‌زده نشسته بودند.\u003cbr/\u003e\u003cbr/\u003eگزارش شد که این مراسم از طرف مجتبی خامنه‌ای برگزار شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D8%A7%D8%B4%D9%88%D8%B1%D8%A7\"\u003e#عاشورا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%A7%D8%B3%D9%88%D8%B9%D8%A7\"\u003e#تاسوعا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
