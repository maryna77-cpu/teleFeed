    {
      "id": 4581,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e تعرض به دختران مدرسه شرافت؛ \u0026#34;سکوت نکنید ملت\u0026#34;\u003cbr/\u003e\u003cbr/\u003eتعرض ماموران امنیتی به دختران دانش‌آموز مدرسه شرافت با واکنش‌های مختلف در ایران روبرو شده است. \u003cbr/\u003eدانش‌آموزان و خانواده‌های آنها زیر فشار قرار دارند و سایر هموطنان مسئول‌ند از آنها پشتیبانی کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AF%D8%B1%D8%B3%D9%87_%D8%B4%D8%B1%D8%A7%D9%81%D8%AA\"\u003e#مدرسه_شرافت\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B3%D8%A6%D9%88%D9%84%DB%8C%D8%AA_%D9%85%D8%AF%D9%86%DB%8C\"\u003e#مسئولیت_مدنی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
