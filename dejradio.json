    {
      "id": 7369,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A1.png\u0026#39;)\"\u003e\u003cb\u003e🤡\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e خوش‌چشم:\u003cbr/\u003eخلیج فلوریدا رو مین‌گذاری کنیم!\u003cbr/\u003e\u003cbr/\u003eمصطفی خوش‌چشم، کارشناس صدا و سیما، در یک گفت‌وگوی تلویزیونی پیشنهاد داد نیروهای مسلح جمهوری اسلامی خلیج فلوریدا آمریکا را مین‌گذاری کنند. \u003cbr/\u003e\u003cbr/\u003eاین اظهارات با واکنش‌های زیادی از سوی کاربران در شبکه‌های اجتماعی مواجه شده است. برخی کاربران به کنایه گفته‌اند اظهارات او ناشی از سوء مصرف مواد مخدر است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D9%84%DB%8C%D8%AC_%D9%81%D9%84%D9%88%D8%B1%DB%8C%D8%AF%D8%A7\"\u003e#خلیج_فلوریدا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B5%D8%AF%D8%A7%D9%88%D8%B3%DB%8C%D9%85%D8%A7\"\u003e#صداوسیما\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%DA%A9_%D8%A7%D8%B9%D8%AA%DB%8C%D8%A7%D8%AF\"\u003e#ترک_اعتیاد\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
