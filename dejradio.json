    {
      "id": 5721,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e به گزارش آکسیوس، جان راتکلیف رئیس سازمان اطلاعات آمریکا (CIA)، به ترامپ و مقامات ارشد تیم امنیت ملی دولت ترامپ اعلام کرد، اطلاعات جمع‌آوری‌شده توسط سازمان‌های اطلاعاتی آمریکا، تردید جدی درباره تمایل ایران به پذیرش امتیازات هسته‌ای که واشنگتن به عنوان بخشی از توافق در یادداشت تفاهم نامه درخواست می‌کند، ایجاد کرده است.\u003cbr/\u003e\u003cbr/\u003eاطلاعات نشان می‌داد که شکافی بزرگ بین نحوه صحبت مقامات ارشد ایرانی در میان خود درباره توافق و پیام‌هایی که به میانجی‌ها و آمریکا منتقل می‌کردند وجود دارد.\u003cbr/\u003eرتکلیف تنها فرد بدبین در تیم ترامپ نیست. به گفته دو منبع، در بحث‌های داخلی، مارکو روبیو وزیر امور خارجه و پیت هگست وزیر دفاع نیز نگرانی‌هایی را مطرح کرده و درباره تفاهم‌نامه اعلام‌شده در روز یکشنبه پرسش‌هایی مطرح کرده‌اند. در مقابل، جی‌دی ونس معاون رئیس‌جمهور و نمایندگان آمریکا استیو ویتکاف و جرد کوشنر از این توافق حمایت کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
