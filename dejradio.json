    {
      "id": 6607,
      "message": "\u003ctg-emoji emoji-id=\"5807938374341760679\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94A5.png\u0026#39;)\"\u003e\u003cb\u003e🔥\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A1.png\u0026#39;)\"\u003e\u003cb\u003e📡\u003c/b\u003e\u003c/i\u003e ارتش آمریکا شنبه شب ۲۷ تیرماه ۱۴۰۵ به زیرساخت‌های نظامی و راهبردی چند شهر از جمله بروجرد، ایرانشهر، سیریک، بندرعباس و بوشهر حمله کرد. \u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌های اولیه «پل سورمیچ» پل اتصال ایرانشهر به سمت چابهار هدف این حملات قرار گرفت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86%D8%B4%D9%87%D8%B1\"\u003e#ایرانشهر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
