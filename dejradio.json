    {
      "id": 7859,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e سرهنگ دوم انتظامی مهدی رضایی در ویدیویی با اشاره به وضعیت بد و سخت زندگی از مردم خواست کنار یکدیگر باشند.\u003cbr/\u003e\u003cbr/\u003eویدیوی او با واکنش‌های مختلف روبه‌رو شده است؛ برخی به او گفته‌اند مانند سایر ماموران در سرکوب‌ها دخالت داشته و او در پاسخ گفته \u0026#34;قضاوت با خداست.\u0026#34; \u003cbr/\u003e\u003cbr/\u003eشماری از دوستان او نیز در کامنت‌ها از او به عنوان پلیس مردمی نام برده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D9%84%DB%8C%D8%B3\"\u003e#پلیس\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
