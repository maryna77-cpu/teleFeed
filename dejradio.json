    {
      "id": 5617,
      "message": "\u003ctg-emoji emoji-id=\"5949629152163271756\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e ترامپ: جمهوری اسلامی دربارۀ تفاهمنامه، دروغ و چرند می‌گوید\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ، رئیس جمهوری ایالات متحده عصر آدینه ۲۲ خرداد اعلام کرد مفادی که جمهوری اسلامی دربارۀ توافق احتمالی با آمریکا نشر داده، واقعی نیست.\u003cbr/\u003eبه گفتۀ ترامپ، بندهایی از توافق که مقامات تهران از طریق رسانه‌های دروغگو نشر داده‌اند، با بندهایی که بر سر آن تفاهم شده است، هیچ شباهتی ندارد.\u003cbr/\u003eرئیس جمهوری آمریکا افزود گفته‌های مقام‌های جمهوری اسلامی دربارۀ توافق ضعیف و چرند است.\u003cbr/\u003eاو بازهم رژیم حاکم بر ایران را متهم کرد که در مذاکرات با حسن نیت عمل نمی‌کند.\u003cbr/\u003eرئیس جمهوری آمریکا همچنین از حمله پهپادی جمهوری اسلامی به کشتی‌های هندی در حال عبور از تنگه هرمز انتقاد کرد و گفت این حملۀ ناکام، پذیرفتنی نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1_%D9%81%D9%88%D8%B1%DB%8C\"\u003e#خبر_فوری\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
