    {
      "id": 7556,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eکشف پرونده به‌کارگیری نوجوانان زیر سن قانونی از سوی مأمور اطلاعاتی جمهوری اسلامی در اسرائیل\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eپلیس اسرائیل از کشف پرونده‌ای امنیتی خبر داد که در آن چند نوجوان ساکن حیفا و مناطق اطراف، با یک مأمور اطلاعاتی جمهوری اسلامی ارتباط مستمر داشته‌اند.\u003cbr/\u003eبر اساس اعلام پلیس، تحقیقات با بازداشت یک نوجوان در فرودگاه بن‌گوریون به ظن جاسوسی و ارتباط با مأمور خارجی آغاز شد. او هنگام جست‌وجوی کار در اینترنت با این مأمور آشنا شده و ابتدا مأموریت‌هایی ظاهراً عادی، مانند توزیع تراکت، دریافت کرده بود. مأمور سپس از او خواسته بود با ارسال تصاویر، هویت خود را به‌طور کامل مشخص کند.\u003cbr/\u003eبه گفته پلیس، این نوجوان در ادامه فرد زیر سن قانونی دیگری را نیز جذب کرد. آن‌ها در قبال دریافت چند هزار شِکِل، مأموریت‌هایی از جمله دیوارنویسی با محتوای تحریک‌آمیز علیه دولت، تصویربرداری از مراکز مهم و راهبردی در مرکز اسرائیل و تلاش برای جذب نوجوانان دیگر انجام دادند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D8%B3%D9%88%D8%B3%DB%8C\"\u003e#جاسوسی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%88%D8%AC%D9%88%D8%A7%D9%86%D8%A7%D9%86\"\u003e#نوجوانان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
