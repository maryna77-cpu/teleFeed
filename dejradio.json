    {
      "id": 7639,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e در خیابان وکیل‌آباد مشهد، یک راننده که ادعا شد مست بوده، چهارشنبه شب ۱۰ شهریور ۱۴۰۵، ماشین را به تجمع هواداران نظام کوبید که دست‌کم ۴ نفر کشته و ۱۰ نفر زخمی شدند. \u003cbr/\u003e\u003cbr/\u003eیکی از هواداران نظام در مصاحبه با رسانه‌ها می‌گوید عامل این تصادف را می‌شناخته و یچه‌مسلمان بوده و در پیاده‌روی اربعین با او همسفر بوده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B4%D9%87%D8%AF\"\u003e#مشهد\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D9%84%D8%A7%D9%85\"\u003e#اسلام\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%A8%D8%B9%DB%8C%D9%86\"\u003e#اربعین\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
