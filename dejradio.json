    {
      "id": 5395,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  پرواز پهپاد در نزدیکی ورزشگاه‌های جام جهانی جرم به‌شمار می‌رود\u003cbr/\u003e\u003cbr/\u003eپلیس فدرال آمریکا هشدار داد پرواز پهپاد در محدودۀ ورزشگاه‌ها و اماکن مرتبط با جام جهانی فوتبال ممنوع است.\u003cbr/\u003eمقام‌های آمریکایی اعلام کردند محدودیت‌های موقت پروازی برای حفاظت از بازیکنان، تماشاگران و زیرساخت‌ها اعمال می‌شود.\u003cbr/\u003eاف‌بی‌آی گفت نادیده گرفتن این محدودیت‌ها می‌تواند تا ۱۰۰ هزار دلار جریمه، یک سال زندان و ضبط پهپاد را در پی داشته باشد.\u003cbr/\u003eپلیس فدرال آمریکا اعلام کرد تیم‌های ویژۀ ضدپهپاد در برخی از مکان‌های مسابقات مستقر می‌شود.\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D9%87%D9%BE%D8%A7%D8%AF\"\u003e#پهپاد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
