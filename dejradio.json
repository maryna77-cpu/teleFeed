    {
      "id": 7209,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e یک هفته پس از قتل حمیدرضا رجب‌زاده مداح حکومتی، یک بـ.ـسیجی ساکن تهران به نام سعید کاظمی توسط گروهی ناشناس به قتل رسید. او از سرکوبگران خیزش دی‌ماه ۱۴۰۴ بود.\u003cbr/\u003e\u003cbr/\u003eقتل وی در سناریویی مشابه قتل‌های حکومتی صورت گرفته است. او روز سه‌شنبه ۲۰ امرداد ۱۴۰۵ توسط یک خودرو عمدی زیر گرفته شد و سپس با ضربات چاقو به قتل رسید. قاتلان فراری هستند.\u003cbr/\u003e\u003cbr/\u003eمقامات امنیتی ادعا کرده بودند یک زن بلاگر و نوچه‌هایش رجب‌زاده را به قتل رساندند، اکنون باید دید در مورد قتل این بـ.ـ.سیجی چه ادعایی مطرح خواهد شد. \u003cbr/\u003e\u003cbr/\u003eجریان‌های حکومتی ابتدا تلاش کردند قتل را به مخالفان حکومت نسبت دهند اما سناریو آنقدر علنی بود که مقامات امنیتی اعلام کردند این ماجرا ارتباطی با مسائل سیاسی ندارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D8%B9%DB%8C%D8%AF_%DA%A9%D8%A7%D8%B8%D9%85%DB%8C\"\u003e#سعید_کاظمی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B3%DB%8C%D8%AC%DB%8C\"\u003e#بسیجی\u003c/a\u003e",
