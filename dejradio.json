    {
      "id": 7021,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e مردم برای تعویض لاستیک پول هم ندارند\u003cbr/\u003e\u003cbr/\u003eیک فروشنده لاستیک، با انتشار ویدیویی نشان داد وضعیت اقتصادی مردم آنقدر بد شده که حتی پول برای تعویض لاستیک‌های فرسوده را ندارند و با زن و بچه خطر را به جان می‌خرند و سوار ماشین ناایمن می‌شوند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B9%D9%88%DB%8C%D8%B6_%D9%84%D8%A7%D8%B3%D8%AA%DB%8C%DA%A9\"\u003e#تعویض_لاستیک\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
