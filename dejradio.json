    {
      "id": 6248,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e جانشین فرمانده سپاه ناحیه پاوه در \u0026#34;سانحه رانندگی\u0026#34; کشته شد\u003cbr/\u003e\u003cbr/\u003eسرهنگ پاسدار صفدر سلطانی، جانشین فرمانده سپاه تروریستی ناحیه پاوه، در مسیر بازگشت از مراسم تشییع علی خامنه‌ای، بر اثر \u0026#34;سانحه رانندگی\u0026#34; کشته شد.\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش یک منبع محلی، خودروی حامل اعضای کاروان اعزامی از شهرستان پاوه که برای شرکت در مراسم حکومتی تشییع علی خامنه‌ای به محل برگزاری این مراسم اعزام شده بودند، در مسیر بازگشت و در محور همدان ـ ساوه دچار سانحه شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23IRGCterrorirst\"\u003e#IRGCterrorirst\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
