    {
      "id": 6903,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e ارتش جمهوری اسلامی ایران هویت یکی از چهار خلبانی که اسفندماه ۱۴۰۴ در ماموریت حمله با دو فروند سوخو۲۴ به پایگاه «العُدید» آمریکا در قطر مفقود شده بودند را اعلام کرد.\u003cbr/\u003eسرتیپ دوم خلبان مجید کاظمی که منابع داخلی می‌گویند پس از اصابت در نزدیک ساحل ایجکت کرده است اما به علت پایین بودن ارتفاع به شدت با زمین برخورد کرده است.\u003cbr/\u003e\u003cbr/\u003eطبق اعلام ارتش پیکر او با آزمایش دی‌ان‌ای، شناسایی شد و به زودی به ایران باز می‌گردد.\u003cbr/\u003eوضعیت سه خلبان دیگر همچنان مشخص نیست. برخی منابع مدعی بودند آنها اسیر شدند و در قطر هستند.\u003cbr/\u003e\u003cbr/\u003eاین خلبانان عملا به ماموریت بی‌بازگشت اعزام شده بودند زیرا پیدا بود هواپیماهای فرسوده سوخو ۲۴ در مقابل پدافند و جنگنده‌های آمریکایی مستقر در منطقه شکست خورده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%BA%D9%81%D9%88%D8%AF%DB%8C\"\u003e#مغفودی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AC%DB%8C%D8%AF_%DA%A9%D8%A7%D8%B8%D9%85%DB%8C\"\u003e#مجید_کاظمی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
