    {
      "id": 8136,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e در حالی‌که قطر و عمان برای از سرگیری مذاکرات جمهوری اسلامی و آمریکا تلاش می‌کنند، بر اساس گزارش وال‌استریت ژورنال، محمد بن‌سلمان از آمریکا خواسته محاصره دریایی ایران را ادامه دهد.\u003cbr/\u003e\u003cbr/\u003eبن‌سلمان از ترامپ خواسته تا دستیابی به توافق نهایی باید محاصره ادامه پیدا کند.\u003cbr/\u003eجمهوری اسلامی با حوثی‌ها تاسیسات نفتی و نفتکش‌های عربستان سعودی را هدف قرار می‌دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A8%D8%B3%D8%AA%D8%A7%D9%86_%D8%B3%D8%B9%D9%88%D8%AF%DB%8C\"\u003e#عربستان_سعودی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
