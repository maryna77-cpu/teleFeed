    {
      "id": 8303,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e شهاب عنایتی از پرسنل پیشین ارتش با اشاره به وعده فرماندهان ارتش به مردم برای پرداخت پاداش ۱۰ میلیارد تومانی به ازای قتل یا اسارت سربازان آمریکایی از آنان می‌پرسد چرا فرزندان و خانواده خودتان را برای قتل آنها نمی‌فرستید؟\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
