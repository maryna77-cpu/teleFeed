    {
      "id": 8065,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e تصاویر تازه‌ای از سایت نظامی «شهید رودکی» متعلق به سـ.ـپاه پاسداران در قشم منتشر شد که نشان می‌دهد در حملات آمریکا سوله‌ها و انبارهای این مرکز تقریبا به طور کامل منهدم شده است. \u003cbr/\u003eاین تاسیسات که ۸ امرداد ۱۴۰۵ مورد حمله قرار گرفت، متعلق به نیروی زمینی سـ.ـپاه است. این مرکز وابسته به «قرارگاه مدینه منوره» است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%82%D8%B4%D9%85\"\u003e#قشم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
