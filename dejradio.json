    {
      "id": 6560,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شاهزاده رضا پهلوی در گفت‌وگو با کریستین مالارد، روزنامه‌نگار و خبرنگار فرانسوی، در شبکه I24NEWS تأکید کرد که سال‌هاست هشدار می‌دهد جمهوری اسلامی در ذات خود با آزادی و دموکراسی ناسازگار است و بقای ایدئولوژی خود را بر منافع و رفاه مردم ایران ترجیح می‌دهد.\u003cbr/\u003eبه گفته او، آنچه امروز شاهد آن هستیم، بار دیگر درستی این هشدار را ثابت می‌کند، رژیمی که نه به رفاه مردم ایران، بلکه به بقای خود و صدور ایدئولوژی‌اش از طریق نیروهای نیابتی می‌اندیشد. پیامدهای این سیاست دیگر تنها به خاورمیانه محدود نیست و امروز امنیت شهروندان در اروپا و دیگر نقاط جهان را نیز تهدید می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
