    {
      "id": 5452,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e جمهوری اسلامی ایران بامداد دوشنبه ۱۸ خرداد ۱۴۰۵ پایگاه هوایی شاهزاده سلطان در عربستان سعودی محل استقرار نیروهای آمریکایی را هدف قرار داد. \u003cbr/\u003e\u003cbr/\u003eاین منطقه در جنوب شرقی ریاض و در منطقه‌ای بین ریاض و استان شرقی در نزدیکی شهر الخرج قرار دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A8%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#عربستان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
