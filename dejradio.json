    {
      "id": 6961,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e سعید قاسمی‌نژاد، مدیر پروژه شکوفایی ایران و مشاور شاهزاده رضا پهلوی با اشاره به اعدام دو جوان معترض که در خیزش شیر و خورشید بازداشت شده بودند، می‌گوید اینکه حکومت در سال‌های اخیر میزان خشونت را افزایش داده ریشه ایدئولوژیک دارد اما اثر این خشونت‌ها کمتر و کمتر می‌شود؛ از جمله اینکه با وجود تمام اعدام‌ها و قتل‌عام‌ها فاصله میان اعتراضات کمتر شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AF%D8%A7%D9%85\"\u003e#اعدام\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%86%D9%82%D9%84%D8%A7%D8%A8_%D8%B4%DB%8C%D8%B1%D9%88%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF\"\u003e#انقلاب_شیروخورشید\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%B1%D9%88%DA%98%D9%87_%D8%B4%DA%A9%D9%88%D9%81%D8%A7%DB%8C%DB%8C\"\u003e#پروژه_شکوفایی\u003c/a\u003e  \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
