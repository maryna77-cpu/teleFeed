    {
      "id": 6610,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eوزارت خارجهٔ آمریکا به شهروندان خود دربارهٔ افزایش تنش‌ها در خاورمیانه هشدار داد \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eوزارت امور خارجهٔ آمریکا با صدور هشداری جهانی از همهٔ شهروندان آمریکایی خواست در پی افزایش تنش‌ها در خاورمیانه، احتیاط بیشتری به خرج دهند.\u003cbr/\u003eدر این هشدار آمده است که وضعیت امنیتی منطقه همچنان پیچیده است و احتمال تشدید غیرمنتظره تنش‌ها وجود دارد.\u003cbr/\u003eوزارت امور خارجه ایالات متحده از شهروندان آمریکا، به‌ویژه افراد حاضر در خاورمیانه، خواست تحولات را به‌دقت دنبال کنند، توصیه‌های امنیتی سفارت‌ها و کنسولگری‌های آمریکا را رعایت کنند و احتمال اختلال در سفرها را به دلیل لغو پروازها و بسته شدن مقطعی حریم‌های هوایی، در نظر داشته باشند.\u003cbr/\u003eاین وزارتخانه همچنین هشدار داد تأسیسات دیپلماتیک و منافع آمریکا در نقاط مختلف جهان ممکن است هدف حملات گروه‌های مورد پشتیبانی  جمهوری اسلامی قرار گیرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
