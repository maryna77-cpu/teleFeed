    {
      "id": 5586,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e برقراری پروازها در فرودگاه خمینی\u003cbr/\u003e\u003cbr/\u003eگزارش‌های میدانی حاکی است پروازها از فرودگاه خمینی تهران روز پنجشنبه ۲۱ خرداد ۱۴۰۵ برقرار شده است. \u003cbr/\u003e\u003cbr/\u003eبا بالاگرفتن درگیری‌ها کلیه پروازها در فرودگاه‌های ایران متوقف شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#تهران\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%B1%D9%88%D8%AF%DA%AF%D8%A7%D9%87_%D8%AE%D9%85%DB%8C%D9%86%DB%8C\"\u003e#فرودگاه_خمینی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
