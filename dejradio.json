    {
      "id": 6402,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e فقدان پدافند و نیروی هوایی، کار جمهوری اسلامی در جنگ را بسیار سخت کرده و حکومت نمی‌تواند از زیرساخت‌های حیاتی دفاع کند.\u003cbr/\u003eدر پی قطع مکرر برق در شهرهای مختلف مدیرعامل شرکت توانیر اعلام کرد در جریان حملات اخیر آسیب‌های گسترده‌ای به زیرساخت‌های برق وارد شده و ظرفیت شبکه برق کاهش یافته است.\u003cbr/\u003eبه گفته او حدود ۴۲۰۰ مگاوات از توان شبکه برق کشور کاهش یافته و بیش از ۲ هزار نقطه از شبکه دچار آسیب شده‌اند.\u003cbr/\u003eمنابع داخلی گزارش دادند، خسارت واردشده به شبکه و تجهیزات صنعت برق از مرز ۶۰ هزار میلیارد تومان گذشته است.\u003cbr/\u003eخاموشی‌ها و قطع برق در شرایطی است که حکومت پیش از‌جنگ نیز در تابستان برای تامین برق با بحران روبه‌رو می‌شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D8%B1%D9%82\"\u003e#برق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%85%D9%88%D8%B4%DB%8C\"\u003e#خاموشی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87\"\u003e#حمله\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
