    {
      "id": 6310,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eجی‌دی ونس: اگر حملهٔ جمهوری اسلامی به کشتی‌ها ادامه یابد، نابودشان می‌کنیم \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eجی‌دی ونس، معاون رئیس‌ جمهوری آمریکا روز چهارشنبه هشدار داد اگر حملات جمهوری اسلامی به کشتی‌ها در تنگهٔ هرمز ادامه یابد، آمریکا آنها را نابود می‌کند.\u003cbr/\u003eمعاون دونالد ترامپ با اشاره به درگیری‌های تازه میان تهران و واشینگتن گفت جمهوری اسلامی با ازسرگیری حمله به کشتی‌ها، تفاهمنامهٔ اولیه را نقض کرده است.\u003cbr/\u003eونس گفت بر اساس توافقی که انجام شده، جمهوری اسلامی در ازای لغو محاصرهٔ تنگهٔ هرمز متعهد شده بود حملات به کشتی‌ها را متوقف کند.\u003cbr/\u003eاو یادآوری کرد که حکومت در ساعات پیشین بار دیگر به کشتی‌ها حمله کرده است.\u003cbr/\u003eونس گفت دونالد ترامپ گزینه‌های مختلفی را بررسی می‌کند، اما تأکید کرده که تنگهٔ هرمز باز بماند و جریان صدور نفت و گاز ادامه پیدا کند.\u003cbr/\u003eاو همچنین گفت کاهش بهای نفت و بنزین نشان می‌دهد راهبرد آمریکا در باز نگه داشتن این آبراه در حال نتیجه دادن است.\u003cbr/\u003eجی‌دی ونس در تفاهمات اخیر میان واشینگتن و تهران نقشی پررنگ داشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87\"\u003e#حمله\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
