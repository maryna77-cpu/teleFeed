    {
      "id": 6334,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e منابع نزدیک به سـ.ـپاه پاسداران از کشف یک کلاهک عمل‌نکرده متعلق به موشک کروز پنهانکار آمریکایی از نوع AGM 158B JASSM ER خبر دادند. محل دقیق کشف این کلاهک مشخص نیست.\u003cbr/\u003e\u003cbr/\u003eاین کلاهک نفوذگر که WDU 42/B نام دارد، حدود ۴۵۰ کیلوگرم وزن دارد و برای هدف قرار دادن سازه‌های بسیار مستحکم طراحی شده است؛ از جمله پناهگاه‌ها، آشیانه‌های بتنی، مراکز فرماندهی زیرزمینی و تأسیسات نظامی محافظت‌شده. این نوع کلاهک نشان می‌دهد حملات آمریکا بر اهداف سخت و زیرساخت‌های حساس جمهوری اسلامی متمرکز بوده است.\u003cbr/\u003e\u003cbr/\u003eبعد از جنگ ۴۰ روزه دستکم ۲۰ نفر از پرسنل سـ.ـپاه و ارتش در جریان خنثی‌سازی بمب‌ها و مهمات عمل‌نکرده جنگ کشته و زخمی شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D8%A7%D8%AA_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حملات_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B4%DB%B0%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۴۰روزه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
