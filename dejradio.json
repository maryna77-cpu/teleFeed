    {
      "id": 7212,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e شهاب عنایتی از پرسنل پیشین نیروی هوایی ارتش، توضیح می‌دهد که چرا در شرایط جنگی آمار افزایش ترک خدمت در میان سربازان وظیفه افزایش پیدا کرده است. \u003cbr/\u003e\u003cbr/\u003eاو به مجموعه‌ای از دلایل از جمله بی‌اعتمادی به سلسله مراتب اشاره می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AA%D8%B4\"\u003e#ارتش\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%DA%A9_%D8%AE%D8%AF%D9%85%D8%AA\"\u003e#ترک_خدمت\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B1%D8%A8%D8%A7%D8%B2%DB%8C\"\u003e#سربازی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
