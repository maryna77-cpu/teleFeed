    {
      "id": 7786,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A1.png\u0026#39;)\"\u003e\u003cb\u003e🤡\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e حامیان نظام برای نشان دادن استقامت خودشان و اینکه \u0026#34;کم نمی‌آورند\u0026#34; در برابر تحریم‌های سخت آمریکا، در تجمعات شبانه شعار سر دادند با این مضمون که هر سختی‌ را تحمل می‌کنند اما تن به تسلیم و مذاکره نمی‌دهند، از جمله اینکه \u0026#34;تو تاریکی می‌شینیم\u0026#34; و \u0026#34;مهریه کم می‌گیریم\u0026#34; و گوشت را گران می‌خریم اما سازش نمی‌کنیم!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%87%D8%B1%DB%8C%D9%87\"\u003e#مهریه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AC%D9%85%D8%B9%D8%A7%D8%AA_%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#تجمعات_حکومتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
