    {
      "id": 8133,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e فریبرز کرمی‌زند، افسر پیشین پلیس، به شهروندان توصیه می‌کند که موبایل‌ها نباید مخزن اسرار ما باشند. \u003cbr/\u003e\u003cbr/\u003eذخیره سازی عکس، فیلم و اسناد و مدارک در تلفن همراه برای مردم، آن‌هم در فضای امنیتی شهرها، خطرناک و آسیب‌زا است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D9%85%D9%86%DB%8C%D8%AA\"\u003e#امنیت\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B7%D9%84%D8%A7%D8%B9%D8%A7%D8%AA\"\u003e#اطلاعات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
