    {
      "id": 7092,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e کارزار شناسایی سرکوبگران؛\u003cbr/\u003eعادل رزاقی کادر یگان امداد ساری، از عوامل قتل‌عام خیزش دی‌ماه\u003cbr/\u003e\u003cbr/\u003eعادل رزاقی کادر یگان امداد ساری است که در جریان قتل‌عام و سرکوب معترضان در ۱۸ و ۱۸ دی‌ماه نقش داشت. \u003cbr/\u003e\u003cbr/\u003eاو به عنوان درجه‌دار با اوباش، خلافکارها و عرق‌فروش‌ها در ارتباط است و از آنها باج‌گیری می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D8%A7%D8%AF%D9%84_%D8%B1%D8%B2%D8%A7%D9%82%DB%8C\"\u003e#عادل_رزاقی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DB%8C%DB%B1%DB%B4%DB%B0%DB%B4\"\u003e#دی۱۴۰۴\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
