    {
      "id": 6336,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eردپای سپاه در سازمان‌دهی تجمعات علیه اسرائیل در بریتانیا آشکار شد\u003c/b\u003e \u003cbr/\u003e\u003cbr/\u003eسازمان ان‌جی‌او مانیتور، در گزارشی ۱۲۹ صفحه‌ای اعلام کرد \u003cbr/\u003e شبکه‌ای از سازمان‌های غیردولتی مرتبط با سپاه، تجمعات سال‌های اخیر علیه اسرائیل را در بریتانیا سازمان‌دهی کرده است.\u003cbr/\u003e بر پایهٔ این گزارش، اعتراضاتی که پس از حملهٔ تروریستی هفتم اکتبر در بریتانیا به‌ضد اسرائیل شکل گرفته، بخشی از شبکه‌ای جهانی از سازمان‌های غیردولتی است که در راستای اهداف تبلیغاتی سپاه پاسداران، جریان‌های اسلام‌گرا و ایده‌های ضدغربی فعالیت می‌کند.\u003cbr/\u003eدر این گزارش تحقیقاتی اشاره شد که درحدود ۸۰ درصد از این دست تجمعات ضداسرائیلی در بریتانیا، توسط سازمان‌های غیردولتی سازمان‌دهی شده‌ است.\u003cbr/\u003eبر اساس این گزارش، دستکم ۱۱ کارزار اصلی شکل گرفته توسط این نهادهای غیردولتی، با گروه‌ها یا افرادی مرتبط بوده‌ که با جمهوری اسلامی، سپاه پاسداران، حماس، حزب‌الله و یا اخوان‌المسلمین، پیوند یا همکاری داشتند.\u003cbr/\u003eبر پایهٔ پژوهش‌ها شماری از این سازمان‌ها از دولت بریتانیا و نیز آمریکا، بلژیک، اتحادیهٔ اروپا، ایرلند، نروژ، سوئد، سوئیس و اسکاتلند بودجه دریافت می‌کنند.\u003cbr/\u003eبنا بر این گزارش، برخی از گروه‌ها برای جذب کمک‌های مالی از منابع برشمرده، از ارزهای دیجیتال استفاده می‌کنند و بخشی از فعالیت‌های خود را بر جذب و آموزش جوانان متمرکز کرده‌اند.\u003cbr/\u003eسازمان ان‌جی‌او مانیتور، از دولت‌های غربی خواست این شبکهٔ مرتبط با سپاه و سایر نهادهای تروریستی را به‌عنوان یک تهدید امنیتی بررسی کنند.\u003cbr/\u003eسپاه پاسداران، شبه‌نظامیان حزب‌الله، حماس و جهاد اسلامی در سیاههٔ تروریستی آمریکا و اتحادیهٔ اروپا قرار دارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%A7%D9%87_%D8%AA%D8%B1%D9%88%D8%B1%DB%8C%D8%B3%D8%AA%DB%8C_%D9%BE%D8%A7%D8%B3%D8%AF%D8%A7%D8%B1%D8%A7%D9%86\"\u003e#سپاه_تروریستی_پاسداران\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%DB%8C%D9%87%D9%88%D8%AF_%D8%B3%D8%AA%DB%8C%D8%B2%DB%8C\"\u003e#یهود_ستیزی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
