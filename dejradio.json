      "id": 6866,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e \u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e دونالد ترامپ، رئیس جمهوری آمریکا روز دوشنبه ۵ امرداد، ساعاتی پیش از دیدار با بنیامین نتانیاهو، نخست وزیر اسرائیل در واشنگتن به پرسش خبرنگاران در خصوص این سفر و جنگ با جمهوری اسلامی به پرسش خبرنگاران پاسخ داد. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e  \u003ca href=\"?q=%23%D9%86%D8%AA%D8%A7%D9%86%DB%8C%D8%A7%D9%87%D9%88\"\u003e#نتانیاهو\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
