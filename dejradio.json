    {
      "id": 7360,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e الحاق دومین هواپیمای سوخت‌رسان «گیدعون» به نیروی هوایی اسرائیل\u003cbr/\u003e\u003cbr/\u003eچهارماه پس از آتش‌بس، دومین هواپیمای سوخت‌رسان و ترابری «گیدعون» به نیروی هوایی ارتش اسرائیل تحویل داده شد. \u003cbr/\u003eمراسم الحاق این هواپیما پنجشنبه ۲۹ امرداد ۱۴۰۵ در پایگاه هوایی نواتیم برگزار شد.\u003cbr/\u003e\u003cbr/\u003eالحاق این هواپیما با هدف افزایش توان عملیاتی نیروی هوایی اسرائیل در عملیات دوربُرد انجام شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AA%D8%B4_%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#ارتش_اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
