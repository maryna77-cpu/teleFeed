    {
      "id": 7521,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e سه ارتشی از پرسنل نیروی دریایی ارتش جمهوری اسلامی پس از ۶ ماه به ایران بازگشتند.  سیدمحمد مظلومی، رضا افشار و احمدرضا ذاکریان از پرسنل ناو لاوان بودند.\u003cbr/\u003e\u003cbr/\u003eآمریکا اسفند ۱۴۰۴ ناو «دنا» را که به ماموریت هند اعزام شده بود، پس از ۲ بار بی‌توجهی به هشدار نزدیک سریلانکا هدف قرار داد. ناو دیگر در ایران ماموریت «لاوان» بود که در بندر کوچی هند پهلو گرفت.\u003cbr/\u003e\u003cbr/\u003eسه نفر از پرسنل این ناو در هندوستان بودند که پس از ۶ ماه به ایران بازگشتند. برخی منابع داخلی مدعی شدند آنها «اسیر» بودند!\u003cbr/\u003eبرای هفته‌ها دست‌کم ۱۸۳ نفر از خدمه این شناورها در تاسیسات نیروی دریایی هند در کوچی اسکان داده شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AA%D8%B4\"\u003e#ارتش\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#نیروی_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
