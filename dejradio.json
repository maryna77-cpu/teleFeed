    {
      "id": 5342,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e اعتراض یک شهروند:\u003cbr/\u003eدوشکا منتظر اوناییه که از گرسنگی حرف بزنند...\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D9%88%D8%B4%DA%A9%D8%A7\"\u003e#دوشکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B1%DA%A9%D9%88%D8%A8\"\u003e#سرکوب\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
