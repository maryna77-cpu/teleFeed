    {
      "id": 6384,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e خاموشی‌های چندساعته در تهران هم‌زمان با اوج گرما\u003cbr/\u003e\u003cbr/\u003eگزارش‌های مردمی حاکی از آن است که از ظهر امروز، برق برخی مناطق تهران بدون اعلام قبلی قطع شده و شماری از مشترکان با خاموشی‌های طولانی‌مدت روبه‌رو شده‌اند.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش‌ها، در مناطقی از جمله محدوده‌های خیابان پهلوی، تخت طاووس و قائم‌مقام، قطعی برق در برخی موارد بیش از چهار ساعت ادامه داشته است.\u003cbr/\u003e\u003cbr/\u003eبه گفته شهروندان، این خاموشی‌ها از حدود ساعت ۱۱:۳۰ و هم‌زمان با افزایش دمای هوا آغاز شده و در برخی مناطق تا زمان انتشار این گزارش همچنان ادامه دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A7%D9%85%D9%88%D8%B4%DB%8C\"\u003e#خاموشی\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%B7%D8%B9%DB%8C_%D8%A8%D8%B1%D9%82\"\u003e#قطعی_برق\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D9%85%D8%A7\"\u003e#گرما\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#تهران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
