    {
      "id": 6979,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e کمبود تجهیزات دفاعی؛\u003cbr/\u003eنیسان آبی مجهز به توپ ضدهوایی برای مقابله با پهپادهای آمریکا\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌های میدانی، سـ.ـپاه پاسداران برای مقابله با حملات آمریکا، به علت کمبود تجهیزات «نیروهای مردم پایه» را بـ.ـسیج کردند. \u003cbr/\u003e\u003cbr/\u003eاین نیروها مجهز به تسلیحات فرسوده شده‌اند، از جمله ضدهوایی پشت نیسان آبی!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
