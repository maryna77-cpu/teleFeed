    {
      "id": 7657,
      "message": "\u003ctg-emoji emoji-id=\"5900170756913893630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9280.png\u0026#39;)\"\u003e\u003cb\u003e💀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5836934557550516347\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e حسین مهدویان، از خلبانان ارتش جمهوری اسلامی ایران دهم شهریور ۱۴۰۵ در جریان حملات موشکی آمریکا به جنوب ایران کشته شد.\u003cbr/\u003e\u003cbr/\u003eحکومت همچنان آمار تلفات را قطره‌چکانی اعلام می‌کند.\u003cbr/\u003e\u003cbr/\u003eطی ۴۸ ساعت حملات آمریکا دست‌کم ۲۰ نظامی کشته و ده‌ها تن دیگر زخمی شدند اما آمار سانسور می‌شود.\u003cbr/\u003e \u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D8%A7%D8%AA_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حملات_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
