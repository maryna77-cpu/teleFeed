    {
      "id": 6041,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003e لعنت به این فوتبال کثیف\u003cbr/\u003eمیلیون‌ها ایرانی که باید پر از امید و انرژی از تیم ملی فوتبال‌ حمایت می‌کردند، از عدم صعود آنها به مرحله بعدی ابراز رضایت کردند، یک حس دوگانه و کم‌سابقه.\u003cbr/\u003eسکوت و بی‌تفاوتی بازیکنان و کادر فنی تیم در مقابل قتل‌عام مردم توسط حکومت، آنان را به چهره‌هایی منفور تبدیل کرد و این عدم موفقیت در عرصه بین‌المللی، درواقع شکست دستگاه پروپاگاندای نظام به شمار می‌رود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
