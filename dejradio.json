    {
      "id": 7880,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e بر اساس گزارش منابع محلی، موشکی که شبه نظامیان حوثی مورد حمایت جمهوری جمهوری اسلامی به سمت شهرستان رَغوان در استان مأرب یمن شلیک کردند ساخت چین بود. \u003cbr/\u003e\u003cbr/\u003eاین موشک در نزدیکی اردوگاه آوارگان سقوط کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%88%D8%AB%DB%8C\"\u003e#حوثی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%DB%8C%D9%85%D9%86\"\u003e#یمن\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
