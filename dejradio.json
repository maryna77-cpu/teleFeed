    {
      "id": 6118,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس گزارش منابع محلی سـ.ـپاه پاسداران و ارتش جمهوری اسلامی به مناطقی از کردستان عراق از جمله اطراف اربیل حمله موشکی و پهپادی کردند.\u003cbr/\u003e\u003cbr/\u003eگفته شد در این حملات مقر بعضی گروه‌های مسلح هدف قرار گرفته است. گفته شد مقر حزب «آزادی» هدف قرار گرفته شده است. انفجاری مهیب در مرکز اربیل شنیده شد.\u003cbr/\u003eبعضی ساکنان محلی می‌گویند موشک‌های بالستیک به زمین برخورد کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D8%B1%D8%AF%D8%B3%D8%AA%D8%A7%D9%86_%D8%B9%D8%B1%D8%A7%D9%82\"\u003e#کردستان_عراق\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
