    {
      "id": 5695,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e نامۀ اعضای پارلمان اروپا به فیفا دربارۀ فوتبالیست‌های زندانی ایران\u003cbr/\u003e\u003cbr/\u003eچهار عضو پارلمان اروپا در نامه‌ای سرگشاده به جیانی اینفانتینو، رئیس فیفا خواستار توضیح دربارۀ وضعیت فوتبالیست‌های زندانی در ایران شدند.\u003cbr/\u003eامضاکنندگان نامه با اشاره به بازداشت، زندانی شدن و صدور احکام سنگین برای شماری از فوتبالیست‌های ایرانی، از فیفا پرسیده‌اند آیا هرگز در این راستا با فدراسیون فوتبال جمهوری اسلامی رایزنی کرده است یا نه.\u003cbr/\u003eتنظیم‌کنندگان نامه به فیفا، از اینفانتینو در مورد «میزان اطلاعات فیفا از وضعیت حقوقی و امنیتی بازیکنان بازداشتی» خواستار توضیح شدند.\u003cbr/\u003eدر این نامه به پروندۀ احسان حسینی‌پور حصارلو، فوتبالیست ۱۹ ساله‌ای که بنا بر گزارش‌ها در خطر اعدام قرار دارد، اشاره شده است.\u003cbr/\u003eاعضای پارلمان اروپا از فیفا خواستند مسئلۀ حقوق بشر را در تعاملات خود با فدراسیون فوتبال جمهوری اسلامی در مرکز توجه قرار دهد.\u003cbr/\u003eچهار عضو پارلمان اروپا تأکید کردند اعتبار «تعهدات حقوق بشری فیفا» زمانی سنجیده می‌شود که خود فوتبالیست‌ها زندانی می‌شوند یا در معرض اعدام قرار می‌گیرند.\u003cbr/\u003eنامه به فیفا به امضای هانا نویمان، بارت گروتیوس، دانیل عطارد و لوکاس فورلاس رسیده است.\u003cbr/\u003eرئیس فیفا به‌تازگی برای رفع مشکل اعضای فدراسیون و اکیپ تیم ملی فوتبال جمهوری اسلامی تلاش‌هایی بسیار انجام داده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%BE%D8%A7%D8%B1%D9%84%D9%85%D8%A7%D9%86_%D8%A7%D8%B1%D9%88%D9%BE%D8%A7\"\u003e#پارلمان_اروپا\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%DB%8C%D9%81%D8%A7\"\u003e#فیفا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
