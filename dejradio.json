    {
      "id": 7431,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e اختلال شدید جی‌پی‌اس‌ها در تهران \u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌ها اختلال در سرویس موقعیت‌یابی جهانی (GPS) روز دوشنبه دوم شهریورماه ۱۴۰۵ در تهران افزایش یافته و بسیاری از نرم‌افزارهای مسیریاب مختل شده‌اند. \u003cbr/\u003e\u003cbr/\u003eگزارش‌های میدانی نشان می‌دهد موقعیت مکانی کاربران در نقاط مختلف پایتخت با خطا همراه است. این شرایط تاکسی‌های اینترنتی را نیز در یافتن مسیر با مشکل روبرو کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B3%DB%8C%D8%B1%DB%8C%D8%A7%D8%A8%DB%8C\"\u003e#مسیریابی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#تهران\u003c/a\u003e \u003ca href=\"?q=%23GPS\"\u003e#GPS\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
