    {
      "id": 6776,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e از بازداشت تا شکنجه و قتل جاویدنام محمد کامرانی؛\u003cbr/\u003e\u003cbr/\u003eمحمد کامرانی، نوجوان ۱۸ ساله تهرانی، یکی از صدها معترضی بود که در ۱۸ تیر ۱۳۸۸ برای اعتراض به نتایج انتخابات ریاست‌جمهوری و گرامیداشت سالگرد کوی دانشگاه به خیابان آمد؛ اما بازداشت و به کهریزک منتقل شد.\u003cbr/\u003e\u003cbr/\u003eجاویدنام کامرانی، یکی از جوان‌ترین قربانیان بازداشتگاه کهریزک بود که بر اثر چندین روز متوالی شکنجه و جراحات وارده شدید، عفونت زخمها و ضعف جسمانی، پس از انتقال به بیمارستان لقمان تهران، جان خود را از دست داد.\u003cbr/\u003e\u003cbr/\u003eمستند «کهریزک؛ فراموش‌شدگان تابستان ۸۸» با روایت مسعود علیزاده، از جان‌به‌دربردگان بازداشتگاه کهریزک، و ارائه مستندات، به جزئیات بازداشت، شکنجه و جان‌باختن معترضان بازداشت‌شده و مقامات حکومتی درگیر در پرونده کهریزک می‌پردازد.\u003cbr/\u003e\u003cbr/\u003e*کارگردان: ساناز بهزادی\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AD%D9%85%D8%AF_%DA%A9%D8%A7%D9%85%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#محمد_کامرانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%A7%D8%B2%D8%AF%D8%A7%D8%B4%D8%AA%DA%AF%D8%A7%D9%87_%DA%A9%D9%87%D8%B1%DB%8C%D8%B2%DA%A9\"\u003e#بازداشتگاه_کهریزک\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D9%87%D8%B1%DB%8C%D8%B2%DA%A9\"\u003e#کهریزک\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
