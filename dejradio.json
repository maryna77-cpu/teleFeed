    {
      "id": 7532,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e در شرایط وخیم اقتصادی، کسبه با انواع و اقسام مشکل روبه‌رویند که یکی از آنها بی‌برقی است. \u003cbr/\u003e\u003cbr/\u003eیکی از کسبه می‌گوید برای تجمعات شبانه حکومتی و حسینیه‌ها و مساجد برق هست برای کاسب که باید چراغ مغازه‌اش روشن باشد برق نیست!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%82%D8%B7%D8%B9%DB%8C_%D8%A8%D8%B1%D9%82\"\u003e#قطعی_برق\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%A7%D8%B2%D8%A7%D8%B1\"\u003e#بازار\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
