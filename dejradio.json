      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e بر اساس گزارش‌ شهروندان، شمار زیادی از شعب بانک‌ها در ایران بسته شدند. \u003cbr/\u003e\u003cbr/\u003eپشت شیشه این شعب نوشته‌شده که با شعبه دیگری تلفیق شده‌اند. \u003cbr/\u003e\u003cbr/\u003eبنا بر گزارش‌های مردمی، بسیاری از شعب حتی برای کمترین پرداخت‌ها اسکناس کافی ندارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D8%A7%D9%86%DA%A9\"\u003e#بانک\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%82%D9%88%D8%B7_%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%DB%8C\"\u003e#سقوط_اقتصادی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%B2%D8%B4_%D9%BE%D9%88%D9%84\"\u003e#ارزش_پول\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
