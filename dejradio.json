    {
      "id": 7038,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e فرودگاه مهرآباد؛ قبرستان هواپیماهای اوراق\u003cbr/\u003e\u003cbr/\u003eیک شهروند ساکن شهرک اکباتان با انتشار ویدیویی از گورستان هواپیماهای مسافربری در فرودگاه مهرآباد می‌گوید هواپیماها خراب و اوراق و همه به خدا نزدیک‌تر می‌شوند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%BE%D8%B1%D9%88%D8%A7%D8%B2\"\u003e#پرواز\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%B1%D9%88%D8%AF%DA%AF%D8%A7%D9%87_%D9%85%D9%87%D8%B1%D8%A2%D8%A8%D8%A7%D8%AF\"\u003e#فرودگاه_مهرآباد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
