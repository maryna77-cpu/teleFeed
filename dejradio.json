    {
      "id": 6581,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e فریبرز کرمی‌زند:\u003cbr/\u003eجیره‌خواران ادای میهن‌پرستان را در می‌آورند\u003cbr/\u003e\u003cbr/\u003eفریبرز کرمی‌زند افسر پیشین پلیس، با اشاره به سال‌ها سکوت مزدوران و میره‌خواران حکومت در قبال مشکلات و گرفتاری‌های مردم، می‌گوید حالا آنها ادای میهن‌پرستان را درمی‌‌آوردند و دلسوز ملت از جمله صیادان و اهالی جنوب ایران شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
