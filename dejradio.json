    {
      "id": 5399,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e مدیرعامل روس‌نفت برندگان انسداد هرمز را شرکت‌های آمریکایی عنوان کرد\u003cbr/\u003e\u003cbr/\u003eایگور سچین، مدیرعامل روس‌نفت، گفت بسته شدن تنگۀ هرمز در نهایت به سود شرکت‌های انرژی آمریکا تمام شده است.\u003cbr/\u003eسچین همچنین گفت ائتلاف اوپک‌پلاس پس از خروج امارات، بخشی از نفوذ خود را در بازار جهانی نفت از دست داده است.\u003cbr/\u003eاو از سویی مدعی شد اختلال در آبراه هرمز می‌تواند مسیرهای مهم دیگر از جمله باب‌المندب، مالاکا و جبل‌الطارق را نیز تحت تاثیر قرار دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D9%88%D8%B3%DB%8C%D9%87\"\u003e#روسیه\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
