    {
      "id": 8313,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9FA1.png\u0026#39;)\"\u003e\u003cb\u003e🟡\u003c/b\u003e\u003c/i\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e براساس ویدیوهایی که ۱۱ مهرماه ۱۴۰۵ در شبکه‌های اجتماعی منتشر شد، برجک مشهور زندان «رجایی‌شهر کرج»، \u003ca href=\"https://www.instagram.com/explore/tags/%D8%B2%D9%86%D8%AF%D8%A7%D9%86_%DA%AF%D9%88%D9%87%D8%B1%D8%AF%D8%B4%D8%AA/\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eزندان گوهردشت\u003c/a\u003e تخریب شد.\u003cbr/\u003e\u003cbr/\u003eاز این زندان نزدیک پنج دهه مدام گزارش‌های متعدد درباره نقض حقوق بشر، بدرفتاری و شنکنجه زندانیان و اعدام محرومیت از رسیدگی پزشکی منتشر شد.\u003cbr/\u003eنام زندان گوهردشت به‌ویژه با اعدام گسترده زندانیان سیاسی در تابستان ۱۳۶۷ گره خورده است.\u003cbr/\u003eاین زندان بعدها نیز به دلیل نقض جدی حقوق بشر توسط آمریکا و اتحادیه اروپا تحریم شد و سرانجام در مرداد ۱۴۰۲، پس از انتقال زندانیان به سایر زندان‌ها، رسماً تعطیل شد.\u003cbr/\u003eبسیاری تخریب این زندان را پاک کردن آثار جنایت از سوی حکومت میدانند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B2%D9%86%D8%AF%D8%A7%D9%86_%DA%AF%D9%88%D9%87%D8%B1%D8%AF%D8%B4%D8%AA\"\u003e#زندان_گوهردشت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
