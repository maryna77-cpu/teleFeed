    {
      "id": 5095,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اتحادیۀ اروپا اعلام کرد برای امنیت تنگۀ هرمز کشتی‌های بیشتری اعزام می‌کند\u003cbr/\u003e\u003cbr/\u003eکایا کالاس، مسئول سیاست خارجی اتحادیۀ اروپا گفت این اتحادیه برای تأمین امنیت دریانوردی در تنگه هرمز، شمار بیشتری از کشتی‌ها را اعزام می‌کند.\u003cbr/\u003eاو گفت این اقدام در قالب گسترش مأموریت دریایی کنونی اتحادیۀ اروپا انجام می‌شود.\u003cbr/\u003eبه گفتۀ کالاس در برنامه‌های تازه ممکن است استفاده از شناورهای تخصصی از جمله کشتی‌های مین‌روب هم گنجانده شود.\u003cbr/\u003e اتحادیۀ اروپا در جریان مأموریت دریایی خود اکنون با سه کشتی در منطقه، از مسیرهای دریایی در برابر حملات محافظت می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D9%88%D9%BE%D8%A7\"\u003e#اروپا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
