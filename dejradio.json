    {
      "id": 7671,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e گروهی از ارتشی‌های متقاضی مسکن مهر ارتش در پردیس کرمانشاه، ۱۱ شهریور ۱۴۰۴ دست به اعتراض زدند. آنها می‌گویند از ۱۵ تا ۱۷ سال پیش منتظرند خانه‌دار شوند اما نشدند.\u003cbr/\u003e\u003cbr/\u003eارتشی‌ها به همراه اعضای خانواده‌شان در مقابل تعاونی لشکر ۸۱ زرهی دست به اعتراض زدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B3%DA%A9%D9%86_%D9%85%D9%87%D8%B1\"\u003e#مسکن_مهر\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AA%D8%B4\"\u003e#ارتش\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D8%B1%D9%85%D8%A7%D9%86%D8%B4%D8%A7%D9%87\"\u003e#کرمانشاه\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
