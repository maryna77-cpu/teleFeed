    {
      "id": 7292,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e بلومبرگ: \u003cbr/\u003eانتقال پنهانی نفت ایران از تنگه هرمز با حداکثر ظرفیت ادامه دارد\u003cbr/\u003e\u003cbr/\u003eبلومبرگ به نقل از منابع آگاه گزارش داد تولیدکنندگان نفت خاورمیانه با وجود حملات اخیر به شناورها، انتقال حجم بالای نفت خام از خلیج فارس را ادامه می‌دهند. \u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، نفت به‌صورت پنهانی از تنگه هرمز عبور داده شده و سپس در دریای عمان به نفتکش‌های دیگر منتقل می‌شود؛ عملیاتی که همچنان با حداکثر ظرفیت جریان دارد و به مهار قیمت نفت و کاهش نگرانی‌ها از جهش تورمی انرژی کمک کرده است. \u003cbr/\u003e\u003cbr/\u003eداده‌های ماهواره‌ای اتحادیه اروپا نیز نشان می‌دهد حدود ۱۵۰ شناور در خارج از تنگه هرمز و در امتداد سواحل عمان مستقر هستند؛ در حالی که این رقم در دی‌ماه حدود ۴۰ فروند بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
