    {
      "id": 6477,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e تخریب مرکز دریابانی فراجا در بوشهر پس از حملات نظامی روز سه‌شنبه \u003cbr/\u003e\u003cbr/\u003eتصاویر منتشرشده در شبکه‌های اجتماعی از محله «بهمنی» بوشهر، تخریب گسترده مرکز آماد و پشتیبانی دریابانی نیروی انتظامی (فراجا) را در جریان حملات نظامی ظهر امروز (سه‌شنبه ۲۳ تیر ۱۴۰۵) نشان می‌دهد.\u003cbr/\u003e\u003cbr/\u003eمعاون سیاسی و امنیتی استانداری بوشهر رسما تایید کرد که ظهر روز سه‌شنبه ۲۳ تیر ۱۴۰۵، چهار نقطه در این منطقه هدف حمله قرار گرفته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%B1%DB%8C%D8%A7%D8%A8%D8%A7%D9%86%DB%8C_%D9%81%D8%B1%D8%A7%D8%AC%D8%A7\"\u003e#دریابانی_فراجا\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D9%88%D8%B4%D9%87%D8%B1\"\u003e#بوشهر\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
