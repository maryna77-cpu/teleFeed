    {
      "id": 7276,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس گزارش منابع میدانی بخش عمده بنزین صرف ذخیره‌سازی برای نیروهای مسلح می‌شود آن‌هم در شرایطی که به‌نظر می‌رسد تنش‌ها از سر گرفته شود.\u003cbr/\u003e\u003cbr/\u003eرسانه‌های داخلی با انتقاد از وضعیت بحرانی بنزین نوشته‌اند، خبری از نقشه راه منسجم برای حل بحران بنزین در دولت نیست!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D9%85%D8%A8%D9%88%D8%AF_%D8%B3%D9%88%D8%AE%D8%AA\"\u003e#کمبود_سوخت\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D9%86%D8%B2%DB%8C%D9%86\"\u003e#بنزین\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
