    {
      "id": 6015,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eدر توافق ۱۴ بندی لبنان و اسرائیل بر خلع سلاح حزب‌الله تأکید شد \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبر پایۀ گزارش‌ها در توافق مقدماتی لبنان و اسرائیل که چهارده بند را دربردارد، بر خلع سلاح گروه‌های مسلح غیردولتی و استقرار کامل ارتش لبنان در سراسر کشور تأکید شده است.\u003cbr/\u003eبر اساس این توافق، مسئولیت انحصاری امنیت و تصمیم‌گیری دربارۀ جنگ و صلح بر عهده دولت لبنان قرار می‌گیرد.\u003cbr/\u003eحزب‌الله لبنان که توسط تهران پشتیبانی می‌شود و در سیاهۀ تروریستی آمریکا قرار دارد، تاکنون نقشی پررنگ را در ایجاد تنش در منطقه و تضعیف دولت لبنان ایفا می‌کرد.\u003cbr/\u003eدر این توافقنامه همچنین بر حق دفاع اسرائیل از کشور خود در برابر حملات حزب‌الله تأکید شده است.\u003cbr/\u003eدر توافقنامۀ سه‌جانبه که به امضای مقامات اسرائیل، آمریکا و لبنان رسید، همچنین تشکیل کارگروه‌های مشترک برای تدوین توافق جامع صلح پیش‌بینی شده است.\u003cbr/\u003eبنا بر گزارش‌ها قرار است تا زمان خلع سلاح کامل حزب‌الله و رفع تهدیدها، حضور ارتش اسرائیل در منطقۀ امنیتی حائل در لبنان، ادامه داشته باشد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
