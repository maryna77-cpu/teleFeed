    {
      "id": 7159,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e اعتراض یک جانباز شیمیایی به مسئولان حکومت\u003cbr/\u003e\u003cbr/\u003eیک جانباز شیمیایی جنگ ایران و عراق که از روی ناچاری برای معاش مجبور به رانندگی در تاکسی است، با اشاره به تاول‌‌های شدید پوستی خود خطاب به مسئولان نظام می‌گوید شما به فکر آقازاده‌هایی هستید که در آن طرف دنیا یک دلار در کاباره‌ها پول کم نیاورند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D8%A7%D9%86%D8%A8%D8%A7%D8%B2\"\u003e#جانباز\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF_%D8%B9%D8%B1%D8%A7%D9%82\"\u003e#جنگ_عراق\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
