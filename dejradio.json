    {
      "id": 7427,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اسدالله نصر اصفهانی، وزیر کشور در دوران شاهنشاهی پهلوی درگذشت\u003cbr/\u003e\u003cbr/\u003eدکتر اسدالله نصر اصفهانی، چهره ملی‌گرا و وزیر ایران‌دوست‌ دوران شاهنشاهی، در یکصد سالگی درگذشت.\u003cbr/\u003e\u003cbr/\u003eاسد‌الله نصر اصفهانی، در دوران شاهنشاهی آریامهر، علاوه بر وزارت کشور در کابینه جمشید آموزگار، به عنوان استاندار فارس و کرمان نیز خدمت کرده بود.\u003cbr/\u003e\u003cbr/\u003eدکتر اسدلله نصر، علاوه بر تحصیل در رشته حقوق، به درجۀ سرهنگی رسید و آخرین مقام او در شهربانی کشور، ریاست اداره طرح و برنامه‌ریزی این نهاد بود.\u003cbr/\u003e\u003cbr/\u003eاسدالله نصر، زاده ۲۴۸۵ شاهنشاهی در اصفهان، مدتی نیز در مقام ریاست دانشگاه پلیس، خدمت کرده بود.\u003cbr/\u003e\u003cbr/\u003eبه گفته نزدیکان اسدالله نصر اصفهانی، او در دوران پس از انقلاب، همه سال‌های عمر خود را به مبارزه با حکومت جمهوری اسلامی و تلاش برای ایجاد هماهنگی میان نیروهای پادشاهی‌خواه و ملی‌گرا اختصاص داده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%AF%D8%A7%D9%84%D9%84%D9%87_%D9%86%D8%B5%D8%B1_%D8%A7%D8%B5%D9%81%D9%87%D8%A7%D9%86%DB%8C\"\u003e#اسدالله_نصر_اصفهانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D9%86%D8%B4%D8%A7%D9%87%DB%8C_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهنشاهی_پهلوی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
