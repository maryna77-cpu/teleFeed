    {
      "id": 6989,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5794185541167618586\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2989D.png\u0026#39;)\"\u003e\u003cb\u003e☝️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://truthsocial.com/@realDonaldTrump/117021589110117563\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eترامپ در حال نابودکردن ارزش پول جمهوری اسلامی است\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ با انتشار نموداری در شبکۀ اجتماعی تروث سوشال،به سقوط ارزش پول جمهوری اسلامی و افزایش شدید نرخ دلار اشاره کرد.\u003cbr/\u003eبر اساس نمودار منتشرشده،قیمت هر دلار آمریکا از حدود ۹۰هزار تومان در ژانویۀ ۲۰۲۵ به حدود ۱۹۰هزار تومان در ژوئیۀ ۲۰۲۶ افزایش یافته است.\u003cbr/\u003eترامپ در این پست همچنین نوشت جمهوری اسلامی با تورمی گسترده روبه‌رو شده است.\u003cbr/\u003eداده‌های درج‌شده در نمودار نشان می‌دهد نرخ دلار در این بازۀ زمانی بیش از دو برابر شده و ارزش ریال در برابر پول آمریکا به‌شدت کاهش یافته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D9%84%D8%A7%D8%B1\"\u003e#دلار\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF\"\u003e#اقتصاد\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#ایران\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
