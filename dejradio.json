    {
      "id": 6994,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e برلین؛ همایش اعتراضی روبه‌روی فروشگاه لویی‌ویتون \u003cbr/\u003e\u003cbr/\u003eشماری از حامیان حقوق حیوانات روز شنبه دهم امرداد ۱۴۰۵ در مقابل شعبه فروشگاه «لویی‌ویتون» در برلین دست به گردهمایی زدند. آنها به استفاده از پوست حیوانات در محصولات این برند اعتراض داشتند.\u003cbr/\u003e\u003cbr/\u003eلویی‌ویتون یک شرکت کالای لوکس و خانه مد فرانسوی است که در سال ۱۸۵۴ میلادی توسط لویی ویتون در پاریس تاسیس شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%84%D9%88%DB%8C%DB%8C_%D9%88%DB%8C%D8%AA%D9%88%D9%86\"\u003e#لویی_ویتون\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%82%D9%88%D9%82_%D8%AD%DB%8C%D9%88%D8%A7%D9%86%D8%A7%D8%AA\"\u003e#حقوق_حیوانات\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B1%D9%84%DB%8C%D9%86\"\u003e#برلین\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
