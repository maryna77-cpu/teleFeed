    {
      "id": 6197,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e سرنوشت نامشخص ۲۵ ارتشی مستقر در سایت پدافند فُردو\u003cbr/\u003eدفن یونیفرم سرهنگ مرتضی بهرامی، مزار یادبود \u003cbr/\u003e\u003cbr/\u003eدر جریان جنگ ۱۲ روزه [۲۳ خرداد تا سوم تیرماه ۱۴۰۴] نیروگاه اتمی فردو و مقرهای پدافندی و نظامی اطراف آن با بمب‌های سنگین هدف قرار گرفت. در این حملات تعداد زیادی از نظامی‌ها کشته و ناپدید شدند. از آن زمان تاکنون گروهی ۲۵ نفره از پرسنل پدافند ارتش در این حملات ناپدید شدند و هیچ اثری از آنها پیدا نشد و حکومت نیز پاسخ درستی به خانواده‌های آنها نداده است.\u003cbr/\u003e\u003cbr/\u003eمنابع غیررسمی گزارش دادند خانواده سرهنگ دوم مرتضی بهرامی، جانشین فرماندهی پدافند فردو، با دفن یونیفرم او و ایجاد یک مزار یادبود برای او موافقت کرده‌اند.\u003cbr/\u003e\u003cbr/\u003eده‌ها نظامی طی دو جنگ ۱۲ و ۴۰ روزه ناپدید یا مفقودالاثر هستند اما حکومت آمار دقیق آن را اعلام نمی‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B1%DB%B2%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۱۲روزه\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B1%D8%AA%D8%B6%DB%8C_%D8%A8%D9%87%D8%B1%D8%A7%D9%85%DB%8C\"\u003e#مرتضی_بهرامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
