    {
      "id": 7601,
      "message": "\u003ctg-emoji emoji-id=\"5900170756913893630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9280.png\u0026#39;)\"\u003e\u003cb\u003e💀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5836934557550516347\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e منابع غیررسمی، دوشنبه نهم شهریور ۱۴۰۵ گزارش دادند که پاسدار حجت‌الاسلام مسلم امیری مسئول نمایندگی ولی‌فقیه در گروه مهندسی رزمی ۴۵ جوادالائمه نیروی زمینی سـ.ـپاه در هنگام ماموریت کشته شده است.\u003cbr/\u003e\u003cbr/\u003eمقر این سـ.ـپاه استان گلستان است. علت مرگ این آخوند به طور دقیق پیدا نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A2%D8%AE%D9%88%D9%86%D8%AF\"\u003e#آخوند\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D9%84%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#گلستان\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
