    {
      "id": 7434,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بحران سوخت در شرایط جنگی؛\u003cbr/\u003eافزایش ذخیره‌سازی گازوئیل و بنزین توسط نیروهای مسلح\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش منابع میدانی، نیروهای مسلح از جمله ارتش، سـ.ـپاه و نیروی انتظامی اقدام به افزایش ذخیره‌سازی گازوئیل و بنزین کرده‌اند. این اقدام در شرایطی صورت می‌گیرد که با شکست مذاکرات میان جمهوری اسلامی و آمریکا و محاصره دریایی ایران، احتمال وقوع جنگ دوباره زیاد شده است.\u003cbr/\u003e\u003cbr/\u003eبا ادامه تحریم‌ها واردات سوخت به ایران محدود شده است و تولید داخلی کفاف نمی‌دهد.\u003cbr/\u003e\u003cbr/\u003eکمبود گازوئیل فعالیت برخی کارخانه‌ها و صنایع را مختل کرده است. کمبود سوخت در بعضی از استان‌ها بیشتر است.\u003cbr/\u003e\u003cbr/\u003eرئیس اتاق اصناف مرکز فارس می‌گوید، «تداوم مشکلات موجود در تأمین گازوئیل می‌تواند موجب اختلال در فعالیت واحد‌های صنفی و اقتصادی و همچنین افزایش هزینه‌های فعالیت و حمل‌ونقل شود.»\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D9%85%D8%A8%D9%88%D8%AF_%D8%A8%D9%86%D8%B2%DB%8C%D9%86\"\u003e#کمبود_بنزین\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D9%86%D8%B2%DB%8C%D9%86\"\u003e#بنزین\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
