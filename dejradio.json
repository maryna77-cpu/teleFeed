    {
      "id": 6828,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e \u003cb\u003eقاهره؛ ۴۵ سال میعادگاه ایرانیان وفادار به شاهنشاه فقید ایران زمین\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدر آستانه مراسم سالگرد درگذشت شاهنشاه فقید ایران، محمدرضا شاه پهلوی، با داریوش شفا، رئیس دفتر شهبانو فرح پهلوی، درباره تصمیم دولت مصر برای محدود کردن مراسم امسال به اعضای خاندان پهلوی به دلایل امنیتی و نیز اهمیت حفظ میراث دوستی ایران و مصر گفت‌وگو کرده‌ایم. در این گفت‌وگو، نقش تاریخی رئیس‌جمهور انور سادات، پیام شهبانو فرح پهلوی درباره قدردانی از ملت و دولت مصر، و مسئولیت ایرانیان در پاسداری از این سرمایه ارزشمند برای آینده روابط دو کشور بررسی می‌شود؛ میراثی که فراتر از سیاست، بر پایه وفاداری، احترام و حافظه تاریخی دو ملت است.\u003cbr/\u003e\u003cbr/\u003e  \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D9%86%D8%B4%D8%A7%D9%87_%D8%A2%D8%B1%DB%8C%D8%A7%D9%85%D9%87%D8%B1\"\u003e#شاهنشاه_آریامهر\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%87%D8%A8%D8%A7%D9%86%D9%88_%D9%81%D8%B1%D8%AD_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شهبانو_فرح_پهلوی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%AF%D9%81%D8%AA%DA%AF%D9%88\"\u003e#گفتگو\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://youtu.be/Fqtp_mGmsjQ\" target=\"_blank\" rel=\"noopener\"\u003ehttps://youtu.be/Fqtp_mGmsjQ\u003c/a\u003e",
