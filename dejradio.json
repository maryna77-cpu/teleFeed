    {
      "id": 7279,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e حقوق یک سرباز وظیفه آن‌هم در شرایط جنگی ماهانه بین ۵/۵ تا ۷ میلیون تومان است. \u003cbr/\u003e\u003cbr/\u003eاین حقوق در نهایت خرج رفت و آمد آنها به پادگان است و نه بیشتر. در شرایطی که تورم کمر اقشار مختلف جامعه را شکسته است. \u003cbr/\u003e\u003cbr/\u003eبه بیان دیگر، حکومت زیر بمباران از سربازها بیگاری می‌کشد!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D8%B1%D8%A8%D8%A7%D8%B2_%D9%88%D8%B8%DB%8C%D9%81%D9%87\"\u003e#سرباز_وظیفه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
