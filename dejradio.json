    {
      "id": 6372,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eتصاویر ماهواره‌ای نشانگر ازسرگیری فعالیت پیرامون سایت‌های هسته‌ای و موشکی جمهوری اسلامی است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eسی‌ان‌ان گزارش داد بر اساس تصاویر تازۀ ماهواره‌ای، نشانه‌هایی از فعالیت در اطراف چند تأسیسات هسته‌ای و همچنین انبارهای موشکی در تبریز و کرمانشاه به‌دست آمده است.\u003cbr/\u003eبنا بر این گزارش، جمهوری اسلامی در حالیکه وانمود می‌کرد به یادداشت تفاهم با آمریکا پایبند است، به تعمیرات در مرکز طالقان ۲ در پارچین ادامه داده است.\u003cbr/\u003eاز سویی موسسه علوم و امنیت بین‌الملل نیز گزارش داد که جمهوری اسلامی تعمیرات وساخت‌وساز را پیرامون یک مجتمع هسته‌ای زیرزمینی در کوه‌های زاگرس پی گرفته است.\u003cbr/\u003eارزیابی‌ها نشان می‌دهد فعالیت‌‌های انجام شده در تأسیسات هسته‌ای، با مفاد تفاهمنامۀ تهران و واشینگتن دربارۀ حفظ وضعیت سایت‌های هسته‌ای، مغایر است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D9%87_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#برنامه_اتمی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
