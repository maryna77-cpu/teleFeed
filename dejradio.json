    {
      "id": 7062,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e استقرار ده‌ها فروند هواپیمای ترابری و سوخت‌رسان آمریکا در فرودگاه‌های اسرائیل\u003cbr/\u003e\u003cbr/\u003eبیش از ۴۰ فروند هواپیمای سوخت‌رسان KC-135 و KC-46 آمریکایی در فرودگاه رامون اسرائیل مستقر شده‌اند که آماری بی‌سابقه است.\u003cbr/\u003e\u003cbr/\u003eهمچنین ده‌ها فروند دیگر از هواپیماهای سوخت‌رسان و ترابری آمریکایی در فرودگاه بن‌گوریون، حیفا و دیگر نقاط مستقر شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%B2%D9%85%DB%8C%D9%86%DB%8C\"\u003e#حمله_زمینی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
