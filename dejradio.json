      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e دیگه خانم‌ها هم تا کمر خم میشن تو سطل زباله!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B2%D8%A8%D8%A7%D9%84%D9%87_%DA%AF%D8%B1%D8%AF%DB%8C\"\u003e#زباله_گردی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
