    {
      "id": 5623,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e ادعای نخست‌وزیر پاکستان: متن نهایی توافق تهران و آمریکا مورد پذیرش طرفین قرار گرفته است\u003cbr/\u003e\u003cbr/\u003eشهباز شریف، نخست‌وزیر پاکستان، اعلام کرد متن نهایی توافق میان جمهوری اسلامی و آمریکا مورد پذیرش دو طرف قرار گرفته است.\u003cbr/\u003eاو گفت پاکستان اکنون با تهران و واشینگتن برای نهایی کردن مراحل پایانی توافق همکاری می‌کند و صلح هیچ‌گاه تا این اندازه نزدیک نبوده است.\u003cbr/\u003eشریف همچنین از آنچه کارزار انتشار اطلاعات نادرست برای تخریب روند توافق خواند انتقاد کرد.\u003cbr/\u003eپاکستان در ماه‌های اخیر نقش اصلی میانجی‌گری میان جمهوری اسلامی و آمریکا را بر عهده داشته و میزبان بخشی از مذاکرات دو طرف بوده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%A7%DA%A9%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#پاکستان\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
