    {
      "id": 7660,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5784961806841680777\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87BAF09F87B8.png\u0026#39;)\"\u003e\u003cb\u003e🇺🇸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eترامپ: مدعیان کمبود مهمات ترجیح می‌دهند آمریکا جنگ را ببازد تا من پیروز نشوم\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ،رئیس‌جمهوری آمریکا،در دو پیام پیاپی در تروث‌سوشال،گزارش‌ها درباره کمبود مهمات در جریان عملیات نظامی علیه جمهوری اسلامی را رد کرد و رسانه‌ها و افرادی را که چنین ادعایی را تکرار می‌کنند،«خائن» خواند.\u003cbr/\u003eترامپ نوشت این افراد ترجیح می‌دهند آمریکا در جنگی که به گفته او «به‌آسانی در حال پیروزی در آن است» شکست بخورد،تا اینکه پیروزی او را ببینند. وی تأکید کرد ادعای کمبود مهمات «صددرصد نادرست» است و آمریکا ذخایری تقریبا نامحدود از مهمات رده متوسط و پیشرفته در اختیار دارد.\u003cbr/\u003eرئیس‌جمهوری آمریکا همچنین گفت تولید مهمات به سطحی بی‌سابقه رسیده و دولت او برای هرگونه وضعیت احتمالی در حال ذخیره‌سازی تسلیحات است. به گفته ترامپ،میزان مهماتی که دولت بایدن به‌رایگان در اختیار اوکراین و ناتو قرار داد،بسیار بیشتر از مهمات مصرف‌شده در عملیات ایران بوده و دولت او قصد دارد هزینه این کمک‌ها را از کشورهای اروپایی مطالبه کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
