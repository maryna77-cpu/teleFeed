    {
      "id": 7270,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e گوتنبرگ؛ رالی موتورسواران میهن‌دوست با پرچم شیرخورشید ایران، روز شنبه ۲۴ مرداد ۱۴۰۵در حمایت از خیزش ملی و شاهزاده رضا پهلوی\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D9%85%D8%A8%D8%B3%D8%AA%DA%AF%DB%8C\"\u003e#همبستگی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
