    {
      "id": 5564,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  واشینگتن شبکهٔ چینی تأمین سلاح برای سپاه را هدف گرفت\u003cbr/\u003e\u003cbr/\u003eوزارت خزانه‌داری آمریکا ۱۱ فرد و شرکت در چین و هنگ‌کنگ را به اتهام همکاری در تأمین سلاح و تجهیزات برای سپاه پاسداران و وزارت دفاع جمهوری اسلامی تحریم کرد.\u003cbr/\u003eواشینگتن اعلام‌‌ کرد این شبکه در انتقال پول و خرید تجهیزات نظامی برای جمهوری اسلامی نقش داشت.\u003cbr/\u003eبه گفتهٔ وزارت خزانه‌داری آمریکا، این تحریم‌ها بخشی از کارزار فشار اقتصادی علیه حکومت جمهوری اسلامی است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%DA%86%DB%8C%D9%86\"\u003e#چین\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%BE%D8%A7%D9%87_%D8%AA%D8%B1%D9%88%D8%B1%DB%8C%D8%B3%D8%AA%DB%8C_%D9%BE%D8%A7%D8%B3%D8%AF%D8%A7%D8%B1%D8%A7%D9%86\"\u003e#سپاه_تروریستی_پاسداران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
