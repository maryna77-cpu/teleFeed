    {
      "id": 5372,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e جمهوری آذربایجان خبر حضور نظامیان اسرائیلی در خاک خود را رد کرد\u003cbr/\u003e\u003cbr/\u003eوزارت امور خارجهٔ جمهوری آذربایجان گزارش شبکهٔ سی‌ان‌ان درمورد حضور نیروهای اسرائیلی در خاک این کشور را رد کرد.\u003cbr/\u003eآیخان حاجی‌زاده، سخنگوی وزارت خارجهٔ جمهوری آذربایجان، این گزارش را «بی‌بنیاد و گمراه‌کننده» خواند.\u003cbr/\u003eسی‌ان‌ان پیش‌تر به نقل از منابع ناشناس گزارش داده بود اسرائیل در جریان جنگ با جمهوری اسلامی، نیروهای ویژه و اطلاعاتی خود را به جمهوری آذربایجان اعزام کرده است.\u003cbr/\u003eسخنگوی دستگاه دیپلماسی جمهوری آذربایجان گفت باکو هرگز اجازهٔ استفاده از خاک خود علیه کشورهای دیگر را نداده و نمی‌دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%B0%D8%B1%D8%A8%D8%A7%DB%8C%D8%AC%D8%A7%D9%86\"\u003e#آذربایجان\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
