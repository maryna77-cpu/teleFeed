      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بامداد پنجشنبه ۲۱ خرداد ۱۴۰۵ حملات هوایی آمریکا به پایگاه‌های سـ.ـپاه و ارتش آغاز شد. \u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ تهدید کرده بود امروز سخت‌تر به ایران حمله می‌کنیم.\u003cbr/\u003eصدای چندین انفجار در جنوب ایران از جمله قشم، سیریک و بندرعباس شنیده شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D8%A7%D8%AA_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حملات_هدفمند\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
