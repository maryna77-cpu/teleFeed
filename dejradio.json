    {
      "id": 7536,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e میراث سیاسی و ملی دکتر اسدالله نصر اصفهانی؛\u003cbr/\u003e\u003cbr/\u003eگزارش: ایمان انصاری\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%84%DB%8C_%DA%AF%D8%B1%D8%A7%DB%8C%DB%8C\"\u003e#ملی_گرایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#ایران\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%AF%D8%A7%D9%84%D9%84%D9%87_%D9%86%D8%B5%D8%B1_%D8%A7%D8%B5%D9%81%D9%87%D8%A7%D9%86%DB%8C\"\u003e#اسدالله_نصر_اصفهانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
