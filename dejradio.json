    {
      "id": 7530,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A1.png\u0026#39;)\"\u003e\u003cb\u003e🤡\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e در تجمع شبانه حامیان نظام در فلکه دوم فردیس، شماری مکتبی نوپا شعار دادند: زنی که حجاب نداره، مردش غیرت نداره!\u003cbr/\u003e\u003cbr/\u003eاین تجمعات دقیقا اهرم تبلیغاتی نظام و تاکتیکی برای پوشش ایست‌های بازرسی با سپر انسانی شده است که همزمان حکومت و سازمان‌های تبلیغاتی از آنها برای ترویج اسلام و خشونت بهره‌برداری، و کینه و شکاف بین مردم را بیشتر می‌کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%B1_%D8%A7%D9%86%D8%B3%D8%A7%D9%86%DB%8C\"\u003e#سپر_انسانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AC%D9%85%D8%B9%D8%A7%D8%AA_%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#تجمعات_حکومتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B3%D8%AA_%D8%A8%D8%A7%D8%B2%D8%B1%D8%B3%DB%8C\"\u003e#ایست_بازرسی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
