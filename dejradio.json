    {
      "id": 6785,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e بر اساس گزارش‌هایی که دژ دریافت کرده است، حکومت برای جبران کمبود نیرو در مناطق درگیر و حساس اقدام به تسلیح نیروهایی ولایتمدار با عنوان «مردم پایه» کرده است. \u003cbr/\u003e\u003cbr/\u003eدر یکی از این موارد در نیمه جنوبی کشور به علت کمبود امکانات توپ ضدهوایی را برای هدفگیری پهپادها و جنگنده‌های آمریکایی روی نیسان آبی قرار دادند.\u003cbr/\u003e\u003cbr/\u003eنیروهای «مردم پایه» عموما بـ.ـسیجی‌ها و مذهبیون یک شهر یا روستا هستند که در ازای مبالغ اندک به میدان نبرد منتقل می‌شوند و آموزش چندانی نمی‌بینند.\u003cbr/\u003e\u003cbr/\u003eدر این مورد آنها را با همین نیسان آبی وادار به کندن خندق آن‌هم با ارتفاع نامناسب کرده‌اند تا پهپادهای پیشرفته آمریکا را شکار کنند! طی ۱۳ روز حملات آمریکا شمار زیادی از نیروهای «مردم پایه» حکومت کشته شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D8%A7%D9%86%D9%81%D8%AF%D8%A7\"\u003e#جانفدا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%BE%D8%B1_%D8%A7%D9%86%D8%B3%D8%A7%D9%86%DB%8C\"\u003e#سپر_انسانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
