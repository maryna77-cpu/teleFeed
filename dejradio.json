    {
      "id": 7641,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e ویدیویی به‌دست دژ رسیده‌ مربوط به خیزش دی‌ماه ۱۴۰۴ که در آن به وضوح نشان داده می‌شود نیروهای بسیجی با سلاح جنگی به سمت معترضان بی‌دفاع شلیک می‌کنند.\u003cbr/\u003e\u003cbr/\u003eاین ویدیو از گوشی تلفن یک بسیجی به‌دست آمده که اسم و مشخصات او موجود است و به‌زودی در کارزار شناسایی سرکوبگران معرفی می‌شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B4%D9%87%D8%AF\"\u003e#مشهد\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorist\"\u003e#IRGCterrorist\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B3%DB%8C%D8%AC%DB%8C\"\u003e#بسیجی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
