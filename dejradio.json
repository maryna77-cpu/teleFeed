    {
      "id": 7531,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e سید وحید موسوی، عضو سپـ.ـاه تهران، از فرماندهان گردان‌های امنیتی است و نقش فعال در تیراندازی به سمت مردم داشت. \u003cbr/\u003e\u003cbr/\u003eدر شبکه‌های اجتماعی گفته شده که فرمانده گردان «۳۰۱ حسن ابن علی» است که دقیق نیست. \u003cbr/\u003e\u003cbr/\u003eبا پیگری‌های انجام شده، شماره تلفن منزل و محل کار او به‌دست آمد. او ساکن خیابان ری، امامزاده یحیی است و محل کارش خیابان پاکستان کوچه ۱۴. \u003cbr/\u003eپلاک هر دو محل موجود است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%88%D8%AD%DB%8C%D8%AF_%D9%85%D9%88%D8%B3%D9%88%DB%8C\"\u003e#وحید_موسوی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
