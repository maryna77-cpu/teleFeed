    {
      "id": 7769,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e نارضایتی در بین پرسنل نیروهای مسلح جمهوری اسلامی به شدت افزایش پیدا کرده است و پرسنل که آه در بساط ندارند، علنی با در ویدیوهای کوتاه ابراز نارضایتی می‌کنند. \u003cbr/\u003e\u003cbr/\u003eیک پرسنل جوان کادر انتظامی با اعتراض به گرانی‌ها می‌گوید حقوق ۲۶ میلیون تومان کفاف زندگی من را نمی‌دهد، وای به حال مردم! وقتی هم اعتراض کنیم انگ می‌چسبانند و می‌گویند «تروریست». \u003cbr/\u003e\u003cbr/\u003eاو تأکید می‌کند وقتی با لباس یونیفرم در خیابان تردد می‌کند، مردم با نفرت به نظامی‌ها نگاه می‌کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6%D8%A7%D8%AA_%D8%B3%D8%B1%D8%A7%D8%B3%D8%B1%DB%8C\"\u003e#اعتراضات_سراسری\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
