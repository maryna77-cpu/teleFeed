    {
      "id": 7365,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e کارزار شناسایی سرکوبگران؛\u003cbr/\u003eحمید قریشی از مسئولان ایست‌های بازرسی ساری\u003cbr/\u003e\u003cbr/\u003eحمید قریشی از نیروهای رده بالای سـ.ـپاه پاسداران در ساری است. او از کسانی است که در قیام دی‌ماه ۱۴۰۴ به ماموران مسلح فرمان شلیک می‌داد. \u003cbr/\u003eشمار زیادی از شهروندان به دستور او به قتل رسیده یا آسیب دیده‌اند.\u003cbr/\u003e\u003cbr/\u003eاو در حال حاضر از مسئولان ساماندهی ایست‌های بازرسی در ساری و حومه است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%DB%8C%D8%AF_%D9%82%D8%B1%DB%8C%D8%B4%DB%8C\"\u003e#حمید_قریشی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DB%8C%DB%B1%DB%B4%DB%B0%DB%B4\"\u003e#دی۱۴۰۴\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%A7%D8%B1%DB%8C\"\u003e#ساری\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
