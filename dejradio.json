    {
      "id": 6241,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e حکومت \u0026#34;شخصیت\u0026#34; را از افسران گرفت\u003cbr/\u003e\u003cbr/\u003eویدیویی از حاشیه مراسم خامنه‌ای منتشر شد که در آن یک افسر پلیس، سینی آب بر سرگرفته بین طرفداران نظام وسط خیابان روی زمین نشسته تا از آنها پذیرایی کند. یکی از مخاطبان نوشت مشخص نیست او به دنبال دریافت رتبه و درجه است یا مرید و دلباخته خامنه‌ای و نظام، اما هرچه باشد تصویری از یک واقعیت است: حکومت ایدئولوژیک، شخصیت را از افسران گرفته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
