    {
      "id": 6375,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eادعای منتسب به مجتبی خامنه‌ای: انتقام خون علی خامنه‌ای حتما گرفته می‌شود \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدر پیامی منتسب به مجتبی خامنه‌ای که یک روز پس از دفن بقایای جسد پدر او انجام شد، تهدید شده که انتقام خون علی خامنه‌ای و دیگر کشته‌شدگان «حتما» گرفته می‌شود.\u003cbr/\u003eدر این پیام، ادعای انتقام از کشته شدن خامنه‌ای، به «ملت ایران» نسبت داده شده و تأکید شده که حتما باید محقق شود.\u003cbr/\u003eدر روزهای اخیر اخباری در مورد طرح تازۀ جمهوری اسلامی برای ترور دونالد ترامپ منتشر شده است.\u003cbr/\u003eدر بیانیۀ منتسب به مجتبی خامنه‌ای همچنین ادعا شد که عاملان حملات به مواضع و مقامات جمهوری اسلامی، موفق نمی‌شوند با مرگی آرام و در بستر، از دنیا بروند.\u003cbr/\u003eدر پیام منتسب به سومین رهبر جمهوری اسلامی تهدید شده که «آزادگان جهان» مأموریت انتقام‌گیری از حذف خامنه‌ای را دنبال می‌کنند.\u003cbr/\u003eتهدیدات منتسب به مجتبی خامنه‌ای در حالی منتشر شده که بیش از چهار ماه پس از حذف رهبر پیشین جمهوری اسلامی، او به عنوان رهبر تازه هنوز در مجامع عمومی ظاهر نشده و صدا یا تصویری نیز منتشر نکرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D9%87%D8%A8%D8%B1_%D9%85%D9%82%D9%88%D8%A7%DB%8C%DB%8C\"\u003e#رهبر_مقوایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%86%D8%AA%D9%82%D8%A7%D9%85\"\u003e#انتقام\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
