    {
      "id": 7268,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e در شرایطی که مردم ایران در بدترین شرایط با پیامدهای وخیم جنگ روبه‌رو هستند، مقامات نظام از جمله محمدباقر قالیباف اعتراف می‌کند که منافع لبنان را در اولویت اول توافق با آمریکا قرار داده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%82%D8%A7%D9%84%DB%8C%D8%A8%D8%A7%D9%81\"\u003e#قالیباف\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
