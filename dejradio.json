    {
      "id": 6966,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e بر اساس تصاویر ماهواره‌ای یک ناو هواپیمابر کلاس نیمیتز نیروی دریایی آمریکا که به احتمال زیاد یواس‌اس لینکلن (USS Lincoln) یا یواس‌اس جورج اچ. دبلیو. بوش (USS Bush) بوده است، هشتم امرداد ۱۴۰۵ در فاصله حدود ۳۴۰ کیلومتری جنوب بندر چابهار مشاهده شده است.\u003cbr/\u003e\u003cbr/\u003eعلی خامنه‌ای رهبر جمهوری اسلامی اندکی پیش از آنکه کشته شود ۲۸ بهمن ۱۴۰۵ در یک سخنرانی عنوان کرد: «رئیس‌جمهور آمریکا... هی می‌گوید: ما ناو فرستادیم طرف ایران! خیلی خب، ناو البته یک دستگاه خطرناکی است اما خطرناک‌تر از ناو آن سلاحی است که می‌تواند این ناو را به قعر دریا فرو ببرد»!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%DA%86%D8%A7%D8%A8%D9%87%D8%A7%D8%B1\"\u003e#چابهار\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
