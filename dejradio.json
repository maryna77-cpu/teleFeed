    {
      "id": 6825,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e گروهی از ایرانیان میهن‌دوست در شهر گوتنبرگ سوئد روز شنبه سوم مرداد ۱۴۰۵ در حمایت از خیزش ملی و شاهزاده رضا پهلوی تجمع برگزار کردند و یاد جانباختگان راه آزادی را گرامی داشتند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D9%85%D8%A8%D8%B3%D8%AA%DA%AF%DB%8C\"\u003e#همبستگی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%88%D8%A6%D8%AF\"\u003e#سوئد\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
