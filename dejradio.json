    {
      "id": 7083,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e تکاوران ارتش جمهوری اسلامی تمرین مقابله با عملیات زمینی آمریکا برگزار کردند. آدینه ۱۶ امرداد ۱۴۰۵ تصاویر این تمرین در برخی رسانه‌های داخلی منتشر شد. در این رزمایش استفاده از الگوهای قدیمی رزمی برای مقابله پیشرفته‌ترین ادوات کاملا مشهود بود.\u003cbr/\u003e\u003cbr/\u003eدر حاشیه این مانور تمرین ورود به ساختمان نیز انجام شد تا تکاوران آماده سناریو مقابله با دشمنی که موفق به ورود به بافت شهری شده است باشند.\u003cbr/\u003e\u003cbr/\u003eبخشی از تمرین مربوط به تیراندازی با تیربار PKM بود که ۶۵ سال پیش ساخته شده است.\u003cbr/\u003eاینکه تا چه اندازه با ابزار و امکانات اولیه و مانورهای مبتدیانه بشود مقابل حجم آتش سنگین A-10 ایستاد پیدا نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%B2%D9%85%DB%8C%D9%86%DB%8C\"\u003e#حمله_زمینی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D8%B2%D9%85%D8%A7%DB%8C%D8%B4\"\u003e#رزمایش\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
