    {
      "id": 6786,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e یورش نیروهای امنیتی و لباس‌شخصی به تجمع اعتراضی جوانان بیکار روستای خضیرات در استان خوزستان\u003cbr/\u003e\u003cbr/\u003eهمایش اعتراضی جوانان جویای کار روستای خضیرات در مسیر جاده اهواز-آبادان با برخورد خشونت‌آمیز نیروهای انتظامی و لباس‌شخصی روبه‌رو شد. \u003cbr/\u003e\u003cbr/\u003eنیروهای امنیتی با حمله به تجمع‌کنندگان، آنان را مورد ضرب‌وشتم قرار داده و شماری از معترضان را بازداشت کردند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%DB%8C%DA%A9%D8%A7%D8%B1%DB%8C\"\u003e#بیکاری\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B1%DA%A9%D9%88%D8%A8\"\u003e#سرکوب\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%B6%DB%8C%D8%B1%D8%A7%D8%AA\"\u003e#خضیرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
