    {
      "id": 7648,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5785322240497160767\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87BAF09F87B8.png\u0026#39;)\"\u003e\u003cb\u003e🇺🇸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eسنتکام: ۸۶کشتی در اجرای محاصرۀ دریایی جمهوری اسلامی تغییر مسیر داده‌اند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eفرماندهی مرکزی آمریکا،سنتکام،اعلام کرد نیروی دریایی ایالات متحده اجرای سخت‌گیرانۀ محاصرۀ دریایی جمهوری اسلامی را ادامه می‌دهد.\u003cbr/\u003eبر اساس این بیانیه،تا دوم سپتامبر نیروهای آمریکایی برای تضمین رعایت محاصره،۸۶کشتی تجاری را وادار به تغییر مسیر کرده،سه شناور را از کار انداخته و وارد دو شناور شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
