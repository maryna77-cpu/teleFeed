    {
      "id": 6297,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e جمهوری اسلامی گور خود را عمیق‌تر می‌کند\u003cbr/\u003e\u003cbr/\u003eروز گذشته، هم‌زمان با برگزاری اجلاس ناتو در ترکیه و مراسم تشییع جنازه خامنه‌ای در عراق، سپاه پاسداران به دو کشتی متعلق به قطر و عربستان در تنگه هرمز حمله کرد؛ یکی حامل نفت خام و دیگری حامل گاز مایع بود. \u003cbr/\u003e\u003cbr/\u003eهمین موضوع سبب شد آمریکا واکنش سختی نشان دهد و اهداف متعلق به جمهوری اسلامی در خاک ایران را مورد هدف قرار دهد؛ زیرا حمله سپاه به کشتی‌های نفتکش و حاملان میعانات گازی می‌تواند به‌شدت بازار جهانی انرژی را تحت تأثیر قرار دهد.\u003cbr/\u003e\u003cbr/\u003eیکی از دلایل ترامپ برای پذیرش آتش‌بس موقت با رژیم، کاهش تنش در بازارهای نفتی بود، اما حالا با حمله سپاه به این کشتی‌ها، دیگر این دلیل توجیهی ندارد. به نظر می‌رسد، همان‌طور که انتظار می‌رفت، این رژیم تروریستی و جنگ‌طلب در حال کندن گور خود است و کشورهایی که تاکنون برای کمک به سرنگونی آن تردید داشتند و نه‌تنها آمریکا و اسرائیل را همراهی نکردند، بلکه آن‌ها را نیز شماتت می‌کردند، اکنون در حال گمان‌اند که چگونه خود را از شر این رژیم باج‌گیر خلاص کنند که ثبات و امنیت جهانی را به‌هم می‌زند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%AA%D8%B4%D8%A8%D8%B3\"\u003e#آتشبس\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
