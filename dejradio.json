    {
      "id": 6367,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e دژ فوتبالی؛\u003cbr/\u003eبه یاد فرید رمضانی جان‌فدای انقلاب ملی\u003cbr/\u003e\u003cbr/\u003eمهدی رستم‌پور در برنامه دژ فوتبالی یاد فرید رمضانی را گرامی داشت؛ هموطن فوتبال‌دوست که جانش را برای نجات مردم گذاشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%DA%98%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84%DB%8C\"\u003e#دژفوتبالی\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%B1%DB%8C%D8%AF_%D8%B1%D9%85%D8%B6%D8%A7%D9%86%DB%8C\"\u003e#فرید_رمضانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%B1%DB%8C%D8%A7%D8%B4%D9%87%D8%B1\"\u003e#آریاشهر\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%B1%D8%B2%D9%86%D8%AF_%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#فرزند_ایران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
