    {
      "id": 6872,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e تخم مرغ به ۶۰۰ هزار تومان رسید، مردم دیگه چی بخورند؟!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%AE%D9%85_%D9%85%D8%B1%D8%BA\"\u003e#تخم_مرغ\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
