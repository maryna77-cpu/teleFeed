    {
      "id": 7744,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اختصاصی؛\u003cbr/\u003eشبکه مافیایی شمخانی همچنان تحریم‌های آمریکا را دور می‌زند\u003cbr/\u003e\u003cbr/\u003eشرکت «بلم لجستیک» فعال در زمینه حمل و نقل جاده‌ای به‌ویژه در زمینه حمل کالاهای اساسی از جمله گندم و غلات و مواد شیمیایی می باشد که توسط میلاد کشاورز، یکی از نزدیک‌ترین اشخاص به علی شمخانی اداره می‌شود.\u003cbr/\u003e\u003cbr/\u003eشرکت هواپیمایی پارسیانا پرواز وطن (ایر پارسیانا) متعلق به پسران شمخانی و مدیرعامل فعلی آن مهدی فتحی مدیر سابق شرکت «آتا» است. \u003cbr/\u003e\u003cbr/\u003eبیشتر نفرات حاضر در هیات مدیره این شرکت، اشخاصی به جز خانواده و نزدیکان شمخانی می‌باشند.\u003cbr/\u003e\u003cbr/\u003eشرکت «آوان ترخیص» متعلق به برادر مهدی آل‌غفور می‌باشد که نام او نیز در فهرست تحریم های وزرات خزانه داری آمریکا اعلام شده بود. \u003cbr/\u003e\u003cbr/\u003eدر حالی‌که مهدی و‌ رضا آل‌غفور در فهرست تحریم‌های وزارت خزانه‌داری آمریکا قرار دارند، این شرکت حتی از جنوب ایران کالاهای ممنوعه به داخل قاچاق می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B9%D9%84%DB%8C_%D8%B4%D9%85%D8%AE%D8%A7%D9%86%DB%8C\"\u003e#علی_شمخانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%A7%D9%81%DB%8C%D8%A7\"\u003e#مافیا\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
