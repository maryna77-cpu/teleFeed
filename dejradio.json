    {
      "id": 7875,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e شاهزاده رضا پهلوی جایزۀ آزادی آلمان را به نمایندگی از مردم ایران دریافت می‌کند\u003cbr/\u003e\u003cbr/\u003eایمان صفتی، خبرنگار دژ اعلام کرد که بنیاد فریدریش نائومان برای آزادی اعلام کرد جایزۀ آزادی سال ۲۰۲۶ این بنیاد به مردم ایران تعلق می‌گیرد؛ مردمی که با وجود سرکوب حکومت جمهوری اسلامی، شجاعانه برای آزادی، حقوق بشر و دموکراسی مبارزه می‌کنند.\u003cbr/\u003eبر اساس این خبر، شاهزاده رضا پهلوی روز ۷ نوامبر در کلیسای تاریخی «پائولس‌کیرشه» فرانکفورت، این جایزه را به نمایندگی از مردم ایران دریافت خواهد کرد.\u003cbr/\u003eبیژن جیرسرایی، سخنگوی سیاست خارجی حزب دموکرات آزاد آلمان و از کارشناسان باسابقۀ سیاست خارجی، سخنرانی مراسم اهدای جایزه را بر عهده خواهد داشت.\u003cbr/\u003eبرگزارکنندگان، اهدای این جایزه به مردم ایران و حضور شاهزاده رضا پهلوی را پیامی روشن از همبستگی سیاسی با جنبش آزادی‌خواهی ایرانیان توصیف کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
