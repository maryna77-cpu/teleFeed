    {
      "id": 5618,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  نتانیاهو: تا زمانی که نخست‌وزیر باشم، جمهوری اسلامی نمی‌تواند به سلاح هسته‌ای برسد\u003cbr/\u003e\u003cbr/\u003eبنیامین نتانیاهو، نخست‌وزیر اسرائیل روز آدینه ۲۲ خرداد اعلام کرد تا زمانی که در رأس دولت اسرائیل باشد، جمهوری اسلامی نمی‌تواند به سلاح هسته‌ای دست یابد.\u003cbr/\u003eنخست‌وزیر اسرائیل با انتشار پیامی نوشت میان او و دونالد ترامپ، دربارۀ جلوگیری از هسته‌ای شدن جمهوری اسلامی توافق کامل برقرار است.\u003cbr/\u003eبنیامین نتانیاهو یادآور شد که طی۳۰ سال فعالیت سیاسی خود، در مقابله با برنامۀ هسته‌ای جمهوری اسلامی پیشگام بوده است.\u003cbr/\u003eنتانیاهو همچنین گفت جمهوری اسلامی همچنان به دنبال نابودی اسرائیل است.\u003cbr/\u003eاین نخستین اظهار نظر رسمی نخست‌وزیر اسرائیل در پی خبر احتمال توافق نهائی میان واشینگتن و تهران به‌شمار می‌رود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%86%DB%8C%D8%A7%D9%85%DB%8C%D9%86_%D9%86%D8%AA%D8%A7%D9%86%DB%8C%D8%A7%D9%87%D9%88\"\u003e#بنیامین_نتانیاهو\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
