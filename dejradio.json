    {
      "id": 5390,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e سه ماه پس از جنگ ۴۰ روزه حکومت به اسم «بهبود شرایط معیشتی کارکنان نظامی» و با هدف تقویت توان خرید آنها به حساب پرسنل نظامی ۸۵۰ هزار تومان پول واریز کرده است. در این طرح به ازای هر عضو خانواده آنها نیز ۸۵۰ هزار تومان معادل هفت دلار واریز شده است.\u003cbr/\u003e\u003cbr/\u003eاین پول نقدی نیست و پرسنل فقط با آن می‌توانند از فروشگاه‌های طرف قرارداد خرید کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B4%DB%B0%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۴۰روزه\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
