    {
      "id": 6120,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e رژیم از دانشجوها می‌ترسد، دانشگاه‌ها را بست\u003cbr/\u003e\u003cbr/\u003eیک دانشجو با ارسال ویدیویی به دژ نوشت: \u0026#34;براتون یه فیلم می‌فرستم درباره تصمیم بستن دانشگاه‌ها در روزهای مراسم تشییع جنازه. رژیم از ما دانشجوها می‌ترسه، و حق هم داره که بترسه. خامنه‌ای قاتل دوستان و هم وطنان ماست. انتقام خون عزیزانمون رو ازش میگیریم و این رژیم رو به درک می‌فرستیم.\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6_%D8%AF%D8%A7%D9%86%D8%B4%D8%AC%D9%88%DB%8C%D8%A7%D9%86\"\u003e#اعتراض_دانشجویان\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
