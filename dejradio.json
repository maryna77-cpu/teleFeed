    {
      "id": 6247,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5807938374341760679\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94A5.png\u0026#39;)\"\u003e\u003cb\u003e🔥\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eسپاه پاسداران دو موشک به سوی کشتی‌های تجاری در تنگۀ هرمز شلیک کرد \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eرسانۀ اکسیوس به نقل از دو مقام آمریکایی گزارش داد سپاه پاسداران روز دوشنبه دستکم دو موشک را به سوی کشتی‌های تجاری در حال عبور از آبراه هرمز شلیک کرده است.\u003cbr/\u003eبه گزارش اکسیوس، هر دو کشتی در پی حملۀ سپاه آسیب جدی دیدند، اما تلفات انسانی رخ نداده است.\u003cbr/\u003eرسانۀ آمریکایی گزارش داد حملۀ اخیر پس از پایان مهلت توافق یک‌هفته‌ای تهران و واشینگتن برای توقف درگیری‌ها در تنگه هرمز رخ داده است.\u003cbr/\u003eبه نوشتۀ اکسیوس، در پی حملات سپاه، تفاهم جمهوری اسلامی و آمریکا در آستانۀ فروپاشی قرار گرفته است.\u003cbr/\u003eبر پایۀ این گزارش ممکن است آمریکا در پاسخ اهدافی را در خاک ایران هدف قرار دهد.\u003cbr/\u003e وال‌استریت ژورنال گزارش داد  احتمالا یکی از شناورهای هدف حمله، کشتی الرقایات، متعلق به قطر است.\u003cbr/\u003e خبرگزاری صداوسیمای جمهوری اسلامی تأیید کرد نفتکش الرقایات متعلق به قطر، در پی تلاش برای عبور با همراهی نیروی دریایی آمریکا از مسیر مورد پشتیبانی عمان، هدف حمله قرار گرفته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%BE%D8%A7%D9%87_%D8%AA%D8%B1%D9%88%D8%B1%DB%8C%D8%B3%D8%AA%DB%8C_%D9%BE%D8%A7%D8%B3%D8%AF%D8%A7%D8%B1%D8%A7%D9%86\"\u003e#سپاه_تروریستی_پاسداران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
