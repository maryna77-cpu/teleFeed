    {
      "id": 7425,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e نیمکت؛\u003cbr/\u003eدانشگاه و خیزش ملی؛ جنگ روایت‌ها\u003cbr/\u003e\u003cbr/\u003eگفت‌وگو با آزاد عندلیبی، نویسنده و سردبیر مجله بارو\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87\"\u003e#دانشگاه\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6%D8%A7%D8%AA_%D8%AF%D8%A7%D9%86%D8%B4%D8%AC%D9%88%DB%8C%D8%A7%D9%86\"\u003e#اعتراضات_دانشجویان\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%D8%A8%D8%B4_%D8%AF%D8%A7%D9%86%D8%B4%D8%AC%D9%88%DB%8C%DB%8C\"\u003e#جنبش_دانشجویی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
