    {
      "id": 5177,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e ترامپ گفت برای توافق با تهران هیچ عجله‌ای در کار نیست\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ، رئیس جمهوری آمریکا گفت با این که «یک توافق خیلی خوب» با جمهوری اسلامی نزدیک است، اما برای بازگشت به عملیات نظامی نیز آمادگی دارد.\u003cbr/\u003eاو گفت اگر عجله داشته باشید، توافق مناسبی به دست نمی‌آورید.\u003cbr/\u003eترامپ یک بار دیگر گفت اگر آمریکا تأسیسات هسته‌ای جمهوری اسلامی را هدف نمی‌گرفت، تهران به سلاح هسته‌ای دست پیدا می‌کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
