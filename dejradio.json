    {
      "id": 7787,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003e رهگیری ۱۸ موشک جمهوری اسلامی در آسمان اردن\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمقام‌های اردن اعلام کردند جمهوری اسلامی سه‌شنبه‌شب ۲۰ موشک به سوی این کشور شلیک کرده است که ۱۸ فروند آنها رهگیری و منهدم شدند.\u003cbr/\u003eبه گفتۀ مقام‌های اردنی، دو موشک دیگر نیز در مناطق دور از مراکز جمعیتی سقوط کردند. تاکنون گزارشی از تلفات یا خسارت‌های احتمالی این حملات منتشر نشده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%DA%A9_%D9%BE%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#موشک_پرانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AF%D9%86\"\u003e#اردن\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
