    {
      "id": 7678,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e حکومت برای تقویت تجمعات شبانه همه توان خود را به کار گرفته است. \u003cbr/\u003e\u003cbr/\u003eحالا برای کشاندن سیاهی لشکر به تجمعات علاوه بر صیغه‌های ساعتی، جهاد بلاگرهایی به کارزار حکومت پیوسته‌اند که ماموریت آنها تبلیغات اروتیک است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%AC%D9%85%D8%B9%D8%A7%D8%AA_%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#تجمعات_حکومتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D9%88%D8%AA%DB%8C%D8%B3%D9%85\"\u003e#اروتیسم\u003c/a\u003e \u003ca href=\"?q=%23%D8%B5%DB%8C%D8%BA%D9%87\"\u003e#صیغه\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
