    {
      "id": 6902,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e بحران معیشت؛ زخمی پنهان در خانواده‌های نظامی\u003cbr/\u003e\u003cbr/\u003eفشار اقتصادی فقط سفره‌ها را کوچک نمی‌کند؛ گاهی به بحرانی روانی درون خانواده تبدیل می‌شود.\u003cbr/\u003e\u003cbr/\u003eخانواده‌های وابسته به نیروهای نظامی نیز از این فشارها در امان نمانده‌اند. نگرانی مالی، احساس ناتوانی و تنش‌های مداوم می‌تواند به خشم، سرزنش و در مواردی خشونت خانگی منجر شود؛ خشونتی که اغلب زنان خانواده قربانی آن می‌شوند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%B4%D9%88%D9%86%D8%AA_%D8%AE%D8%A7%D9%86%DA%AF%DB%8C\"\u003e#خشونت_خانگی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
