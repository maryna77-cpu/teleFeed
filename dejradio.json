    {
      "id": 7675,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e وضعیت بد معیشتی نظامی‌ها آن‌هم در شرایط جنگی باعث افزایش نارضایتی میان آنها شده است. \u003cbr/\u003e\u003cbr/\u003eیکی از پرسنل با ارسال تصویری از فروشگاه اتکا نوشت: \u0026#34;کار به جایی رسیده باید نخود و لوبیا را قسطی بخریم.\u0026#34;\u003cbr/\u003e\u003cbr/\u003eگرچه نارضایتی در میان نیروهای مسلح رو به افزایش است، بسیاری از مردم می‌گویند اگر این نیروها لیاقت داشتند، زیر پرچم یک حکومت جنایتکار و فاسد پا نمی‌کوبیدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
