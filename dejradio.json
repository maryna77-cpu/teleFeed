    {
      "id": 7597,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5785322240497160767\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87BAF09F87B8.png\u0026#39;)\"\u003e\u003cb\u003e🇺🇸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eسنتکام:سپاه با خبر جعلی برخورد نفتکش به مین، کشتیرانی تجاری را می‌ترساند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://x.com/CENTCOM/status/2094411076729262413?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eفرماندهی مرکزی ارتش آمریکا، سنتکام،\u003c/a\u003e ادعای سپاه پاسداران مبنی بر برخورد یک ابرنفتکش با دو مین در مسیر جنوبی تنگه هرمز و توقف کامل آن را رد کرد و «نادرست» خواند.\u003cbr/\u003eسنتکام تأکید کرد هیچ کشتی‌ای در تنگه هرمز با مین برخورد نکرده است و این ادعا را تلاش دیگری از سوی سپاه برای ترساندن کشتیرانی تجاری منطقه از طریق انتشار اطلاعات نادرست دانست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D8%B4%D8%AA%DB%8C%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#کشتیرانی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
