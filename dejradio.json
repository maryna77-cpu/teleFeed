    {
      "id": 6579,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5949629152163271756\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اختصاصی؛\u003cbr/\u003eدستور تخلیه به تمام واحدهای پتروشیمی عسلویه\u003cbr/\u003e\u003cbr/\u003eمنابع میدانی گزارش دادند روز شنبه ۲۷ تیرماه ۱۴۰۵ ساعت ۱۰:۳۰، به تمام واحدهای پتروشیمی‌های عسلویه دستور تخلیه ناگهانی دادند.\u003cbr/\u003eدر واکنش به موشک‌پرانی‌های سـ.ـپاه و ارتش به کشورهای همسایه و انسداد تنگه هرمز، گفته می‌شود آمریکا قصد دارد زیرساخت‌های کلیدی را هدف قرار دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%AA%D8%B1%D9%88%D8%B4%DB%8C%D9%85%DB%8C_%D8%B9%D8%B3%D9%84%D9%88%DB%8C%D9%87\"\u003e#پتروشیمی_عسلویه\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
