    {
      "id": 7026,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e ناتوانی سپاه در بستن تنگه هرمز بر اساس آمار تازه \u0026#34;تانکرترکز\u0026#34;\u003cbr/\u003e\u003cbr/\u003eبر اساس آمار موسسه ردیابی کشتی‌ها تل روز ۱۱ امرداد ۱۴۰۵ [طی ۲۱ روز] که که سپاه پاسداران مدعی انسداد کامل تنگه هرمز شده، روزانه به‌طور میانگین هفت و نیم میلیون بشکه نفت غیرایرانی از تنگه هرمز صادر شده است. \u003cbr/\u003e\u003cbr/\u003eدر ۲۴ ساعت گذشته نیز ۱۳ میلیون بشکه ظرفیت نفتکش وارد خلیج فارس شده است. این محموله‌ها بیشتر از مسیر عمانی و با اسکورت آمریکایی‌ها عبور کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D9%84%DB%8C%D8%AC_%D9%81%D8%A7%D8%B1%D8%B3\"\u003e#خلیج_فارس\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
