    {
      "id": 7319,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e ایران به خاورمیانه نشان خواهد داد دموکراسی چیست؛\u003cbr/\u003e\u003cbr/\u003eگفت‌وگو با آرین کاراپت نماینده پارلمان سوئد\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D9%85%D9%88%DA%A9%D8%B1%D8%A7%D8%B3%DB%8C\"\u003e#دموکراسی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%A7%D8%B1%D9%84%D9%85%D8%A7%D9%86_%D8%B3%D9%88%D8%A6%D8%AF\"\u003e#پارلمان_سوئد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
