    {
      "id": 6398,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://x.com/PahlaviReza/status/2076233576127848663?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eشاهزاده رضا پهلوی در پی درگذشت سناتور لیندسی گراهام\u003c/b\u003e\u003c/a\u003e\u003cb\u003e: ایرانیان حمایت‌های او از انقلاب شیروخورشید را هرگز فراموش نخواهند کرد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eشاهزاده رضا پهلوی در پی درگذشت سناتور جمهوری‌خواه آمریکا، لیندسی گراهام، با انتشار پیامی از او به عنوان «دوست ثابت‌قدم مردم ایران و مدافع سربلند آزادی» یاد کرد و گفت ایرانیان حمایت‌های او از انقلاب شیروخورشید را هرگز فراموش نخواهند کرد.\u003cbr/\u003eشاهزاده رضا پهلوی در این پیام نوشت در روزهایی که مردم ایران به شفافیت و قاطعیت اخلاقی نیاز داشتند، سناتور گراهام در سمت درست تاریخ ایستاد و زمانی که شمار حامیان مردم ایران اندک بود، در مبارزه با استبداد در کنار آنان قرار گرفت.\u003cbr/\u003eاو همچنین تأکید کرد سناتور گراهام از جایگاه و نفوذ خود برای رساندن صدای مبارزان راه آزادی و عدالت به مراکز قدرت استفاده کرد و به همین دلیل یاد او همواره با سپاس و احترامی عمیق در میان ایرانیان زنده خواهد ماند.\u003cbr/\u003eشاهزاده رضا پهلوی در پایان، ضمن ابراز همدردی با خانواده، دوستان و همکاران سناتور گراهام و همچنین مردم ایالت کارولینای جنوبی و سراسر ایالات متحده، برای او آرزوی آرامش کرد و ابراز امیدواری نمود دیگران نیز راه او را در مبارزه برای آزادی ادامه دهند.\u003cbr/\u003eدفتر سناتور جمهوری‌خواه ایالت کارولینای جنوبی پیش‌تر اعلام کرده بود که \u003cb\u003eلیندسی گراهام شامگاه شنبه ۱۱ ژوئیه، پس از یک بیماری کوتاه و ناگهانی، درگذشته است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D9%84%DB%8C%D9%86%D8%AF%D8%B3%DB%8C_%DA%AF%D8%B1%D8%A7%D9%87%D8%A7%D9%85\"\u003e#لیندسی_گراهام\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
