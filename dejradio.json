    {
      "id": 6286,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e بر اساس اطلاعات منابع داخلی، یکی از سرکوبگران بـ.ـسیج که در جریان خیزش ملی ۱۸ و ۱۹ دی‌ماه ۱۴۰۵ به سمت مردم شیراز تیراندازی کرد شناسایی شد. \u003cbr/\u003e\u003cbr/\u003eمجتبی صادقی کراده که ساکن شیراز در جریان سرکوب‌ها با اسلحه کلاشنیکف به مردم شلیک کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B3%DB%8C%D8%AC\"\u003e#بسیج\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
