    {
      "id": 6023,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8F86.png\u0026#39;)\"\u003e\u003cb\u003e🏆\u003c/b\u003e\u003c/i\u003e تیم ملی فوتبال جمهوری اسلامی با تساوی در سه مسابقه برابر نیوزلند، بلژیک و مصر با سه امتیاز منتظر نتایج سه مسابقه دیگر بود تا شانس صعود به مرحله دوم را داشته باشد اما نتایج به نحوی رقم خورد که شاگردان امیر قلعه‌نوعی را مغموم کرد.\u003cbr/\u003e\u003cbr/\u003eاولین شانس پیروزی غنا برابر کرواسی بود که انتظار می‌رفت تیم آفریقایی بتواند با پیروزی برابر کرواسی شرایط صعود تیم جمهوری اسلامی را فراهم کند که پیروزی کروات‌ها این شانس را از بین برد.\u003cbr/\u003eدومین شانس به تیم ازبکستان بود که باید برابر کنگو به پیروزی می‌رسید، اما این تیم هم باخت و سومین شانس برای صعود به مرحله دوم جام جهانی برد یکی از دو تیم اتریش و الجزایر مقابل یکدیگر بود که آنها مساوی شدند.\u003cbr/\u003e\u003cbr/\u003eحذف تیم جمهوری اسلامی از این رقابت‌ها واکنش‌های زیادی را در پی داشت، بویژه آنکه تعداد زیادی از بازیکنان تیم قبل سفر به جام جهانی در تجمعات شبانه سرکوبگران برای حکومت خوش‌رقصی کرده بودند. یکی از کاربران در شبکه‌های اجتماعی گفت، «یوزهای ولایت دست از پا درازتر به ایران باز می‌گردند.»\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
