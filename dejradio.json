    {
      "id": 6246,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eشاهزاده رضا پهلوی در پارلمان هلند: پشتیبانی از مردم ایران، سرمایه‌گذاری بر امنیت در اروپا است \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eشاهزاده رضا پهلوی روز دوشنبه ۱۵ تیرماه در جریان سخنرانی در کمیسیون امور خارجۀ مجلس نمایندگان هلند، خواستار بازنگری در سیاست کشورهای غربی در قبال جمهوری اسلامی شد.\u003cbr/\u003eاو گفت جمهوری اسلامی دیگر تنها یک چالش خاورمیانه‌ای نیست، بلکه به تهدیدی اروپایی و جهانی تبدیل شده است.\u003cbr/\u003eشاهزاده از دولت و پارلمان هلند خواست نقشی پررنگ‌تر را در تدوین راهبرد اروپا علیه حکومت جمهوری اسلامی ایفا کنند.\u003cbr/\u003eشاهزاده تأکید کرد پشتیبانی از مردم ایران، به‌سان سرمایه‌گذاری بر امنیت هلند و ثبات اروپا عمل می‌کند.\u003cbr/\u003eبه گفتۀ شاهزاده، حمایت از مردم ایران به شکل‌گیری خاورمیانه‌ای منجر می‌شود که به‌جای گسترش تروریسم، بی‌ثباتی و بحران پناهجویان، صادرکنندۀ تجارت و همکاری اقتصادی باشد.\u003cbr/\u003eشاهزاده رضا پهلوی همچنین سه محور اصلی را برای سیاست کشورهای غربی پیشنهاد کرد.\u003cbr/\u003eاو از غرب خواست پشتیبانی حداکثری از مردم ایران، به‌ویژه در زمینۀ دسترسی آزاد به اینترنت را در دستور کار قرار دهد.\u003cbr/\u003eشاهزاده رضا پهلوی، رهبر دوران گذار، از سویی خواستار افزایش فشار بر رژیم از طریق تحریم‌ها، انزوای دیپلماتیک، اجرای کامل طرح قرار گرفتن سپاه پاسداران در فهرست سازمان‌های تروریستی و اقدام نظامی هدفمند در این راستا شد.\u003cbr/\u003eشاهزاده رضا پهلوی در نشست پارلمان هلند همچنین از مقامات اجرایی و سیاسی کشورهای غربی خواست برای دوران گذار و بازسازی ایران در حوزه‌های سیاسی، حقوقی و اقتصادی آمادگی لازم را داشته باشند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D9%87%D9%84%D9%86%D8%AF\"\u003e#هلند\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
