    {
      "id": 5514,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس گزارش منابع میدانی، بامداد چهارشنبه ۲۰ خرداد ۱۴۰۵ انفجارهایی مهیب بندرعباس، قشم و سیریک را لزراند. \u003cbr/\u003e\u003cbr/\u003eبه نظر می‌رسد انفجارها ناشی از حملات آمریکا به تلافی سرنگونی هلیکوپتر آمریکایی توسط سـ.ـپاه در تنگه هرمز باشد. پدافند در نواحی جنوب ایران فعال شده است.\u003cbr/\u003e\u003cbr/\u003e*عکس آرشیوی\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
