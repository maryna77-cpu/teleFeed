    {
      "id": 7304,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e در تهران دوشنبه شب ۲۶ امرداد ۱۴۰۵ یک دستگاه خودرو روی پل نواب دچار انفجار شد. \u003cbr/\u003e\u003cbr/\u003eعلت این انفجار و اینکه آیا عناصر حکومتی داخل آن بودند یا نه مشخص نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#تهران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
