    {
      "id": 6252,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e دور تازۀ مذاکرات اسرائیل و لبنان هفتۀ آینده در رم برگزار می‌شود \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eگیدئون سعار، وزیر امور خارجۀ اسرائیل اعلام کرد دور تازۀ مذاکرات اسرائیل و لبنان هفتۀ آینده در رم، پایتخت ایتالیا، برپا می‌شود.\u003cbr/\u003eاو با اشاره به توافق دو هفتۀ پیش این دو کشور با میانجیگری آمریکا تأکید کرد اسرائیل در مورد لبنان هیچ ادعای سرزمینی، ندارد.\u003cbr/\u003eآنتونیو تایانی، وزیر امور خارجۀ ایتالیا تأیید کرد این مذاکرات روزهای ۲۴ و ۲۵ تیر در سطح سفیران برگزار می‌شود.\u003cbr/\u003eلبنان و اسرائیل دو هفته پیش توافق‌نامه‌ای را با هدف پایان دادن به جنگ و دستیابی به صلح پایدار امضا کردند.\u003cbr/\u003e توافق تاریخی لبنان و اسرائیل، با مخالفت حزب‌الله و جمهوری اسلامی روبه‌رو شده است.\u003cbr/\u003eشبه‌نظامیان حزب‌الله که توسط جمهوری اسلامی پشتیبانی می‌شوند، در سیاهۀ تروریستی آمریکا و اتحادیۀ اروپا قرار دارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
