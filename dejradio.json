    {
      "id": 5601,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e رسانهٔ عربیه‌: در توافق اولیهٔ تهران و واشینگتن آتش‌بس ۶۰ روزه و بازگشایی تنگهٔ هرمز پیش‌بینی ‌شد\u003cbr/\u003e\u003cbr/\u003eرسانهٔ عربیه به نقل از منابع آگاه گزارش داد در توافق در حال مذاکره میان واشینگتن و جمهوری اسلامی، تمدید ۶۰ روزهٔ آتش‌بس و بازگشایی تنگهٔ هرمز برای کشتیرانی تجاری در نظر گرفته شده است.\u003cbr/\u003eبر اساس این گزارش، آمریکا در مقابل بخشی از تحریم‌ها را کاهش می‌دهد و محاصرهٔ دریایی علیه جمهوری اسلامی را متوقف می‌کند.\u003cbr/\u003eبه گفتهٔ منابع العربیه همچنین قرار است مقامات تهران و واشینگتن در درازای این دوره درمورد سرنوشت ذخایر اورانیوم غنی‌شدهٔ جمهوری اسلامی مذاکره کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
