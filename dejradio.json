    {
      "id": 5624,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e عراقچی گفت هنوز توافقی امضا نشده و مذاکره با آمریکا ادامه دارد\u003cbr/\u003e\u003cbr/\u003eعباس عراقچی، وزیر امور خارجۀ دولت جمهوری اسلامی اعلام کرد هنوز هیچ توافقنامه‌ای با آمریکا امضا نشده و مذاکرات همچنان ادامه دارد.\u003cbr/\u003eاو مدعی شد نتیجۀ گفت‌وگوها فعلا در قالب یک یادداشت ۱۴ ماده‌ای تنظیم شده و موضوع برنامۀ هسته‌ای جمهوری اسلامی به مرحله دوم و نهایی مذاکرات منتقل شده است.\u003cbr/\u003eعراقچی ادعا کرد مفاد نهایی تفاهمنامه هنوز قطعی نیست و برخی بندها ممکن است تغییر کند.\u003cbr/\u003e او همچنین مدعی شد در توافق احتمالی، پایان جنگ در همۀ جبهه‌ها از جمله لبنان نیز پیش‌بینی شده است.\u003cbr/\u003eوزیر خارجۀ جمهوری اسلامی گفت گزارش‌های منتشرشده درمورد متن توافق از سوی رسانه‌ها، مورد تأیید تهران نیست.\u003cbr/\u003eدونالد ترامپ روز آدینه مسئولان جمهوری اسلامی را به دروغ‌بافی و چرندگویی در مورد بندهای مورد توافق میان تهران و واشنیگتن متهم کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A7%D9%82%DA%86%DB%8C\"\u003e#عراقچی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
