    {
      "id": 5485,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e رسوایی تعرض به دختر ۱۴ ساله توسط بازیکن تیم جمهوری اسلامی؛ \u003cbr/\u003eاز حواشی تیمی که حکومت پشت آن است اما‌ مردم نه!\u003cbr/\u003e\u003cbr/\u003eگزارش: مهدی رستم‌پور \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%DB%8C%D9%85_%D9%85%D9%84%DB%8C\"\u003e#تیم_ملی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AC%D8%A7%D9%88%D8%B2\"\u003e#تجاوز\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
