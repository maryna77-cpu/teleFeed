    {
      "id": 5487,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e روزنامه «نیویورک‌تایمز» به نقل از دو منبع آگاه گزارش داد یک فروند هلیکوپتر آپاچی ارتش آمریکا دوشنبه ۱۸ خرداد ۱۴۰۵ در نزدیکی تنگه هرمز سقوط کرد. دو خدمه آن به‌طور ایمن نجات یافتند.\u003cbr/\u003e\u003cbr/\u003eیکی از این افراد به نیویورک‌تایمز گفت این حادثه در دست بررسی است و هنوز مشخص نیست که آیا این آپاچی با شلیک نیروهای جمهوری اسلامی سرنگون شده، دچار نقص فنی شده یا با مشکل دیگری مواجه شده است.\u003cbr/\u003e\u003cbr/\u003eترامپ تایید کرد خلبانان هلیکوپتر سالم هستند و گفت آمریکا روز سه‌شنبه گزارشی درباره این حادثه منتشر خواهد کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
