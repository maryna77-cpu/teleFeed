    {
      "id": 7188,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e شماری از کوهنوردان میهن‌دوست با فتح قله «علم‌کوه» در استان مازندران، شهرستان کلاردشت، یاد جاویدنامان انقلاب شیر و خورشید را گرامی‌داشتند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%A7%D8%B2%D9%86%D8%AF%D8%B1%D8%A7%D9%86\"\u003e#مازندران\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%86%D9%82%D9%84%D8%A7%D8%A8_%D8%B4%DB%8C%D8%B1%D9%88%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF\"\u003e#انقلاب_شیروخورشید\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
