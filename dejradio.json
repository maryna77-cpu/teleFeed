    {
      "id": 7644,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e جانفدای حکومت پول ندارد دندانش درست کند\u003cbr/\u003e\u003cbr/\u003eیکی از مخاطبان دژ با ارسال ویدیویی از تجمع حامیان حکومت تحت عنوان \u0026#34;جانفدا\u0026#34; نوشت این مزدوران غرق در گماشتگی شده‌اند، یک دندان سالم در دهانشان نیست. کفن هم برای مردن ندارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorist\"\u003e#IRGCterrorist\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AC%D9%85%D8%B9_%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#تجمع_حکومتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
