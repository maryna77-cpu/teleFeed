    {
      "id": 6183,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e بهراد بهزادفر:\u003cbr/\u003eدل مردم ایران با فوتبالیست‌ها نبود\u003cbr/\u003e\u003cbr/\u003eبهراد بهزادفر بازیکن حرفه‌ای فوتسال استرالیا در گفت‌وگو با مهدی‌ رستم‌پور در دژ فوتبالی، می‌گوید \u0026#34;دل مردم ایران با تیم جمهوری اسلامی نبود. هیچکدام‌ از بازیکنان کلمه‌ای درباره کشتار دی نگفتند اما در تجمعات حکومتی شرکت کردند و حتی می‌خواستند گل‌شان را تقدیم رهبرشان کنند.\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84%DB%8C\"\u003e#دژفوتبالی\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
