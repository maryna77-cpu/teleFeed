    {
      "id": 8054,
      "message": "\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eترامپ در سازمان ملل؛ توافق یا نابودی جمهوری اسلامی\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ در سخنرانی ۲۲ سپتامبر خود در مجمع عمومی سازمان ملل، از یک «تصمیم بزرگ» سخن گفت: توافقی که راه بازسازی ایران را باز کند، یا نابودی سریع جمهوری اسلامی برای جلوگیری از ادامه کشتار و ویرانگری.\u003cbr/\u003eرئیس‌جمهوری آمریکا با اشاره به کشتار هفتاد و دو هزار تن از مردم ایران و حمایت جمهوری اسلامی از تروریسم، تأکید کرد اجازه نخواهد داد این حکومت به سلاح هسته‌ای دست یابد.\u003cbr/\u003eاو همچنین خواستار همراهی کشورها برای انزوای کامل اقتصادی جمهوری اسلامی شد و احتمال دستیابی به توافق پس از انتخابات میان‌دوره‌ای آمریکا را مطرح کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#ایران\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%A7%D8%B2%D9%85%D8%A7%D9%86_%D9%85%D9%84%D9%84\"\u003e#سازمان_ملل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
