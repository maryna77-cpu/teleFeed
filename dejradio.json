    {
      "id": 6327,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e از بامداد پنجشنبه ۱۸ تیرماه ۱۴۰۵ جنگنده‌ها و پهپادهای آمریکا بیش از ۱۰۰ نقطه نظامی و راهبردی در جنوب ایران، از عسلویه، شیراز و کرمان گرفته تا بوشهر، قشم، لاوان، هنگام، بوموسی، جاسک، کنارک، چابهار و ایرانشهر را هدف قرار دادند. در یکی از حملات حتی خط آهن استراتژیک آق‌قلا نزدیک گرگان بمباران شد.\u003cbr/\u003e\u003cbr/\u003eهمزمان با این عملیات گسترده و طولانی آمریکا در نیمه جنوبی ایران، جنازه علی خامنه‌ای را با یک فروند «ماهان ایر» از نجف به مشهد منتقل کردند. در طول مسیر جنگنده‌های‌ میگ-۲۹ نهاجا این هواپیما را اسکورت می‌کردند. در جریان برگزاری مراسم تشییع جنازه خامنه‌ای در مشهد نیز اف-۵های ارتش برفراز مشهد پرواز می‌کردند تا امنیت مراسم تأمین شود.\u003cbr/\u003e\u003cbr/\u003eدر شرایطی که پایگاه‌های نظامی در نیمه جنوبی ایران زیر آتش هواگردهای آمریکایی بود و زور توپ‌های پدافند به مقابله با آنها نمی‌رسید، هیچ کدام از جنگنده‌های نیروی هوایی جرات درگیر شدن با جنگنده‌های آمریکایی را نداشتند.\u003cbr/\u003e\u003cbr/\u003eاما مسئله اساسی‌تر آنکه اگر این جنگنده‌ها برای درگیر شدن هم اقدام می‌کردند در مقابل هواپیماهای پیشرفته پنهانکار، کاری از پیش نمی‌بردند. این در حالی است که فرماندهان نظامی جمهوری اسلامی مدعی‌اند نیروهای مسلح از آمادگی صد در صدی برخوردارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B4%DB%8C%D8%B9_%D8%AC%D9%86%D8%A7%D8%B2%D9%87\"\u003e#تشیع_جنازه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
