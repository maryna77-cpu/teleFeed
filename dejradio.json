    {
      "id": 7755,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e بر اساس گزارش‌های دریافتی، با هدف اجرای دستور حسین طائب فرمانده بـ.ـسیج مبنی بر تقویت «گشت رضویون» در محلات، حوزه‌های بـ.ـسیج اقدام به عضوگیری از کمپ‌های ترک اعتیاد کرده‌اند. \u003cbr/\u003e\u003cbr/\u003eدر ساوه، اراک و قم نیروهایی که از نظر جسمی توان راه رفتن و ایستادن داشتند، انتخاب و در مساجد آموزش اولیه دیدند و پس از برگزاری چند جلسه کلاس توجیهی شب‌ها در خیابان به گشت‌زنی می‌پردازند.\u003cbr/\u003e\u003cbr/\u003eشماری از آنها که هوش و حواس مناسبت‌تری دارند در ایست‌های بازرسی مستقر می‌شوند تا برای جبران کمبود نیرو کنار بـ.ـسیجی‌ها بایستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%DA%A9_%D8%A7%D8%B9%D8%AA%DB%8C%D8%A7%D8%AF\"\u003e#ترک_اعتیاد\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B3%D8%AA_%D8%A8%D8%A7%D8%B2%D8%B1%D8%B3%DB%8C\"\u003e#ایست_بازرسی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
