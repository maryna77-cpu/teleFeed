    {
      "id": 6986,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e استقرار توپ‌های ضد هوایی در مناطق جنوبی برای مقابله با هلی‌برن نیرو \u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌های میدانی، نیروهای مسلح جمهوری اسلامی در چند ناحیه که پیش‌بینی شده امکان هلی‌برن (پیاده کردن) نیرو در خاک ایران وجود داشته باشد اقدام به استقرار توپ‌های قدیمی ضدهوایی کرده‌اند تا هدف‌هایی از جمله هلی‌کوپتر یا هواپیماهای ترابری‌های در ارتفاعات پایین را هدف قرار دهند.\u003cbr/\u003e\u003cbr/\u003eاستان‌های بوشهر، هرمزگان، یزد و کرمان و اطراف تهران ده‌ها عراده توپ مستقر شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%B6%D8%AF%D9%87%D9%88%D8%A7%DB%8C%DB%8C\"\u003e#ضدهوایی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
