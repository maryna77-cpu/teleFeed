    {
      "id": 4644,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e پیام یک شهروند:\u003cbr/\u003e\u003cbr/\u003eبا این گرونی‌ها تن ماهی خریدم داخلش مگس بود!\u003cbr/\u003e\u003cbr/\u003eیک شهروند با ارسال تصاویری نوشت: \u0026#34;\u003cbr/\u003eسلام، توی این وضعیت با این قیمت‌ها،\u003cbr/\u003eتن ماهی گرفتیم دونه‌ای ۱۹۵ تومن وجه رایج مملکت،\u003cbr/\u003eداخلش مگس بوده با شرکت‌شون چندین مرتبه تماس گرفتیم هیچ‌کس حتی جواب تلفنو نمیده ما اول ریختیم داخل بشقاب بعد متوجه مگس کنسرو شده شدیم!!\u003cbr/\u003eمجدد برگردوندیم داخل قوطی و بشقابو با اسید شستیم \u003cbr/\u003eزنگ زدم به خظ مشریان شبنم حتی جواب هم ندادن\u003cbr/\u003eاز سازمان بهداشت هم که عملا نباید توقع داشت.\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%A7%D8%B2%D9%85%D8%A7%D9%86_%D8%A8%D9%87%D8%AF%D8%A7%D8%B4%D8%AA\"\u003e#سازمان_بهداشت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
