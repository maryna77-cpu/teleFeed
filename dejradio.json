    {
      "id": 5580,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e در جریان جنگ ۴۰ روزه، مقابل پلیس راه قزوین ایست بازرسی مستقر شده بود که هدف حمله هوایی قرار گرفت. \u003cbr/\u003e\u003cbr/\u003eتمام ساختمان این مرکز ویران شد و اکنون با گذشت نزدیک به چهارماه آواربرداری نشده است و نیروهای پلیس در یک کانکس مستقر می‌شوند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B4%DB%B0%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۴۰روزه\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%B2%D9%88%DB%8C%D9%86\"\u003e#قزوین\u003c/a\u003e",
