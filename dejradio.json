    {
      "id": 5463,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e یک کارشناس امنیتی:\u003cbr/\u003eاحتمال هدفگیری زیرساخت‌های بانکی جمهوری اسلامی بالاست\u003cbr/\u003e\u003cbr/\u003eیک کارشناس امنیتی به دژ می‌گوید از آنجا که جمهوری اسلامی علاوه بر تنگه هرمز در پی انسداد یا اختلال در جریان کشتیرانی آزاد در باب‌المندب است، این احتمال که در اقدام متقابل زیرساخت‌های بانکی حکومت هدف قرار بگیرد زیاد است. \u003cbr/\u003e\u003cbr/\u003eبه گفته همین کارشناس این حملات می‌تواند سایبری یا فیزیکی باشد.\u003cbr/\u003e\u003cbr/\u003eبا توجه به این شرایط سپرده‌های شهروندان اعم از سپرده پولی یا اموال دپو شده در صندوق‌های امانات بانک‌ها مورد تهدید است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%A7%D9%86%DA%A9\"\u003e#بانک\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
