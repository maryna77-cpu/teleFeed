    {
      "id": 6417,
      "message": "\u003ctg-emoji emoji-id=\"5767388969624936602\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9A80.png\u0026#39;)\"\u003e\u003cb\u003e🚀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5766903427867089820\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C88.png\u0026#39;)\"\u003e\u003cb\u003e✈️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eبمباران مجدد تاسیسات موشکی و پدافندی خنداب\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدر حملات هوایی آمریکا که بامداد دوشنبه ۲۲ تیرماه ۱۴۰۵ صورت گرفت تاسیسات موشکی و پدافند خنداب بمباران شد. ماموریت اصلی پدافند خنداب حفاظت از مجتمع آب‌سنگین اراک است.\u003cbr/\u003eاین نقاط در جریان جنگ ۴۰ روزه و ۱۲ روزه نیز هدف قرار گرفت که نشان از اهمیت آن برای آمریکا و اسراییل است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87\"\u003e#حمله\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D9%86%D8%AF%D8%A7%D8%A8\"\u003e#خنداب\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%A7%DA%A9\"\u003e#اراک\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
