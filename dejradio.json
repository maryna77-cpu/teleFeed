    {
      "id": 5375,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e آمریکا به همراهان تیم ملی ویزا نداد؛ بی اثر ماندن تهدیدات تاج \u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003eبنا بر گزارش‌ها درخواست ویزای ۱۵ عضو تیم ملی فوتبال جمهوری اسلامی ایران برای ورود به آمریکا رد شد.\u003cbr/\u003eاین در حالی است که مهدی تاج، رئیس فدراسیون فوتبال پیش‌تر مدعی شده بود شرط فرستادن تیم به جام‌جهانی، صدور ویزا برای همهٔ اعضای اکیپ اعزامی جمهوری اسلامی است. \u003cbr/\u003eبنا بر ادعای مقامات رژیم، فدراسیون فوتبال جمهوری اسلامی برای فیفا ۱۰ شرط تعیین کرده بود.\u003cbr/\u003eتلویزیون الجزیره شامگاه آدینه بدون اشاره به هویت افراد گزارش داد پانزده عضو اکیپ جمهوری اسلامی نتوانستند ویزای آمریکا را دریافت کنند.\u003cbr/\u003eهنوز مشخص نیست این افراد از اعضای کادر فنی‌اند، یا در فهرست هیئت همراه تیم ملی قرار دارند.\u003cbr/\u003eرویترز پیش‌تر به نقل از یک مقام کاخ سفید گزارش داده‌ بود ویزای آمریکا برای همهٔ «بازیکنان» تیم صادر شده است.\u003cbr/\u003eفدراسیون فوتبال جمهوری اسلامی تاکنون به گزارش رد ویزا واکنشی نشان نداده است.\u003cbr/\u003eخبرگزاری حکومتی فارس ساعاتی پیش از انتشار این خبر، گزارش داده بود ویزای شماری از  اعضای کادر فنی و هیئت همراه صادر نشده است.\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
