    {
      "id": 6362,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e بر اساس گزارش منابع میدانی، شنبه ۲۰ تیرماه در شرق تهرن منطقه نظامی پارچین یک انفجار رخ داد و ستونی از دود به آسمان بلند شد. \u003cbr/\u003e\u003cbr/\u003eعلت انفجار هنوز مشخص نیست. طی هفته‌های اخیر بارها انفجارهای مشابه در مناطق نظامی ایران رخ داد اما ادعا شد خنثی‌سازی مهمات عمل‌نکرده دوران جنگ است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D8%A7%D8%AA_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حملات_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%A7%D8%B1%DA%86%DB%8C%D9%86\"\u003e#پارچین\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
