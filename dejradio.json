    {
      "id": 6133,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eشاهزاده رضا پهلوی گفت مردم ایران رها از تصمیمات دیپلماتیک جهانی، جمهوری اسلامی را سرنگون می‌کنند \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eشاهزاده رضا پهلوی، اعلام کرد فارغ از این که دیپلمات‌ها در پایتخت‌ کشورهای دنیا چه تصمیمی بگیرند، مردم ایران رژیم جمهوری اسلامی را سرنگون می‌کنند.\u003cbr/\u003eشاهزاده رضا پهلوی، در گفت‌وگو با شبکۀ اروپایی یورونیوز اعلام کرد تنها برندۀ یادداشت تفاهم‌ میان تهران و واشینگتن، خود حکومت جمهوری اسلامی است.\u003cbr/\u003eبه گفتۀ شاهزاده، حکومت از فرصت آتش‌بس برای «تجدید قوا و تسلیح مجدد» استفاده می‌کند.\u003cbr/\u003eشاهزاده رضا پهلوی با اشاره به اعدام جواد زمانی و ابوالفضل ساعدی در روزهای امضای تفاهمنامه، گفت معامله با جمهوری اسلامی که ده‌ها هزار تن از معترضان را به قتل رساند، از نظر اخلاقی نادرست و از نظر راهبردی گمراه‌ کننده است.\u003cbr/\u003eشاهزاده رضا پهلوی با تصریح بر این که جمهوری اسلامی  رژیمی رو به احتضار است، افزود تفاهمنامۀ اخیر برای حکومت نقش «طناب نجات» را ایفا می‌کند.\u003cbr/\u003eشاهزاده تأکید کرد مردم ایران هیچ توافقی را که با فداکاری معترضان در انقلاب شیر و خورشید در تضاد باشد، نمی‌پذیرند.\u003cbr/\u003eبه گفتۀ شاهزاده، جمهوری اسلامی از فرصت ایجادشده برای بازسازی برنامۀ هسته‌ای، تقویت نیروهای نیابتی و آماده شدن برای بحران‌های بعدی، استفاده می‌کند.\u003cbr/\u003eشاهزاده افزود تا زمانی که جمهوری اسلامی بر سر کار باشد، ثبات پایدار در خاورمیانه امکان‌پذیر نیست.\u003cbr/\u003eاو همچنین گفت تنها در یک ایران آزاد و دموکراتیک می‌توان پشتیبانی از گروه‌های نیابتی، تلاش برای دستیابی به سلاح هسته‌ای و تنش با همسایگان از جمله با اسرائیل و کشورهای عربی را پایان داد.\u003cbr/\u003eشاهزاده رضا پهلوی با اشاره به این که اروپا سیاست مماشات را با مقامات تهران ادامه می‌دهد، از دولت‌های اروپایی خواست به جای تعامل با حکومت، در کنار مردم ایران بایستند.\u003cbr/\u003eاو همچنین از دولت‌های غربی خواستار اخراج سفیران رژیم از اروپا و مشروعیت‌زدایی از ساختار قدرت جمهوری اسلامی شد.\u003cbr/\u003eرهبر دوران گذار همچنین تأکید کرد که جمهوری اسلامی در ضعیف‌ترین وضعیت خود قرار دارد.\u003cbr/\u003eشاهزاده افزود آزادی ایران در دسترس است، اما در صورت بی‌عملی جامعۀ جهانی، رنج مردم ایران طولانی‌تر می‌شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D9%85%D8%B5%D8%A7%D8%AD%D8%A8%D9%87\"\u003e#مصاحبه\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
