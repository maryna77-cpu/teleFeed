    {
      "id": 7598,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e اصابت گلوله به کارگران معترض پالایشگاه لیشتر گچساران؛ در پی تیراندازی نیروی انتظامی به تجمع کارگران معترض به استخدام‌های رانتی، دوشنبه ۹ شهریور ۱۴۰۵.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%AF%DA%86%D8%B3%D8%A7%D8%B1%D8%A7%D9%86\"\u003e#گچساران\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B1%DA%A9%D9%88%D8%A8\"\u003e#سرکوب\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
