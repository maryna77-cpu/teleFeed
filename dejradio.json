    {
      "id": 7357,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A1.png\u0026#39;)\"\u003e\u003cb\u003e🤡\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e راه رو باز کنید استاندار گاز بده!\u003cbr/\u003e\u003cbr/\u003eیکی از مخاطبان با ارسال ویدیویی از بازدید استاندار استان فارس و گروهانی از کت و شلواری‌های همراه از کارخانه صنعتی‌کبیر موتور کازرون، نوشت: \u0026#34;مملکت دست پلشت‌ترین آدم‌هاست، هیات همراه فقط داد می‌زدند کنار برید استاندار گاز بده!\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%AA%D9%88%D8%B1_%DA%A9%D8%A7%D8%B2%D8%B1%D9%88%D9%86\"\u003e#موتور_کازرون\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%A7%D8%B0%D9%84_%D8%A7%D9%88%D8%A8%D8%A7%D8%B4\"\u003e#اراذل_اوباش\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%AA%D8%A7%D9%86_%D9%81%D8%A7%D8%B1%D8%B3\"\u003e#استان_فارس\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
