    {
      "id": 5350,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5949629152163271756\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e العربیه:\u003cbr/\u003e موافقت جمهوری اسلامی با انتقال بخشی از اورانیوم خود به کشور ثالث \u003cbr/\u003e\u003cbr/\u003eشبکه العربیه مدعی شد جمهوری اسلامی به پاکستان اطلاع داده است با انتقال بخشی از اورانیوم خود به یک کشور ثالث موافقت می‌کند. \u003cbr/\u003e\u003cbr/\u003eطبق گزارش آژانس ۴۵۰ کیلوگرم اورانیوم‌های ۶۰ درصدی در اختیار حکومت ایران است که به نظر می‌رسد بخش عمده آن در زیر تاسیسات اتمی بمباران شده مدفون است.\u003cbr/\u003eبر اساس این گزارش، یکی از شکاف‌های اصلی در مذاکرات، موضوع آزادسازی پول‌های مسدودشده است.\u003cbr/\u003eالعربیه نوشت آمریکا همچنان درخواست جمهوری اسلامی را برای آزاد کردن این دارایی‌ها رد می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%88%D8%B1%D8%A7%D9%86%DB%8C%D9%88%D9%85\"\u003e#اورانیوم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
