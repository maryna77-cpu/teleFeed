    {
      "id": 7383,
      "message": "\u003ctg-emoji emoji-id=\"5807938374341760679\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94A5.png\u0026#39;)\"\u003e\u003cb\u003e🔥\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A1.png\u0026#39;)\"\u003e\u003cb\u003e📡\u003c/b\u003e\u003c/i\u003e پیامدهای جنگ؛\u003cbr/\u003eانهدام تأسیسات فراساحل و ناو بندرعباس نیروی دریایی ارتش\u003cbr/\u003e\u003cbr/\u003eاگرچه حکومت وانمود می‌کند در برابر آمریکا و اسرائیل همچنان قدرت دفاعی خود را حفظ کرده است، اطلاعات میدانی نشان می‌دهد نیروهای مسلح خسارات هنگفتی متحمل شده‌اند. \u003cbr/\u003e\u003cbr/\u003eتصاویر تازه از اسکله نیروی دریایی بندرعباس گویای حجم این خسارات است؛ هرچند اطلاعات قطره‌چکانی به بیرون درز می‌کند و حفاظت اطلاعات شدیدترین سانسورها را با تهدید پرسنل در دستور کار دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%86%D8%AF%D8%B1%D8%B9%D8%A8%D8%A7%D8%B3\"\u003e#بندرعباس\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C_%D8%A7%D8%B1%D8%AA%D8%B4\"\u003e#نیروی_دریایی_ارتش\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
