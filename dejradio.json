    {
      "id": 7283,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e توزیع سیم‌کارت‌ صلواتی در جاده نیشابور \u003cbr/\u003e\u003cbr/\u003eشرکت همراه اول، در موکب‌های مستقر در جاده‌های منتهی به مشهد به مناسبت سالروز عزاداری امام هشتم شیعیان بین زائران سیم‌کارت صلواتی توزیع کرده است. \u003cbr/\u003e\u003cbr/\u003eبر اساس اطلاعات دریافتی حتی افغان‌های عضو «فاطمیون» سهمیه سیم‌کارت داشتند.\u003cbr/\u003e\u003cbr/\u003eعلاوه بر سیم‌کارت، در موکب‌ها غذای رایگان، نوشیدنی و میان وعده به صورت رایگان در اختیار زائران قرار می‌گیرد.\u003cbr/\u003e\u003cbr/\u003eخدمات به زائران برای رونق بخشیدن به مراسم‌ حکومتی و مذهبی زیاد است، پیش تر وزیر ارتباطات جمهوری اسلامی گفته بود ۱۰۰ ایستگاه اینترنت رایگان در مسیر پیاده‌روی اربعین مستقر شده!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D9%85%D8%A7%D9%85_%D9%87%D8%B4%D8%AA%D9%85\"\u003e#امام_هشتم\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%A8%D8%B9%DB%8C%D9%86_%D8%AD%D8%B3%DB%8C%D9%86%DB%8C\"\u003e#اربعین_حسینی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AC%D9%85%D8%B9%D8%A7%D8%AA_%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#تجمعات_حکومتی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
