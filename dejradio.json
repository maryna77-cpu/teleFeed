    {
      "id": 7522,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e یکی از کارکنان بخش کشتیرانی با اشاره به خلوتی بنادر ایران به دلیل محاصره، به کنایه می‌گوید، \u0026#34;فقط یک کشتی آمد آن‌هم GOZO\u0026#34;!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D8%B4%D8%AA%DB%8C%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#کشتیرانی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
