    {
      "id": 7679,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e مقام سپاه: مشاوران نیروی قدس و ده‌ها عضو حزب‌الله در تونل‌های لبنان محاصره شدند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eیک مقام سپاه پاسداران به روزنامه نیویورک‌تایمز گفت مشاورانی از نیروی قدس همراه با ۷۰ تا ۱۰۰ عضو حزب‌الله،در تونل‌های زیر ارتفاعات علی‌طاهر در جنوب لبنان گرفتار شده بودند.\u003cbr/\u003eبه گفته این مقام،حزب‌الله در این تونل‌ها تسلیحات مهمی از جمله راکت و پهپاد نگهداری می‌کرد و مرکز اصلی فرماندهی این گروه نیز زیر منطقه قرار داشت.\u003cbr/\u003eاین مقام سپاه که گفته است به‌طور مستمر با نیروهای حزب‌الله در ارتباط بوده،افزود نیروهای ارتش اسرائیل پس از ورود به ارتفاعات علی‌طاهر،تونل‌ها را محاصره کردند و راه خروج افراد حاضر در آن‌ها را بستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e #\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%A7%D9%87_%D9%82%D8%AF%D8%B3\"\u003e#سپاه_قدس\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
