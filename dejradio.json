    {
      "id": 7394,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e محسن رضایی، دبیر شورای عالی امنیت ملی مدعی شده آمریکایی‌ها هر حرکتی در مسیر جنوبی تنگه هرمز انجام دهند هدف قرار می‌گیرند. اما سی‌ان‌ان ۳۱ امرداد ۱۴۰۵ گزارش داد که جمهوری اسلامی ظاهرا در حال از دست دادن کنترل خود بر تنگه هرمز است؛ در حالیکه طی دو هفته گذشته، تردد کشتی‌ها از این آبراه حیاتی نزدیک به ۴۰۰ درصد افزایش یافته و کشتی‌ها بیش از پیش از یک کریدور مورد حمایت آمریکا برای عبور استفاده می‌کنند.\u003cbr/\u003e\u003cbr/\u003eبر اساس داده‌های مرکز عملیات تجارت دریایی بریتانیا، هفته گذشته نزدیک به ۲۰۰ کشتی از تنگه هرمز عبور کردند؛ این رقم در هفته پیش از آن ۱۵۰ فروند و دو هفته قبل تنها ۴۰ فروند بود.\u003cbr/\u003eاین افزایش، مجموع تردد در مسیر عبوری را به حدود ۲۰ درصد سطح پیش از جنگ رسانده است؛ در دوران صلح، حدود ۲۰ درصد نفت حمل‌شده از مسیر دریا در جهان از این مسیر عبور می‌کرد.\u003cbr/\u003e\u003cbr/\u003eدن پیکرینگ، بنیان‌گذار شرکت Pickering Energy Partners، می‌گوید، «مسیر عمان قطعا منطقی‌ترین گزینه است»، زیرا به کشتی‌ها اجازه می‌دهد از احتمال پرداخت عوارض به تهران اجتناب کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
