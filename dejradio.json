    {
      "id": 6227,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e روزنامه \u0026#34;اورشلیم پست\u0026#34; به نقل از \u0026#34;والا نیوز\u0026#34; گزارش داد ارتش اسرائیل همچنان برای احتمال ازسرگیری درگیری با جمهوری اسلامی آماده می‌شود و فرماندهان این نیرو به‌طور منظم طرح‌های دفاعی و تهاجمی را بازبینی و به‌روزرسانی می‌کنند.\u003cbr/\u003eبه نوشته این روزنامه، مقام‌های امنیتی اسرائیل معتقدند جمهوری اسلامی و سپاه پاسداران، با وجود خسارت‌های واردشده در جنگ، روند بازسازی توان خود را آغاز کرده‌اند.\u003cbr/\u003eاورشلیم پست همچنین به نقل از یک مقام ارشد نهادهای امنیتی اسرائیل نوشت برآورد این نهادها آن است که مجتبی خامنه‌ای پس از کشته شدن پدرش، انگیزه بسیار بالایی برای انتقام دارد.\u003cbr/\u003eاین مقام مدعی شد این انگیزه، علاوه بر کشته شدن علی خامنه‌ای،از آنچه «تحقیر جمهوری اسلامی به دست ارتش اسرائیل» توصیف کرد نیز ناشی می‌شود. به گفته این مقام،احمد وحیدی نیز در تقویت این رویکرد نقش دارد.\u003cbr/\u003eبه نوشته اورشلیم پست،مقام‌های امنیتی اسرائیل همچنین هشدار داده‌اند در صورت حمله حزب‌الله به اسرائیل،ارتش این کشور اهدافی را در ضاحیه بیروت هدف قرار خواهد داد؛ اقدامی که می‌تواند تهران را بار دیگر در برابر تصمیم واکنش نظامی یا خودداری از آن قرار دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%AD%D9%85%D8%AF_%D9%88%D8%AD%DB%8C%D8%AF%DB%8C\"\u003e#احمد_وحیدی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
