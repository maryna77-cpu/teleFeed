    {
      "id": 7077,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e دور هفتم مذاکرات صلح اسرائیل و لبنان در پایتخت ایتالیا\u003cbr/\u003e\u003cbr/\u003eگزارش: هرو نامداری\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e",
