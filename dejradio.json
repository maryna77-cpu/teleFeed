    {
      "id": 7076,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://x.com/PahlaviComms/status/2085097934358450518?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eشاهزاده رضا پهلوی \u003c/a\u003eدر دیدار با گروه «پزشکان میهن‌دوست ایران»، پای سخنان متخصصانی نشست که سال‌ها در داخل و خارج از کشور تجربه اندوخته‌اند و برای یاری‌رساندن به ملت ایران و جامعه پزشکی، امروز و در دوران گذار، و همچنین بازسازی نظام سلامت کشور اعلام آمادگی کرده‌اند.\u003cbr/\u003eدر این نشست، درباره تقویت شبکه‌های پزشکی، حمایت از کادر درمان، رسیدگی به مجروحان و آسیب‌دیدگان، مستندسازی جنایت‌های جمهوری اسلامی، ارائه خدمات درمانی در دوران گذار و برنامه‌ریزی برای ایجاد نظام سلامتی کارآمد در ایران آزاد گفت‌وگو شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86_%D8%B1%D8%A7_%D9%BE%D8%B3_%D9%85%DB%8C%DA%AF%DB%8C%D8%B1%DB%8C%D9%85\"\u003e#ایران_را_پس_میگیریم\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
