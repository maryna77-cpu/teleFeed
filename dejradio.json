    {
      "id": 7790,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e شماری از پرسنل مرزبانی در پیامی به دژ با ارسال تصویری از غذای خود در مناطق عملیاتی خطاب به احمدرضا رادان فرمانده انتظامی جمهوری اسلامی گفتند \u0026#34;ننگ بر تو رادان\u0026#34; چطور باید ۲۴ ساعت با این غذا سر کنیم؟ پست فطرت‌تر از تو در تمام نیروهای مسلح وجود ندارد. \u003cbr/\u003e\u003cbr/\u003eما با چندرغاز حقوق چطور شکم خودمان و زن و بچه را سیر کنیم؟ زندگی خود شما چطور است؟\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%AD%D9%85%D8%AF%D8%B1%D8%B6%D8%A7_%D8%B1%D8%A7%D8%AF%D8%A7%D9%86\"\u003e#احمدرضا_رادان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
