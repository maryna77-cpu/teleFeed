    {
      "id": 7208,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e «حسین آقایاری» کیست؟ \u003cbr/\u003eخروج میلیاردها دلار پول نفت توسط دلال افغان‌تبار\u003cbr/\u003e\u003cbr/\u003e*گزارش: عطا حسینیان، روزنامه‌نگار اقتصادی\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D9%81%D8%BA%D8%A7%D9%86%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#افغانستان\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B3%DB%8C%D9%86_%D8%A2%D9%82%D8%A7%DB%8C%D8%A7%D8%B1%DB%8C\"\u003e#حسین_آقایاری\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D9%88%D9%84_%D9%86%D9%81%D8%AA\"\u003e#پول_نفت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
