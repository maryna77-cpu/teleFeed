    {
      "id": 6509,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e فراخوان بازاریان پاساژ علاءالدین به اعتصاب\u003cbr/\u003e\u003cbr/\u003eشماری از کسبه بازار تهران روز چهارشنبه ۲۴ تیر با تجمع در پاساژ علاءالدین به شرایط اقتصادی و سیاست‌های حکومت اعتراض کردند. \u003cbr/\u003e\u003cbr/\u003eویدئوهای منتشرشده در شبکه‌های اجتماعی، تجمع و اعتصاب بازاریان در بخش‌هایی از بازار تهران و پاساژ علاءالدین را نشان می‌دهد. معترضان همچنین از دیگر هم‌صنفان خود خواستند به اعتصاب بپیوندند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D8%A7%D8%AE%D9%88%D8%A7%D9%86\"\u003e#فراخوان\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%A7%D8%B3%D8%A7%DA%98_%D8%B9%D9%84%D8%A7%D8%A1%D8%A7%D9%84%D8%AF%DB%8C%D9%86\"\u003e#پاساژ_علاءالدین\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%A7%D8%B2%D8%A7%D8%B1_%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#بازار_تهران\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6%D8%A7%D8%AA_%D8%B3%D8%B1%D8%A7%D8%B3%D8%B1%DB%8C\"\u003e#اعتراضات_سراسری\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
