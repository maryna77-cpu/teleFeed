    {
      "id": 7428,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e حمله حوثی‌ها به یک نفتکش در دریای سرخ\u003cbr/\u003e\u003cbr/\u003eحوثی‌های مورد حمایت جمهوری اسلامی دوشنبه دوم شهریور ۱۴۰۵ به یک کشتی در دریای سرخ در نزدیکی «ینبع» عربستان سعودی، حمله کردند؛ ینبع یک پایانه نفتی مهم و راهبردی در سواحل غربی عربستان محسوب می‌شود. \u003cbr/\u003e\u003cbr/\u003eاین حمله پس از آن انجام شد که عربستان سعودی، ترکیه و پاکستان «پیمان دفاعی مکه» را امضاء کردند. \u003cbr/\u003e\u003cbr/\u003eبراساس این پیمان «حمله به یک کشور، حمله به همه تلقی خواهد شد».\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%88%D8%AB%DB%8C\"\u003e#حوثی\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%DB%8C%D9%85%D8%A7%D9%86_%D8%AF%D9%81%D8%A7%D8%B9%DB%8C_%D9%85%DA%A9%D9%87\"\u003e#پیمان_دفاعی_مکه\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
