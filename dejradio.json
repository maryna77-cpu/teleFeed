    {
      "id": 8143,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eمقام آمریکایی: روزانه به‌طور میانگین ۱۲ میلیون بشکه نفت از تنگه هرمز عبور می‌کند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eیک مقام آمریکایی روز شنبه به روزنامه «جروزالم پست» گفت طی چند هفتۀ گذشته،به‌طور میانگین روزانه حدود ۱۲میلیون بشکه نفت از تنگۀ هرمز عبور کرده است.\u003cbr/\u003eاین مقام آمریکایی گفت افزایش جریان انتقال نفت از تنگۀ هرمز یکی از دلایلی است که به دونالد ترامپ امکان داده پیشنهاد اخیر جمهوری اسلامی را رد کند. به گفتۀ او،آمریکا در همین حال به افزایش میزان نفت خروجی از منطقه ادامه خواهد داد و محاصرۀ جمهوری اسلامی نیز ادامه می‌یابد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e \u003ca href=\"?q=%23%D8%B7%D8%B1%D8%AF_%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%DB%8C\"\u003e#طرد_اقتصادی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
