    {
      "id": 6340,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e براساس گزارش منابع میدانی، پنجشنبه شب ۱۸ تیرماه ۱۴۰۵ در حاشیه مراسم دفن علی خامنه‌ای افراد مسلح به سمت نیروهای امنیتی تیراندازی کردند که دستکم دو نفر از آنها کشته و چند نفر دیگر زخمی شدند.\u003cbr/\u003eگفته شد این نیروهای امنیتی بـ.ـسیجی‌های عضو گردان «نواب» بودند که در هر شهرستان به استعداد یک گروهان الیٰ یک گردان در سطح هر استان وجود دارد که مأموریت‌هایی همچون مقابله با اقدامات مخل امنیت را انجام میدهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%86%D8%A7%D9%84%D8%B3%D9%BE%D8%A7%D8%B1%DB%8C\"\u003e#چالسپاری\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B3%D8%AA_%D8%A8%D8%A7%D8%B2%D8%B1%D8%B3%DB%8C\"\u003e#ایست_بازرسی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
