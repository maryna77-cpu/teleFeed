    {
      "id": 86648,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e \u003cb\u003eپاکستان یک اسکادران جنگنده و ۸۰۰۰ نیرو به عربستان اعزام کرد  \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eپاکستان تحت پیمان دفاعی، یک اسکادران جنگنده، ۸۰۰۰ نیروی نظامی و سامانه دفاع هوایی به عربستان سعودی اعزام کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%98%D8%A6%D9%88%D9%BE%D9%84%DB%8C%D8%AA%DB%8C%DA%A9\"\u003e#ژئوپلیتیک\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\"\u003e@UTOFX\u003c/a\u003e",
