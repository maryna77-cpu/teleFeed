    {
      "id": 87097,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e ترامپ: پیش‌نویس جدید توافق با ایران را با مشاورانم بررسی می‌کنم\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eبه گزارش خبرنگار آکسیوس، دونالد ترامپ اعلام کرده است که پیش‌نویس تازه توافق با جمهوری اسلامی را با مشاوران خود بررسی خواهد کرد و \u003cu\u003eممکن است روز یکشنبه درباره آن تصمیم‌گیری کند.\u003c/u\u003e\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#ایران\u003c/a\u003e \u003ca href=\"?q=%23%DA%98%D8%A6%D9%88%D9%BE%D9%84%DB%8C%D8%AA%DB%8C%DA%A9\"\u003e#ژئوپلیتیک\u003c/a\u003e \u003ca href=\"?q=%23USD\"\u003e#USD\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\"\u003e@UTOFX\u003c/a\u003e",
