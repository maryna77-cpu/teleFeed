    {
      "id": 86500,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e ترامپ اعلام کرد که شی جین‌پینگ با خرید ۲۰۰ فروند هواپیمای بوئینگ موافقت کرده است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e شی جین‌پینگ گفته است که مایل است به خرید نفت از ایران ادامه دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e شی جین‌پینگ با «دریافت عوارض از ایران در تنگه هرمز» موافق نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e بوئینگ در ابتدا قصد فروش ۱۵۰ فروند هواپیما را داشت، اما در نهایت سفارش ۲۰۰ فروند «مدل بزرگ» ثبت شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23USD\"\u003e#USD\u003c/a\u003e \u003ca href=\"?q=%23CNY\"\u003e#CNY\u003c/a\u003e \u003ca href=\"?q=%23BA\"\u003e#BA\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%87%D8%A7%D9%85\"\u003e#سهام\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#ایران\u003c/a\u003e \u003ca href=\"?q=%23OIL\"\u003e#OIL\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\"\u003e@UTOFX\u003c/a\u003e",
