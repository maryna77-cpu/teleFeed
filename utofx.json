    {
      "id": 94687,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e خروج طلا از آمریکا؛ چرا کشورهای بیشتری ذخایر خود را جابه‌جا می‌کنند؟\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003e\u003cb\u003eدر یک نگاه\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e \u003cb\u003eهلند\u003c/b\u003e ۸۶ تن از ذخایر طلای خود را از \u003cb\u003eنیویورک\u003c/b\u003e و \u003cb\u003eکانادا\u003c/b\u003e به لندن منتقل می‌کند؛ دلیل این اقدام، افزایش ریسک‌های ژئوپلیتیکی عنوان شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e \u003cb\u003eفرانسه\u003c/b\u003e نیز در ژانویه ۲۰۲۶، ۱۲۹ تن طلا را که در فدرال رزرو نیویورک نگهداری می‌شد، فروخت و معادل آن را در اروپا خریداری کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e \u003cb\u003eآلمان\u003c/b\u003e پیش‌تر در سال ۲۰۱۷، ۳۰۰ تن طلا را از نیویورک به فرانکفورت بازگرداند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003e در مجموع،\u003cb\u003e افزایش تنش‌های ژئوپلیتیکی و نگرانی درباره سیاست‌های اقتصادی آمریکا\u003c/b\u003e، انگیزه برخی کشورها برای انتقال یا بازگرداندن ذخایر طلا به داخل یا به مراکز امن‌تر را افزایش داده است.\u003c/blockquote\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://utotimes.com/03092026-gold-move-from-us/\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eبرای خواندن ادامه مطلب کلیک کنید\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23USD\"\u003e#USD\u003c/a\u003e  \u003ca href=\"?q=%23%D8%B7%D9%84%D8%A7\"\u003e#طلا\u003c/a\u003e  \u003ca href=\"?q=%23%D9%81%D8%AF%D8%B1%D8%A7%D9%84_%D8%B1%D8%B2%D8%B1%D9%88\"\u003e#فدرال_رزرو\u003c/a\u003e  \u003ca href=\"?q=%23EUR\"\u003e#EUR\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A8%D8%A7%D9%86%DA%A9_%D9%85%D8%B1%DA%A9%D8%B2%DB%8C_%D8%A7%D8%B1%D9%88%D9%BE%D8%A7\"\u003e#بانک_مرکزی_اروپا\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A8%D8%A7%D9%86%DA%A9_%D8%A7%D9%86%DA%AF%D9%84%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#بانک_انگلستان\u003c/a\u003e  \u003ca href=\"?q=%23%DA%A9%D8%A7%D9%85%D9%88%D8%AF%DB%8C%D8%AA%DB%8C\"\u003e#کامودیتی\u003c/a\u003e  \u003ca href=\"?q=%23%DA%98%D8%A6%D9%88%D9%BE%D9%84%DB%8C%D8%AA%DB%8C%DA%A9\"\u003e#ژئوپلیتیک\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e@UTOFX\u003c/a\u003e",
