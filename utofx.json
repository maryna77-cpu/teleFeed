      "id": 89119,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e\u003cb\u003eآنچه در بازار گذشت\u003c/b\u003e | مرور مهمترین رویداد‌ای چند ساعت گذشته\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23USD\"\u003e#USD\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%AF%D8%B1%D8%A7%D9%84_%D8%B1%D8%B2%D8%B1%D9%88\"\u003e#فدرال_رزرو\u003c/a\u003e \u003ca href=\"?q=%23GBP\"\u003e#GBP\u003c/a\u003e \u003ca href=\"?q=%23JPY\"\u003e#JPY\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#ایران\u003c/a\u003e \u003ca href=\"?q=%23%DA%98%D8%A6%D9%88%D9%BE%D9%84%DB%8C%D8%AA%DB%8C%DA%A9\"\u003e#ژئوپلیتیک\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23CNY\"\u003e#CNY\u003c/a\u003e \u003ca href=\"?q=%23CAD\"\u003e#CAD\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\"\u003e@UTOFX\u003c/a\u003e",
