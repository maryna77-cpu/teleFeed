      "id": 89122,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e \u003cb\u003eشاخص نیکی ژاپن معاملات امروز را در بالاترین سطح تاریخی خود به پایان رساند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23JPY\"\u003e#JPY\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%DA%A9%DB%8C_%DA%98%D8%A7%D9%BE%D9%86\"\u003e#نیکی_ژاپن\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\"\u003e@UTOFX\u003c/a\u003e",
