    {
      "id": 94723,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e فرستادگان آمریکا در مسیر مسکو–کی‌یف؛ سفر دو روزه ۵ و ۶ سپتامبر\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eبه‌گزارش تاس و به نقل از یک منبع مطلع، فرستادگان آمریکا، ویتکاف و کوشنر قرار است در تاریخ ۵ و ۶ سپتامبر ابتدا وارد مسکو شوند و سپس به کی‌یف سفر کنند. این سفر دوگانه در بحبوحه تلاش‌های دیپلماتیک برای مدیریت تنش‌های منطقه‌ای و بررسی مسیرهای گفت‌وگو میان طرف‌ها انجام می‌شود.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23USD\"\u003e#USD\u003c/a\u003e  \u003ca href=\"?q=%23%D9%81%D8%A7%D8%B1%DA%A9%D8%B3\"\u003e#فارکس\u003c/a\u003e  \u003ca href=\"?q=%23RUB\"\u003e#RUB\u003c/a\u003e  \u003ca href=\"?q=%23%DA%98%D8%A6%D9%88%D9%BE%D9%84%DB%8C%D8%AA%DB%8C%DA%A9\"\u003e#ژئوپلیتیک\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/UTOFX\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e@UTOFX\u003c/a\u003e",
